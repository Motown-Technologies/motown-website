---
import servicesData, { type Service } from "../data/services";
import BaseLayout from "../layouts/BaseLayout.astro";
import NumberedRow from "../components/NumberedRow.astro";
import { Image } from "astro:assets";
import { getPosts } from "../lib/posts";
import { studies } from "../data/caseStudies";

// Three posts that answer a buyer's questions, in this order. Unpublished
// slugs drop out and the newest posts fill the gap.
const FEATURED_POSTS = ["software-brief-developers-can-price", "what-to-own-when-a-contractor-builds-your-software", "ai-agent-or-automation"];
const posts = await getPosts();
const featured = FEATURED_POSTS.map((id) => posts.find((p) => p.id === id)).filter((p) => p !== undefined);
const homePosts = [...featured, ...posts.filter((p) => !featured.includes(p))].slice(0, 3);

const SELECTED_WORK = ["/case-studies/auction-operations", "/case-studies/senior-care-concierge", "/case-studies/donation-platform"];
const selectedWork = SELECTED_WORK.map((href) => studies.find((s) => s.href === href)!);

const whyChoose = [
    {
        title: "Expert Team",
        description:
            "Engineers and designers who have built web apps, mobile apps, AI systems and automation for healthcare, nonprofit and operations teams.",
    },
    {
        title: "Proven Track Record",
        description:
            "Case studies ranging from an auction house's operations system to a donation platform for nonprofits.",
    },
    {
        title: "Agile Approach",
        description:
            "We work in short iterations with regular check-ins, so you see progress and can change priorities as you go.",
    },
    {
        title: "Ongoing Support",
        description:
            "Bug fixes, updates, security patches and new features after launch.",
    },
];
---

<BaseLayout
    meta_title="Custom Software, AI & Web Development | Motown Solutions"
    meta_description="Motown Solutions builds custom software, AI systems, websites, mobile apps, and automation tools, and advises on the technology strategy behind them."
>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b-2 border-ink">
        <!-- Contour-line decoration -->
        <svg
            aria-hidden
            class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.12] text-ink"
            viewBox="0 0 1200 700"
            preserveAspectRatio="xMidYMid slice"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
        >
            <!-- The contour lines drift slowly side to side. -->
            <g class="hero-drift hero-drift--slow">
                <path d="M-50 520 Q 200 440 430 490 T 880 470 T 1260 440" />
                <path d="M-50 580 Q 200 500 430 550 T 880 530 T 1260 500" />
                <path d="M-50 640 Q 200 560 430 610 T 880 590 T 1260 560" />
                <path d="M-50 460 Q 200 380 430 430 T 880 410 T 1260 380" />
                <path d="M-50 400 Q 200 320 430 370 T 880 350 T 1260 320" />
            </g>
        </svg>

        <div class="relative max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-24 md:pb-32">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-10">

                    <h1
                        class="font-display font-bold text-display text-ink text-balance"
                    >
                        Software and AI built around how you <span class="text-accent italic">work</span>.
                    </h1>
                </div>

                <div class="col-span-12 lg:col-span-7 lg:col-start-4 mt-10 md:mt-16">
                    <p
                        class="text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        We build custom software, websites and mobile apps for
                        businesses that have outgrown spreadsheets and
                        off-the-shelf tools, and we add AI where it saves your
                        team real time.
                    </p>

                    <div class="mt-10 flex flex-wrap gap-3">
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-ink text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-paper hover:text-ink transition-colors"
                        >
                            Start Your Project
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="/case-studies"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            See Our Work
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metadata strip -->
        <div class="relative border-t border-ink/40 bg-paper">
            <div
                class="max-w-7xl mx-auto px-6 py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 font-mono text-[11px] md:text-xs uppercase tracking-eyebrow text-ink-muted"
            >
                <span>Custom Software</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>AI</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Web Design</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Mobile Apps</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Automation</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Consulting</span>
            </div>
        </div>
    </section>

    <!-- Recent projects: evidence before the service list -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-14 flex flex-wrap items-end justify-between gap-6">
                <div>
                    <h2 class="font-display font-bold text-h2 tracking-tight text-balance">Recent projects.</h2>
                    <p class="mt-5 max-w-xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty">
                        What each client was stuck on, and what changed once it was built.
                    </p>
                </div>
                <a href="/case-studies" class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-eyebrow link-underline">
                    <span aria-hidden>→</span>
                    All case studies
                </a>
            </div>
            <div data-stagger class="grid gap-12 md:gap-8 md:grid-cols-3">
                {
                    selectedWork.map((s) => (
                        <a href={s.href} class="group flex flex-col border-t-2 border-ink pt-6">
                            {s.image && (
                                <Image
                                    src={s.image}
                                    alt={s.imageAlt ?? ""}
                                    widths={[400, 800]}
                                    sizes="(min-width: 768px) 400px, 100vw"
                                    class="w-full aspect-[4/3] object-cover object-top border border-ink/30 group-hover:border-ink transition-colors mb-6"
                                />
                            )}
                            <span class="font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted mb-3">{s.sector}</span>
                            <h3 class="font-display text-2xl font-bold tracking-tight leading-tight mb-4 text-balance group-hover:text-accent transition-colors">
                                {s.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed mb-5">{s.body}</p>
                            <div class="mt-auto border-t border-ink/30 pt-4">
                                <span class="block font-mono text-[11px] uppercase tracking-eyebrow text-accent mb-1.5">What changed</span>
                                <p class="font-medium leading-snug">{s.result}</p>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Services showroom -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        What we do best.
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Every project starts with the problem, and the simplest
                        approach that solves it. Sometimes that isn't AI. Pick a
                        service to see what we build and how we work.
                    </p>
            </div>

            <div>
                {
                    servicesData.map((svc: Service) => (
                        <NumberedRow
                            title={svc.title}
                            description={svc.description}
                            href={svc.href}
                        />
                    ))
                }
            </div>

            <div class="mt-14">
                <a
                    href="/services"
                    class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-eyebrow link-underline"
                >
                    <span aria-hidden>→</span>
                    View all services
                </a>
            </div>
        </div>
    </section>

    <!-- Why Choose Us matrix -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Technical expertise,
                        <br />
                        creative conviction.
                    </h2>
                <p class="mt-5 max-w-2xl text-ink-muted text-lg leading-relaxed">
                    We care about how the work looks and how it holds up in production.
                </p>
            </div>

            <div data-stagger class="grid grid-cols-1 md:grid-cols-2 border border-ink">
                {
                    whyChoose.map((item) => (
                        <div class="p-8 md:p-10 border-ink border-b md:[&:nth-child(odd)]:border-r md:[&:nth-child(n+3)]:border-b-0 last:border-b-0">
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                {item.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed">
                                {item.description}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Featured posts: hidden until something is published -->
    {
        homePosts.length > 0 && (
            <section class="border-t-2 border-ink" data-reveal>
                <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
                    <div class="mb-12 md:mb-16">
                        <h2 class="font-display font-bold text-h2 tracking-tight text-balance">From the blog.</h2>
                    </div>
                    <div class="grid gap-10 md:gap-x-8 md:gap-y-14 md:grid-cols-3">
                        {homePosts.map((post) => (
                            <a href={`/blog/${post.id}`} class="group flex flex-col">
                                {post.data.image && (
                                    <Image
                                        src={post.data.image}
                                        alt=""
                                        widths={[400, 800]}
                                        sizes="(min-width: 768px) 400px, 100vw"
                                        class="w-full aspect-[16/10] object-cover border border-ink/30 group-hover:border-ink transition-colors mb-5"
                                    />
                                )}
                                <h3 class="font-display text-2xl font-bold tracking-tight leading-tight mb-3 text-balance group-hover:text-accent transition-colors">
                                    {post.data.title}
                                </h3>
                                <p class="text-ink-muted leading-relaxed">{post.data.description}</p>
                            </a>
                        ))}
                    </div>
                    <div class="mt-14 flex justify-center">
                        <a
                            href="/blog"
                            class="group inline-flex items-center gap-2 bg-ink text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-transparent hover:text-ink transition-colors"
                        >
                            All posts
                            <span class="transition-transform group-hover:translate-x-0.5" aria-hidden>→</span>
                        </a>
                    </div>
                </div>
            </section>
        )
    }

    <!-- Final CTA -->
    <section class="border-t-2 border-ink" data-reveal>
        <div
            class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start"
        >
            <h2
                class="font-display font-bold text-display text-ink text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Tell us how your team works.
            </h2>
            <p class="text-lg md:text-xl text-ink-muted max-w-xl mb-10">
                Send us a note about the problem you want solved. We
                usually reply within 24 hours.
            </p>
            <a
                href="/contact"
                class="group inline-flex items-center gap-3 bg-ink text-paper font-mono text-xs md:text-sm uppercase tracking-[0.15em] px-8 py-5 border-2 border-ink hover:bg-paper hover:text-ink transition-colors"
            >
                Contact Us
                <span
                    class="transition-transform group-hover:translate-x-0.5"
                    aria-hidden>→</span
                >
            </a>
        </div>
    </section>
</BaseLayout>

