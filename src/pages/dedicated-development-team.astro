---
import BaseLayout from "../layouts/BaseLayout.astro";

import ConsultingIcon from "../components/icons/ConsultingIcon.astro";
import EnterpriseIcon from "../components/icons/EnterpriseIcon.astro";
import SoftwareIcon from "../components/icons/SoftwareIcon.astro";
import AutomationIcon from "../components/icons/AutomationIcon.astro";
import AnalyticsIcon from "../components/icons/AnalyticsIcon.astro";
import CloudIcon from "../components/icons/CloudIcon.astro";

const panel = [
    { title: "Role Design", icon: ConsultingIcon },
    { title: "Named People", icon: EnterpriseIcon },
    { title: "Onboarding", icon: SoftwareIcon },
    { title: "Ways Of Working", icon: AutomationIcon },
    { title: "Reporting", icon: AnalyticsIcon },
    { title: "Scaling", icon: CloudIcon },
];

const work = [
    {
        title: "Role Design",
        icon: ConsultingIcon,
        desc: "Working out what the team actually needs to contain. Most requests for three developers turn out to need two and someone who can make decisions.",
    },
    {
        title: "Named People",
        icon: EnterpriseIcon,
        desc: "You meet them, you keep them. Nobody gets swapped out without notice because a larger account needed a body that month.",
    },
    {
        title: "Onboarding",
        icon: SoftwareIcon,
        desc: "A structured first fortnight against your codebase and domain, so the ramp-up is a known, planned cost.",
    },
    {
        title: "Your Process Or Ours",
        icon: AutomationIcon,
        desc: "Joining your standups and your board, or running our own and reporting in. Both work, as long as the choice is made on purpose.",
    },
    {
        title: "Reporting",
        icon: AnalyticsIcon,
        desc: "What shipped, what's blocked, and what changed, visible without having to ask and written for whoever is paying rather than for engineers.",
    },
    {
        title: "Scaling",
        icon: CloudIcon,
        desc: "Adding or reducing capacity with notice, and a handover written throughout so shrinking the team doesn't take knowledge with it.",
    },
];

const rows = [
    {
        before: "A different contractor every quarter",
        after: "The same named people, quarter after quarter",
    },
    {
        before: "Context re-explained at the start of every task",
        after: "A team that knows why the code looks like that",
    },
    {
        before: "Billed by the ticket, invested in neither",
        after: "Accountable for what ships",
    },
    {
        before: "Knowledge walks out when the contract ends",
        after: "Documentation and handover written throughout",
    },
];
---

<BaseLayout
    meta_title="Dedicated Development Teams | Motown Solutions"
    meta_description="Dedicated development teams with named engineers, structured onboarding, your process or ours, clear reporting, and room to scale without losing context."
>
    <section class="relative overflow-hidden border-b-2 border-ink">
        <svg
            aria-hidden
            class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.12] text-ink"
            viewBox="0 0 1200 700"
            preserveAspectRatio="xMidYMid slice"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
        >
            <path d="M-50 520 Q 200 440 430 490 T 880 470 T 1260 440" />
            <path d="M-50 580 Q 200 500 430 550 T 880 530 T 1260 500" />
            <path d="M-50 640 Q 200 560 430 610 T 880 590 T 1260 560" />
            <path d="M-50 460 Q 200 380 430 430 T 880 410 T 1260 380" />
            <path class="dedicated-development-team-line" stroke-width="2" d="M-50 400 Q 200 320 430 370 T 880 350 T 1260 320" />
        </svg>

        <div class="relative max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-7">

                    <h1
                        class="font-display font-bold text-hero text-ink text-balance"
                    >
                        A dedicated development team that works like your <span class="italic text-accent">own</span>.
                    </h1>

                    <p
                        class="mt-10 text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        Renting hands by the hour gets work done and teaches nobody anything. The value in a long engagement is the context: a team that knows why the code looks like that, and what broke last time someone changed it.
                    </p>

                    <div class="mt-10 flex flex-wrap gap-3">
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-ink transition-colors"
                        >
                            Discuss a team
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#work"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            How it works
                        </a>
                    </div>
                </div>

                <div class="col-span-12 lg:col-span-5 mt-12 lg:mt-0">
                    <div
                        class="border-2 border-ink bg-paper-2 lg:translate-y-2"
                        data-reveal
                    >
                        <div
                            class="flex items-center justify-between px-5 py-3 border-b-2 border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted"
                        >
                            <span>Your Team / Shape</span>
                            <span aria-hidden class="text-accent"><span class="status-dot">●</span> embedded</span>
                        </div>
                        {
                            panel.map((s, i) => {
                                const Icon = s.icon;
                                return (
                                    <div data-step
                                        class:list={[
                                            "flex items-center gap-4 px-5 py-4",
                                            i !== panel.length - 1 &&
                                                "border-b border-ink/30",
                                        ]}
                                    >
                                        <span class="font-mono text-[11px] text-ink-muted w-6 shrink-0">
                                            0{i + 1}
                                        </span>
                                        <span class="w-9 h-9 shrink-0 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                            <Icon class="w-5 h-5" />
                                        </span>
                                        <span class="font-display font-bold text-lg leading-none">
                                            {s.title}
                                        </span>
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="relative border-t border-ink/40 bg-paper">
            <div
                class="max-w-7xl mx-auto px-6 py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 font-mono text-[11px] md:text-xs uppercase tracking-eyebrow text-ink-muted"
            >
                <span>Roles</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Onboarding</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Process</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Reporting</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Scaling</span>
            </div>
        </div>
    </section>

    <section id="work" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        The same people,
                        <br />
                        quarter after quarter.
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Continuity is what you're paying for. Everything below exists to protect it, because a team that turns over every few months costs more than one that doesn't, whatever the day rate says.
                    </p>
            </div>

            <div data-stagger
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    work.map((item) => {
                        const Icon = item.icon;
                        return (
                            <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                                <div class="flex items-center gap-4 mb-6">
                                    <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                        <Icon />
                                    </span>
                                </div>
                                <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                    {item.title}
                                </h3>
                                <p class="text-ink-muted leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <section class="border-t-2 border-ink bg-paper-2 py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Bodies,
                        <br />
                        or a team.
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Staff augmentation and a dedicated team get sold as the same thing at similar rates. They produce very different outcomes over a year.
                    </p>
            </div>

            <div class="border-t border-ink">
                <div
                    class="hidden md:grid grid-cols-12 gap-8 py-4 border-b border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted"
                >
                    <span class="col-span-6">Body shop</span>
                    <span class="col-span-6">Dedicated team</span>
                </div>
                {
                    rows.map((row) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-center py-7 border-b border-ink">
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3 text-ink-muted">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px]"
                                >
                                    ×
                                </span>
                                <span class="leading-relaxed line-through decoration-ink/30">
                                    {row.before}
                                </span>
                            </div>
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px] text-accent"
                                >
                                    →
                                </span>
                                <span class="font-medium leading-relaxed">
                                    {row.after}
                                </span>
                            </div>
                        </div>
                    ))
                }
            </div>

            <p class="mt-8 text-ink-muted leading-relaxed max-w-2xl">
                If what's missing is direction rather than capacity, the honest answer is usually <a href="/fractional-cto" class="link-underline font-medium text-ink"
                    >a fractional CTO</a
                > instead.
            </p>

        </div>
    </section>

    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start">
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Effectively <span class="italic text-accent">yours</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Tell us what you're trying to ship and what's in the team today. We'll propose a shape, name the people, and be direct if you need fewer of them than you asked for.
            </p>
            <div class="flex flex-wrap gap-3 mb-12">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-paper transition-colors"
                >
                    Discuss a team
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/services/software-development"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    Software Development
                </a>
            </div>

            <div
                class="w-full border-t border-paper/20 pt-8 flex flex-wrap items-center gap-x-10 gap-y-3 font-mono text-xs uppercase tracking-eyebrow text-paper/60"
            >
                <a
                    href="https://motowntech.com"
                    class="link-underline text-paper"
                    >motowntech.com</a
                >
                <a href="tel:+18459252661" class="link-underline text-paper"
                    >845-925-2661</a
                >
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* The top wave slides onto the one below it and holds there: two lines
       becoming one. 0.6s moves, long holds. Translation is in the SVG's units
       (the two waves are the same curve, 60 apart). */
    @keyframes dedicated-development-team-wave {
        0%, 20% { transform: translate(0, 0); }
        27.5%, 70% { transform: translate(0, 60px); }
        77.5%, 100% { transform: translate(0, 0); }
    }

    .dedicated-development-team-line {
        animation: dedicated-development-team-wave 8s var(--ease-in-out) infinite;
    }

    @media (prefers-reduced-motion: reduce) {
        .dedicated-development-team-line {
            animation: none;
        }
    }
</style>
