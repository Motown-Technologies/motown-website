---
import BaseLayout from "../layouts/BaseLayout.astro";

import ConsultingIcon from "../components/icons/ConsultingIcon.astro";
import AnalyticsIcon from "../components/icons/AnalyticsIcon.astro";
import SoftwareIcon from "../components/icons/SoftwareIcon.astro";
import ShieldIcon from "../components/icons/ShieldIcon.astro";
import DatabaseIcon from "../components/icons/DatabaseIcon.astro";
import SendIcon from "../components/icons/SendIcon.astro";

const panel = [
    { title: "Scoping", icon: ConsultingIcon },
    { title: "Gap Assessment", icon: AnalyticsIcon },
    { title: "Policies", icon: SoftwareIcon },
    { title: "Technical Controls", icon: ShieldIcon },
    { title: "Evidence", icon: DatabaseIcon },
    { title: "Auditor Handoff", icon: SendIcon },
];

const work = [
    {
        title: "Scoping",
        icon: ConsultingIcon,
        desc: "Which trust services criteria apply, Type I or Type II, and which systems are genuinely in scope, all decided early because scope creep here is expensive.",
    },
    {
        title: "Gap Assessment",
        icon: AnalyticsIcon,
        desc: "An honest read of where you are against the criteria, ranked by how long each gap takes to close rather than by how bad it sounds.",
    },
    {
        title: "Policy Set",
        icon: SoftwareIcon,
        desc: "The policies you actually need, written to match how your team really works, because an auditor tests whether the policy is followed, not whether it exists.",
    },
    {
        title: "Technical Controls",
        icon: ShieldIcon,
        desc: "Access management, logging, encryption, change control, and vulnerability handling implemented in the systems rather than described in a document.",
    },
    {
        title: "Evidence Automation",
        icon: DatabaseIcon,
        desc: "Evidence collected continuously from the systems themselves, so the observation window doesn't become a quarterly screenshot exercise for someone.",
    },
    {
        title: "Auditor Handoff",
        icon: SendIcon,
        desc: "Working alongside the audit firm you choose, answering their requests so your engineers aren't pulled into it for weeks.",
    },
];

const rows = [
    {
        before: "Controls written the week the auditor is booked",
        after: "Policies in force long enough to produce evidence",
    },
    {
        before: "Screenshots gathered by hand every quarter",
        after: "Evidence collected automatically from the systems",
    },
    {
        before: "Access reviews nobody has ever actually performed",
        after: "Quarterly reviews that run and get recorded",
    },
    {
        before: "A security questionnaire answered three different ways",
        after: "One security narrative everyone answers from",
    },
];
---

<BaseLayout
    meta_title="SOC 2 Readiness & Compliance Preparation | Motown Solutions"
    meta_description="SOC 2 readiness: scoping, gap assessment, policies, technical controls, automated evidence collection, and auditor handoff. We prepare you for the audit."
>
    <section class="relative overflow-hidden border-b-2 border-ink">
        <svg
            aria-hidden
            class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.12] text-ink"
            viewBox="0 0 1200 700"
            preserveAspectRatio="xMidYMid slice"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
        >
            <path d="M-50 520 Q 200 440 430 490 T 880 470 T 1260 440" />
            <path d="M-50 580 Q 200 500 430 550 T 880 530 T 1260 500" />
            <path d="M-50 640 Q 200 560 430 610 T 880 590 T 1260 560" />
            <path d="M-50 460 Q 200 380 430 430 T 880 410 T 1260 380" />
            <path d="M-50 400 Q 200 320 430 370 T 880 350 T 1260 320" />
        </svg>

        <div class="relative max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-7">
                    <div class="flex items-center gap-3 mb-8">
                        <span aria-hidden class="inline-block w-8 h-px bg-ink"
                        ></span>
                        <h1 class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted">SOC 2 Readiness & Compliance Preparation</h1>
                    </div>

                    <p
                        class="font-display font-bold text-display text-ink text-balance"
                    >
                        Pass the review
                        <br />
                        before the deal <span class="italic text-accent">stalls</span>.
                    </p>

                    <p
                        class="mt-10 text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        An enterprise prospect asks for your SOC 2 report and a sales cycle suddenly depends on controls nobody has written down. Readiness work is what turns that from a year-long problem into a quarter.
                    </p>

                    <div class="mt-10 flex flex-wrap gap-3">
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-ink transition-colors"
                        >
                            Book a gap assessment
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#work"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            What's involved
                        </a>
                    </div>
                </div>

                <div class="col-span-12 lg:col-span-5 mt-12 lg:mt-0">
                    <div
                        class="border-2 border-ink bg-paper-2 lg:translate-y-2"
                        data-reveal
                    >
                        <div
                            class="flex items-center justify-between px-5 py-3 border-b-2 border-ink font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted"
                        >
                            <span>Your Controls / Readiness</span>
                            <span aria-hidden class="text-accent">● in scope</span>
                        </div>
                        {
                            panel.map((s, i) => {
                                const Icon = s.icon;
                                return (
                                    <div
                                        class:list={[
                                            "flex items-center gap-4 px-5 py-4",
                                            i !== panel.length - 1 &&
                                                "border-b border-ink/30",
                                        ]}
                                    >
                                        <span class="font-mono text-[10px] text-ink-muted w-6 shrink-0">
                                            0{i + 1}
                                        </span>
                                        <span class="w-9 h-9 shrink-0 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                            <Icon class="w-5 h-5" />
                                        </span>
                                        <span class="font-display font-bold tracking-tight text-lg leading-none">
                                            {s.title}
                                        </span>
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="relative border-t border-ink/40 bg-paper">
            <div
                class="max-w-7xl mx-auto px-6 py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 font-mono text-[10px] md:text-xs uppercase tracking-eyebrow text-ink-muted"
            >
                <span>Scoping</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Gaps</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Policies</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Controls</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Evidence</span>
            </div>
        </div>
    </section>

    <section id="work" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <div class="flex items-center gap-3 mb-5">
                        <span aria-hidden class="inline-block w-8 h-px bg-ink"
                        ></span>
                        <span
                            class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted"
                            >What's Involved</span
                        >
                    </div>
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Readiness,
                        <br />
                        not the audit.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        We are not your auditor and cannot be. A CPA firm issues the report. Our job is to get you to the point where that firm has nothing to write up.
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    work.map((item) => {
                        const Icon = item.icon;
                        return (
                            <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                                <div class="flex items-center gap-4 mb-6">
                                    <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                        <Icon />
                                    </span>
                                </div>
                                <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                    {item.title}
                                </h3>
                                <p class="text-ink-muted leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <section class="border-t-2 border-ink bg-paper-2 py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <div class="flex items-center gap-3 mb-5">
                        <span aria-hidden class="inline-block w-8 h-px bg-ink"
                        ></span>
                        <span
                            class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted"
                            >Two Ways In</span
                        >
                    </div>
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Scramble,
                        <br />
                        or ready.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Type II reports test controls over a period, which is why starting the week the auditor arrives cannot work. The observation window has already begun or it hasn't.
                    </p>
                </div>
            </div>

            <div class="border-t border-ink">
                <div
                    class="hidden md:grid grid-cols-12 gap-8 py-4 border-b border-ink font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted"
                >
                    <span class="col-span-6">Common</span>
                    <span class="col-span-6">Ready</span>
                </div>
                {
                    rows.map((row) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-center py-7 border-b border-ink">
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3 text-ink-muted">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px]"
                                >
                                    ×
                                </span>
                                <span class="leading-relaxed line-through decoration-ink/30">
                                    {row.before}
                                </span>
                            </div>
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px] text-accent"
                                >
                                    →
                                </span>
                                <span class="font-medium leading-relaxed">
                                    {row.after}
                                </span>
                            </div>
                        </div>
                    ))
                }
            </div>

            <p class="mt-8 text-ink-muted leading-relaxed max-w-2xl">
                Buyers often ask for a code-level review alongside the report; see <a href="/technical-due-diligence" class="link-underline font-medium text-ink"
                    >technical due diligence</a
                >. Most of the technical controls land in <a href="/cloud-application-development" class="link-underline font-medium text-ink"
                    >your cloud setup</a
                >.
            </p>

        </div>
    </section>

    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start">
            <div class="flex items-center gap-3 mb-8">
                <span aria-hidden class="inline-block w-8 h-px bg-paper"></span>
                <span
                    class="font-mono text-xs uppercase tracking-eyebrow text-paper/60"
                    >Start Early</span
                >
            </div>
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Ready before they <span class="italic text-accent">ask</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Tell us who's asking and by when. We'll assess the gap, tell you honestly whether the date is achievable, and what the fastest defensible path looks like.
            </p>
            <div class="flex flex-wrap gap-3 mb-12">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-paper transition-colors"
                >
                    Book a gap assessment
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/services/consulting"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    Consulting
                </a>
            </div>

            <div
                class="w-full border-t border-paper/20 pt-8 flex flex-wrap items-center gap-x-10 gap-y-3 font-mono text-xs uppercase tracking-eyebrow text-paper/60"
            >
                <a
                    href="https://motowntech.com"
                    class="link-underline text-paper"
                    >motowntech.com</a
                >
                <a href="tel:+18459252661" class="link-underline text-paper"
                    >845-925-2661</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
