---
import BaseLayout from "../layouts/BaseLayout.astro";

const quickLinks = [
    { href: "/services/software-development", label: "Software Development" },
    { href: "/services/mobile-development", label: "Mobile Development" },
    { href: "/about", label: "About Us" },
    { href: "/contact", label: "Contact Us" },
];
---

<BaseLayout
    meta_title="Page Not Found | Motown Solutions"
    noindex
    meta_description="The page you are looking for could not be found. Explore Motown Solutions services and resources."
>
    <section class="relative border-b-2 border-ink overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <h1
                class="font-display font-black leading-[0.9] tracking-[-0.04em] text-[clamp(6rem,20vw,20rem)]"
            >
                4<span class="italic text-accent">0</span>4
            </h1>
            <p class="mt-10 text-xl md:text-2xl text-ink-muted max-w-2xl leading-relaxed">
                The page you're looking for has wandered off into the
                digital void. Let's get you back on track.
            </p>
            <div class="mt-10 flex flex-wrap gap-3">
                <a
                    href="/"
                    class="group inline-flex items-center gap-2 bg-ink text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-paper hover:text-ink transition-colors"
                >
                    Back to Home
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/services"
                    class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                >
                    Browse Services
                </a>
            </div>
        </div>
    </section>

    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="border-t border-ink">
                {
                    quickLinks.map((l) => (
                        <a
                            href={l.href}
                            class="group relative block border-b border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            <div class="grid grid-cols-12 gap-4 md:gap-8 items-center py-6 md:py-7 px-4 md:px-6">
                                <h3 class="col-span-11 font-display text-xl md:text-2xl font-bold tracking-tight">
                                    {l.label}
                                </h3>
                                <span
                                    aria-hidden
                                    class="col-span-1 text-right font-mono text-xl transition-transform group-hover:translate-x-1"
                                >
                                    →
                                </span>
                            </div>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>
</BaseLayout>
