---
import BaseLayout from "../layouts/BaseLayout.astro";

import AnalyticsIcon from "../components/icons/AnalyticsIcon.astro";
import ConsultingIcon from "../components/icons/ConsultingIcon.astro";
import CloudIcon from "../components/icons/CloudIcon.astro";
import DatabaseIcon from "../components/icons/DatabaseIcon.astro";
import SendIcon from "../components/icons/SendIcon.astro";
import ShieldIcon from "../components/icons/ShieldIcon.astro";

const panel = [
    { title: "Bill Audit", icon: AnalyticsIcon },
    { title: "Workload Map", icon: ConsultingIcon },
    { title: "Workers / Pages", icon: CloudIcon },
    { title: "R2 · D1 · KV", icon: DatabaseIcon },
    { title: "Cutover", icon: SendIcon },
    { title: "Guardrails", icon: ShieldIcon },
];

const work = [
    {
        title: "Compute → Workers",
        icon: CloudIcon,
        desc: "API routes, handlers, and the glue between services move to Workers. No instances to size, no idle capacity reserved for a peak that arrives twice a year.",
    },
    {
        title: "Frontends → Pages",
        icon: SendIcon,
        desc: "Static sites and SSR frameworks deploy to Pages with the CDN, TLS, and preview environments included rather than assembled from four separate services.",
    },
    {
        title: "S3 → R2",
        icon: DatabaseIcon,
        desc: "Same S3 API, zero egress. For anything that serves files to users, this line item alone is often the whole business case.",
    },
    {
        title: "Databases → D1 or Hyperdrive",
        icon: AnalyticsIcon,
        desc: "Small relational workloads move to D1. Postgres and MySQL that need to stay put get Hyperdrive in front, so the Worker is not paying a cold connection tax on every request.",
    },
    {
        title: "Cron & Queues",
        icon: ConsultingIcon,
        desc: "Scheduled jobs become Cron Triggers, background work becomes Queues, and the EC2 box whose only job was running crontab is retired.",
    },
    {
        title: "What Stays",
        icon: ShieldIcon,
        desc: "GPU workloads, long-running stateful services, and anything with a hard-won compliance boundary stay where they are, fronted through Cloudflare so the rest can move.",
    },
];

const rows = [
    {
        before: "Egress billed on every file a user downloads",
        after: "R2 with zero egress, behind the same URLs",
    },
    {
        before: "Instances sized for peak, idle the rest of the month",
        after: "Workers billed per request, scaled to zero when quiet",
    },
    {
        before: "Load balancer, WAF, CDN and TLS each on their own bill",
        after: "Included with the platform, configured once",
    },
    {
        before: "A big-bang rewrite nobody wants to sign off on",
        after: "Route-by-route cutover behind the DNS you already have",
    },
];
---

<BaseLayout
    meta_title="AWS, GCP & Azure to Cloudflare Migration | Motown Solutions"
    meta_description="Move apps from AWS, GCP, or Azure to Cloudflare Workers, Pages, R2, and D1, route by route. Fees can be structured against the savings we find."
>
    <section class="relative overflow-hidden border-b-2 border-ink">
        <svg
            aria-hidden
            class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.12] text-ink"
            viewBox="0 0 1200 700"
            preserveAspectRatio="xMidYMid slice"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
        >
            <path d="M-50 520 Q 200 440 430 490 T 880 470 T 1260 440" />
            <path d="M-50 580 Q 200 500 430 550 T 880 530 T 1260 500" />
            <path d="M-50 640 Q 200 560 430 610 T 880 590 T 1260 560" />
            <path d="M-50 460 Q 200 380 430 430 T 880 410 T 1260 380" />
            <path d="M-50 400 Q 200 320 430 370 T 880 350 T 1260 320" />
        </svg>

        <div class="relative max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-7">
                    <div class="flex items-center gap-3 mb-8">
                        <span aria-hidden class="inline-block w-8 h-px bg-ink"
                        ></span>
                        <h1 class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted">AWS, GCP & Azure to Cloudflare Migration</h1>
                    </div>

                    <p
                        class="font-display font-bold text-display text-ink text-balance"
                    >
                        Off the big three.
                        <br />
                        Onto the <span class="italic text-accent">edge</span>.
                    </p>

                    <p
                        class="mt-10 text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        The bill is rarely the compute. It is egress, capacity reserved for a peak that never comes, and managed services priced for a scale you are not at. Most of an application moves to Cloudflare cleanly. The work is knowing which parts, and in what order.
                    </p>

                    <div class="mt-10 flex flex-wrap gap-3">
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-ink transition-colors"
                        >
                            Review my cloud bill
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#work"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            What moves
                        </a>
                    </div>
                </div>

                <div class="col-span-12 lg:col-span-5 mt-12 lg:mt-0">
                    <div
                        class="border-2 border-ink bg-paper-2 lg:translate-y-2"
                        data-reveal
                    >
                        <div
                            class="flex items-center justify-between px-5 py-3 border-b-2 border-ink font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted"
                        >
                            <span>Your App / Migration</span>
                            <span aria-hidden class="text-accent">● cut over</span>
                        </div>
                        {
                            panel.map((s, i) => {
                                const Icon = s.icon;
                                return (
                                    <div
                                        class:list={[
                                            "flex items-center gap-4 px-5 py-4",
                                            i !== panel.length - 1 &&
                                                "border-b border-ink/30",
                                        ]}
                                    >
                                        <span class="font-mono text-[10px] text-ink-muted w-6 shrink-0">
                                            0{i + 1}
                                        </span>
                                        <span class="w-9 h-9 shrink-0 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                            <Icon class="w-5 h-5" />
                                        </span>
                                        <span class="font-display font-bold tracking-tight text-lg leading-none">
                                            {s.title}
                                        </span>
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="relative border-t border-ink/40 bg-paper">
            <div
                class="max-w-7xl mx-auto px-6 py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 font-mono text-[10px] md:text-xs uppercase tracking-eyebrow text-ink-muted"
            >
                <span>Workers</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Pages</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>R2</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>D1</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>KV</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Queues</span>
            </div>
        </div>
    </section>

    <section id="work" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Most of it moves.
                        <br />
                        Some of it shouldn't.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        A migration is an inventory first. Each workload either has a Cloudflare-native home, needs a bridge, or belongs where it is. Deciding that honestly is what keeps the cutover boring.
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    work.map((item) => {
                        const Icon = item.icon;
                        return (
                            <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                                <div class="flex items-center gap-4 mb-6">
                                    <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                        <Icon />
                                    </span>
                                </div>
                                <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                    {item.title}
                                </h3>
                                <p class="text-ink-muted leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <section class="border-t-2 border-ink bg-paper-2 py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Paying for scale.
                        <br />
                        Not using it.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        The legacy cloud bill was designed around instances and regions. Most applications built in the last decade are neither, and pay every month for the mismatch.
                    </p>
                </div>
            </div>

            <div class="border-t border-ink">
                <div
                    class="hidden md:grid grid-cols-12 gap-8 py-4 border-b border-ink font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted"
                >
                    <span class="col-span-6">Common setup</span>
                    <span class="col-span-6">Built properly</span>
                </div>
                {
                    rows.map((row) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-center py-7 border-b border-ink">
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3 text-ink-muted">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px]"
                                >
                                    ×
                                </span>
                                <span class="leading-relaxed line-through decoration-ink/30">
                                    {row.before}
                                </span>
                            </div>
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px] text-accent"
                                >
                                    →
                                </span>
                                <span class="font-medium leading-relaxed">
                                    {row.after}
                                </span>
                            </div>
                        </div>
                    ))
                }
            </div>

            <p class="mt-8 text-ink-muted leading-relaxed max-w-2xl">
                What the application looks like once it is there is <a href="/cloud-application-development" class="link-underline font-medium text-ink"
                    >cloud application development</a
                >; when the code has to change on the way, it is <a href="/legacy-system-modernization" class="link-underline font-medium text-ink"
                    >legacy modernization</a
                >. For a platform already running on Workers, see the <a href="/case-studies/donation-platform" class="link-underline font-medium text-ink"
                    >donation platform case study</a
                >.
            </p>

        </div>
    </section>

    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start">
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Pay less. <span class="italic text-accent">Ship the same app</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Send us a recent invoice and a rough map of what runs where. We will tell you what moves, what stays, and what the bill looks like afterward. Engagements can be structured against the savings we find, so the audit costs nothing if there is nothing to save.
            </p>
            <div class="flex flex-wrap gap-3 mb-12">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-paper transition-colors"
                >
                    Review my cloud bill
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/services/software-development"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    Software Development
                </a>
            </div>

            <div
                class="w-full border-t border-paper/20 pt-8 flex flex-wrap items-center gap-x-10 gap-y-3 font-mono text-xs uppercase tracking-eyebrow text-paper/60"
            >
                <a
                    href="https://motowntech.com"
                    class="link-underline text-paper"
                    >motowntech.com</a
                >
                <a href="tel:+18459252661" class="link-underline text-paper"
                    >845-925-2661</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
