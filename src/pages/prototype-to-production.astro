---
import BaseLayout from "../layouts/BaseLayout.astro";
import Faq from "../components/Faq.astro";

import SoftwareIcon from "../components/icons/SoftwareIcon.astro";
import ApiIcon from "../components/icons/ApiIcon.astro";
import AutomationIcon from "../components/icons/AutomationIcon.astro";
import DatabaseIcon from "../components/icons/DatabaseIcon.astro";
import ShieldIcon from "../components/icons/ShieldIcon.astro";
import EnterpriseIcon from "../components/icons/EnterpriseIcon.astro";
import CloudIcon from "../components/icons/CloudIcon.astro";
import MailIcon from "../components/icons/MailIcon.astro";
import AnalyticsIcon from "../components/icons/AnalyticsIcon.astro";

// The production stack — the "tower" from the prototype to a real app.
const layers = [
    {
        title: "Application / UI",
        icon: SoftwareIcon,
        desc: "The interface users actually touch: accessible, responsive, and built to a standard a real audience expects.",
    },
    {
        title: "Integrations",
        icon: ApiIcon,
        desc: "APIs, payments, auth, and the third-party services your product depends on, wired in and hardened.",
    },
    {
        title: "Workflows",
        icon: AutomationIcon,
        desc: "Background jobs, queues, and business logic that run reliably, including off the happy path a demo sticks to.",
    },
    {
        title: "Data & Storage",
        icon: DatabaseIcon,
        desc: "A real schema, migrations, and backups. Data that stays consistent and survives a redeploy.",
    },
    {
        title: "Security",
        icon: ShieldIcon,
        desc: "Authentication, authorization, secrets management, and the guardrails that keep a live app safe.",
    },
    {
        title: "Infrastructure",
        icon: EnterpriseIcon,
        desc: "Hosting, CI/CD, monitoring, and scaling: the foundation that keeps everything up when it matters.",
    },
];

// The connected services on the right of the ad — what we wire your app into.
const services = [
    { title: "Cloud", icon: CloudIcon, desc: "Deploy & scale on AWS, GCP, or Azure." },
    { title: "Databases", icon: DatabaseIcon, desc: "Managed Postgres, Redis & object storage." },
    { title: "Email", icon: MailIcon, desc: "Transactional mail & notifications that land." },
    { title: "Security", icon: ShieldIcon, desc: "Auth, encryption & compliance baked in." },
    { title: "Analytics", icon: AnalyticsIcon, desc: "Monitoring, logging & product metrics." },
];

// Prototype vs. production — what changes when it has to run for real.
const beforeAfter = [
    {
        before: "Works on the demo, breaks on the second user",
        after: "Tested under real load with proper error handling",
    },
    {
        before: "Secrets hard-coded, anyone can sign in",
        after: "Real auth, role-based access, managed secrets",
    },
    {
        before: "Data lives in memory and resets",
        after: "Durable schema, migrations, and backups",
    },
    {
        before: "Deployed by hand, no way to roll back",
        after: "Automated CI/CD with monitoring and rollback",
    },
];

const faqs = [
    {
        q: "Can you make my AI-built or vibe-coded app production-ready?",
        a: "Yes. We take apps built with AI coding assistants, vibe-coded demos and prototypes stuck at 80%, and add what they skipped: a real data schema, authentication and permissions, background jobs, hardened integrations, automated deploys with rollback, and monitoring. The aim is an app you can put in front of paying customers and keep running.",
    },
    {
        q: "How long does it take to make a prototype production-ready?",
        a: "Most take roughly 4 to 8 weeks. Where yours falls depends on how much the prototype already does and what it skipped, such as sign-in, data that survives a redeploy, and integrations. We confirm a timeline once we have reviewed the prototype and know what stands between it and an app you can ship.",
    },
    {
        q: "Do you rewrite the prototype from scratch?",
        a: "We keep what the prototype got right and rebuild what it skipped. On a senior-care concierge app built on a low-code platform, we reproduced the workflow the team already knew, so nobody needed retraining, then rebuilt almost everything underneath it. The screens stayed familiar and the foundations changed.",
    },
    {
        q: "Can you take over a prototype built on a no-code or low-code platform?",
        a: "Yes. A no-code or low-code prototype has usually done the hard thinking already: the screens, the data and the way people actually work. We treat it as the specification, rebuild it as an application you own in your own cloud account, and add the security, data handling and infrastructure the platform left out.",
    },
    {
        q: "Is my AI-built app secure enough for customer data?",
        a: "Often it isn't yet. Prototypes commonly ship with hard-coded secrets and sign-in that lets anyone in, which is fine on a laptop and a real problem once customer data is involved. We add proper authentication, role-based access so each person reaches only what they should, and secrets managed outside the code.",
    },
    {
        q: "Why does my prototype lose its data when I redeploy?",
        a: "In many prototypes the data lives in memory or in a store nobody designed, so a restart resets it or leaves records that disagree. A production app needs a real schema, migrations so its structure can change without losing anything, and backups. We set those up so the data is still there after every deploy.",
    },
    {
        q: "What do I need to send you to get started?",
        a: "Send us the prototype as it is, whether it was vibe-coded, generated with AI, built on a no-code platform or stuck at 80%. We'll tell you what stands between it and an app you can ship. Start from the contact page or email contact@motowntech.com.",
    },
];
---

<BaseLayout
    meta_title="Prototype to Production for AI-Built Apps | Motown Solutions"
    meta_description="We turn AI-built and no-code prototypes into secure, production-ready apps with real architecture, integrations, data, security, and infrastructure."
>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b-2 border-ink">
        <!-- Contour-line decoration -->
        <svg
            aria-hidden
            class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.12] text-ink"
            viewBox="0 0 1200 700"
            preserveAspectRatio="xMidYMid slice"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
        >
            <path d="M-50 520 Q 200 440 430 490 T 880 470 T 1260 440" />
            <path d="M-50 580 Q 200 500 430 550 T 880 530 T 1260 500" />
            <path d="M-50 640 Q 200 560 430 610 T 880 590 T 1260 560" />
            <path d="M-50 460 Q 200 380 430 430 T 880 410 T 1260 380" />
            <path d="M-50 400 Q 200 320 430 370 T 880 350 T 1260 320" />
        </svg>

        <div class="relative max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-7">

                    <h1
                        class="font-display font-bold text-display text-ink text-balance"
                    >
                        Turn the AI-built
                        <br />
                        prototype into a
                        <span class="italic text-accent">production-ready</span>
                        app.
                    </h1>

                    <p
                        class="mt-10 text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        Architecture, integrations, workflows, data, security,
                        and polish for apps that need to run for real. We take
                        the thing you vibe-coded into a demo and make it
                        something you can ship, sell, and scale.
                    </p>

                    <div class="mt-10 flex flex-wrap gap-3">
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-ink transition-colors"
                        >
                            Make it production-ready
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#stack"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            See what we add
                        </a>
                    </div>
                </div>

                <!-- The stack "tower" -->
                <div class="col-span-12 lg:col-span-5 mt-12 lg:mt-0">
                    <div
                        class="border-2 border-ink bg-paper-2 lg:translate-y-2"
                        data-reveal
                    >
                        <div
                            class="flex items-center justify-between px-5 py-3 border-b-2 border-ink font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted"
                        >
                            <span>Your App / Production</span>
                            <span aria-hidden class="text-accent">● live</span>
                        </div>
                        {
                            layers.map((layer, i) => {
                                const Icon = layer.icon;
                                return (
                                    <div
                                        class:list={[
                                            "flex items-center gap-4 px-5 py-4",
                                            i !== layers.length - 1 &&
                                                "border-b border-ink/30",
                                        ]}
                                    >
                                        <span class="font-mono text-[10px] text-ink-muted w-6 shrink-0">
                                            0{i + 1}
                                        </span>
                                        <span class="w-9 h-9 shrink-0 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                            <Icon class="w-5 h-5" />
                                        </span>
                                        <span class="font-display font-bold tracking-tight text-lg leading-none">
                                            {layer.title}
                                        </span>
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Metadata strip -->
        <div class="relative border-t border-ink/40 bg-paper">
            <div
                class="max-w-7xl mx-auto px-6 py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 font-mono text-[10px] md:text-xs uppercase tracking-eyebrow text-ink-muted"
            >
                <span>Architecture</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Integrations</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Workflows</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Data &amp; Security</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Infrastructure</span>
            </div>
        </div>
    </section>

    <!-- The Stack -->
    <section id="stack" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        What it takes to
                        <br />
                        run for real.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        A prototype proves the idea. Production proves it holds
                        up. We build out every layer between the two, so the app that wowed in a demo becomes one you can put your
                        name on.
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    layers.map((layer) => {
                        const Icon = layer.icon;
                        return (
                            <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                                <div class="flex items-center gap-4 mb-6">
                                    <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                        <Icon />
                                    </span>
                                </div>
                                <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                    {layer.title}
                                </h3>
                                <p class="text-ink-muted leading-relaxed">
                                    {layer.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Connected services -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-7">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Connected to the
                        <br />
                        services it needs.
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:self-end text-ink-muted text-lg leading-relaxed"
                >
                    Your app doesn't run in isolation. We connect it to the
                    cloud, data, and tooling that keep it online and observable.
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 border border-ink">
                {
                    services.map((svc) => {
                        const Icon = svc.icon;
                        return (
                            <div class="p-7 md:p-8 border-ink border-b sm:border-r last:border-b-0 sm:[&:nth-child(even)]:border-r-0 lg:[&:not(:last-child)]:border-r lg:[&:nth-child(even)]:border-r lg:[&:nth-last-child(-n+1)]:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0">
                                <span class="w-10 h-10 mb-5 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                    <Icon />
                                </span>
                                <h3 class="font-display text-xl font-bold tracking-tight leading-tight mb-2">
                                    {svc.title}
                                </h3>
                                <p class="text-sm text-ink-muted leading-relaxed">
                                    {svc.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Prototype vs Production -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        From demo to
                        <br />
                        dependable.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        The gap between "it works on my machine" and "it works
                        for your customers" is exactly the work we do.
                    </p>
                </div>
            </div>

            <div class="border-t border-ink">
                <div
                    class="hidden md:grid grid-cols-12 gap-8 py-4 border-b border-ink font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted"
                >
                    <span class="col-span-6">Prototype</span>
                    <span class="col-span-6">Production-Ready</span>
                </div>
                {
                    beforeAfter.map((row) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-center py-7 border-b border-ink">
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3 text-ink-muted">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px]"
                                >
                                    ×
                                </span>
                                <span class="leading-relaxed line-through decoration-ink/30">
                                    {row.before}
                                </span>
                            </div>
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px] text-accent"
                                >
                                    →
                                </span>
                                <span class="font-medium leading-relaxed">
                                    {row.after}
                                </span>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <Faq items={faqs} heading="Questions about taking a prototype to production." />

    <!-- Final CTA -->
    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start">
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Make it
                <span class="italic text-accent">production-ready</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Send us your prototype, whether it's vibe-coded, AI-built, or stuck at 80%.
                We'll tell you what's between it and a real, shippable app, and
                how fast we can get you there.
            </p>
            <div class="flex flex-wrap gap-3 mb-12">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-paper transition-colors"
                >
                    Make it production-ready
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/services"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    View All Services
                </a>
            </div>

            <!-- Contact strip -->
            <div
                class="w-full border-t border-paper/20 pt-8 flex flex-wrap items-center gap-x-10 gap-y-3 font-mono text-xs uppercase tracking-eyebrow text-paper/60"
            >
                <a
                    href="https://motowntech.com"
                    class="link-underline text-paper"
                    >motowntech.com</a
                >
                <a href="tel:+18459252661" class="link-underline text-paper"
                    >845-925-2661</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
