---
import BaseLayout from "../layouts/BaseLayout.astro";

const sections = [
    {
        heading: "Acceptance of Terms",
        body: "By accessing or using the Motown Solutions website and services, you agree to these Terms of Service. If you do not agree, please do not use the site or our services.",
    },
    {
        heading: "Services",
        body: "Motown Solutions provides custom software development, AI development, web design, mobile development, automation, and consulting services. The scope, deliverables, and timeline of any engagement are governed by a separately signed agreement between you and Motown Solutions.",
    },
    {
        heading: "Intellectual Property",
        body: "Unless otherwise agreed in writing, all content on this site, including text, graphics, logos, and code, is the property of Motown Solutions and is protected by applicable intellectual property laws. Project deliverables and ownership are governed by your engagement agreement.",
    },
    {
        heading: "Acceptable Use",
        body: "You agree not to use this site or our services for any unlawful purpose, to attempt to gain unauthorized access to our systems, or to interfere with the operation of the site.",
    },
    {
        heading: "Limitation of Liability",
        body: "To the fullest extent permitted by law, Motown Solutions shall not be liable for any indirect, incidental, special, or consequential damages arising from your use of the site or services. Our total liability under any engagement is limited as set out in the relevant signed agreement.",
    },
    {
        heading: "Changes to These Terms",
        body: "We may update these Terms from time to time. The most current version will always be posted on this page. Continued use of the site after changes constitutes acceptance of the revised Terms.",
    },
    {
        heading: "Contact",
        body: "Questions about these Terms can be sent to contact@motowntech.com.",
    },
];
---

<BaseLayout
    meta_title="Terms of Service | Motown Solutions"
    meta_description="The terms governing your use of the Motown Solutions website and services."
>
    <!-- Hero -->
    <section class="relative border-b-2 border-ink overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-10">
                    <h1
                        class="font-display font-bold text-display text-ink text-balance"
                    >
                        Terms of <span class="italic text-accent">service</span
                        >.
                    </h1>
                </div>
                <div
                    class="col-span-12 lg:col-span-7 lg:col-start-4 mt-10 md:mt-16"
                >
                    <p
                        class="text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        The terms that govern your use of this website and
                        Motown Solutions services. Last updated 2026.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Body -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="border-t border-ink">
                {
                    sections.map((s) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-start py-10 md:py-12 border-b border-ink">
                            <h2 class="col-span-12 md:col-span-5 font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight">
                                {s.heading}
                            </h2>
                            <p class="col-span-12 md:col-span-7 md:pl-4 text-ink-muted leading-relaxed text-base md:text-lg">
                                {s.body}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</BaseLayout>
