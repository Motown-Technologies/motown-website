---
import BaseLayout from "../layouts/BaseLayout.astro";

import WebIcon from "../components/icons/WebIcon.astro";
import SoftwareIcon from "../components/icons/SoftwareIcon.astro";
import ShieldIcon from "../components/icons/ShieldIcon.astro";
import ApiIcon from "../components/icons/ApiIcon.astro";
import SendIcon from "../components/icons/SendIcon.astro";
import EnterpriseIcon from "../components/icons/EnterpriseIcon.astro";
import CloudIcon from "../components/icons/CloudIcon.astro";
import AutomationIcon from "../components/icons/AutomationIcon.astro";
import DatabaseIcon from "../components/icons/DatabaseIcon.astro";

// What a Shopify engagement actually touches.
const build = [
    { title: "Theme & Storefront", icon: WebIcon },
    { title: "Custom Apps", icon: SoftwareIcon },
    { title: "Checkout Extensions", icon: ShieldIcon },
    { title: "Integrations", icon: ApiIcon },
    { title: "Migrations", icon: SendIcon },
    { title: "Plus & B2B", icon: EnterpriseIcon },
];

// The work itself.
const work = [
    {
        title: "Custom Themes",
        icon: WebIcon,
        desc: "Built from your brand rather than bought and bent into shape. Liquid you can read, sections your marketing team can actually rearrange.",
    },
    {
        title: "Custom Apps",
        icon: SoftwareIcon,
        desc: "Private and embedded apps for the logic no plugin covers: pricing rules, bespoke product builders, internal ops tooling.",
    },
    {
        title: "Checkout & Functions",
        icon: ShieldIcon,
        desc: "Discounts, shipping and payment customisation through Shopify Functions, plus checkout UI extensions where the flow needs to change.",
    },
    {
        title: "Systems Integration",
        icon: ApiIcon,
        desc: "Orders, stock, and product data moving between Shopify and the ERP, 3PL, or accounting system the business runs on.",
    },
    {
        title: "App Diet",
        icon: AutomationIcon,
        desc: "Most stores carry a dozen apps, half of them overlapping and all of them loading. We replace the ones costing you speed and monthly fees.",
    },
    {
        title: "Migrations",
        icon: SendIcon,
        desc: "Moving onto Shopify from WooCommerce, Magento, or something custom, with URL maps and SEO settled before cutover.",
    },
];

// Where the work happens inside the platform.
const surfaces = [
    { title: "Liquid & Theme", icon: WebIcon, desc: "Sections, blocks, and metaobjects done properly." },
    { title: "Storefront API", icon: ApiIcon, desc: "For custom or headless front ends on Hydrogen." },
    { title: "Functions", icon: AutomationIcon, desc: "Server-side discount, shipping & payment logic." },
    { title: "Checkout UI", icon: ShieldIcon, desc: "Extensions on the supported checkout surface." },
    { title: "Admin & Flow", icon: DatabaseIcon, desc: "Back-office automation your ops team owns." },
];

// What we actually change.
const fixes = [
    {
        before: "A premium theme with four other themes' code still in it",
        after: "A lean custom theme carrying only what your store uses",
    },
    {
        before: "Fourteen apps, three doing the same job, all loading",
        after: "The handful that earn their place, the rest built in or cut",
    },
    {
        before: "Checkout changes blocked by \"the platform won't let us\"",
        after: "Functions and checkout extensions on supported surfaces",
    },
    {
        before: "Someone re-keying orders into the ERP every morning",
        after: "Orders, stock, and fulfilment syncing without a human",
    },
];
---

<BaseLayout
    meta_title="Shopify Development & Custom Apps | Motown Solutions"
    meta_description="Shopify development beyond the theme: custom themes, private apps, Shopify Functions, checkout extensions, ERP integrations, and migrations onto Shopify."
>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b-2 border-ink">
        <!-- Contour-line decoration -->
        <svg
            aria-hidden
            class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.12] text-ink"
            viewBox="0 0 1200 700"
            preserveAspectRatio="xMidYMid slice"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
        >
            <path d="M-50 520 Q 200 440 430 490 T 880 470 T 1260 440" />
            <path d="M-50 580 Q 200 500 430 550 T 880 530 T 1260 500" />
            <path d="M-50 640 Q 200 560 430 610 T 880 590 T 1260 560" />
            <path d="M-50 460 Q 200 380 430 430 T 880 410 T 1260 380" />
            <path d="M-50 400 Q 200 320 430 370 T 880 350 T 1260 320" />
        </svg>

        <div class="relative max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-7">

                    <h1
                        class="font-display font-bold text-display text-ink text-balance"
                    >
                        Shopify, built past
                        <br />
                        the <span class="italic text-accent">theme</span>.
                    </h1>

                    <p
                        class="mt-10 text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        Shopify gets a store live in a week. The trouble starts later, when the theme won't do what the brand needs,
                        the app stack is eating your load time, and the ERP
                        still gets updated by hand.
                    </p>

                    <div class="mt-10 flex flex-wrap gap-3">
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-ink transition-colors"
                        >
                            Start a Shopify build
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#work"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            What we do
                        </a>
                    </div>
                </div>

                <!-- What we touch -->
                <div class="col-span-12 lg:col-span-5 mt-12 lg:mt-0">
                    <div
                        class="border-2 border-ink bg-paper-2 lg:translate-y-2"
                        data-reveal
                    >
                        <div
                            class="flex items-center justify-between px-5 py-3 border-b-2 border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted"
                        >
                            <span>Your Shop / Build</span>
                            <span aria-hidden class="text-accent">● live</span>
                        </div>
                        {
                            build.map((item, i) => {
                                const Icon = item.icon;
                                return (
                                    <div
                                        class:list={[
                                            "flex items-center gap-4 px-5 py-4",
                                            i !== build.length - 1 &&
                                                "border-b border-ink/30",
                                        ]}
                                    >
                                        <span class="font-mono text-[11px] text-ink-muted w-6 shrink-0">
                                            0{i + 1}
                                        </span>
                                        <span class="w-9 h-9 shrink-0 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                            <Icon class="w-5 h-5" />
                                        </span>
                                        <span class="font-display font-bold tracking-tight text-lg leading-none">
                                            {item.title}
                                        </span>
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Metadata strip -->
        <div class="relative border-t border-ink/40 bg-paper">
            <div
                class="max-w-7xl mx-auto px-6 py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 font-mono text-[11px] md:text-xs uppercase tracking-eyebrow text-ink-muted"
            >
                <span>Themes</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Apps</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Checkout</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Integrations</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Migrations</span>
            </div>
        </div>
    </section>

    <!-- The work -->
    <section id="work" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Where an agency
                        <br />
                        earns its fee.
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Anyone can install a theme. The value is in the parts
                        Shopify doesn't hand you: the custom logic, the systems
                        behind it, and knowing which platform limits are real
                        and which are just unfamiliar.
                    </p>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    work.map((item) => {
                        const Icon = item.icon;
                        return (
                            <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                                <div class="flex items-center gap-4 mb-6">
                                    <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                        <Icon />
                                    </span>
                                </div>
                                <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                    {item.title}
                                </h3>
                                <p class="text-ink-muted leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Surfaces -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Inside the
                        <br />
                        platform, properly.
                    </h2>
                <p class="mt-5 max-w-2xl text-ink-muted text-lg leading-relaxed">
                    Shopify has supported extension points for most of what
                    people think it can't do. Building on them is the difference
                    between a store that upgrades cleanly and one that breaks
                    every release.
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 border border-ink">
                {
                    surfaces.map((item) => {
                        const Icon = item.icon;
                        return (
                            <div class="p-7 md:p-8 border-ink border-b sm:border-r last:border-b-0 sm:[&:nth-child(even)]:border-r-0 lg:[&:not(:last-child)]:border-r lg:[&:nth-child(even)]:border-r lg:[&:nth-last-child(-n+1)]:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0">
                                <span class="w-10 h-10 mb-5 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                    <Icon />
                                </span>
                                <h3 class="font-display text-xl font-bold tracking-tight leading-tight mb-2">
                                    {item.title}
                                </h3>
                                <p class="text-sm text-ink-muted leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- What changes -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Lighter store.
                        <br />
                        Fewer invoices.
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        A surprising amount of Shopify work is subtraction:
                        removing the apps, scripts, and theme code that arrived
                        one decision at a time and never left.
                    </p>
            </div>

            <div class="border-t border-ink">
                <div
                    class="hidden md:grid grid-cols-12 gap-8 py-4 border-b border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted"
                >
                    <span class="col-span-6">Typical store</span>
                    <span class="col-span-6">After</span>
                </div>
                {
                    fixes.map((row) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-center py-7 border-b border-ink">
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3 text-ink-muted">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px]"
                                >
                                    ×
                                </span>
                                <span class="leading-relaxed line-through decoration-ink/30">
                                    {row.before}
                                </span>
                            </div>
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px] text-accent"
                                >
                                    →
                                </span>
                                <span class="font-medium leading-relaxed">
                                    {row.after}
                                </span>
                            </div>
                        </div>
                    ))
                }
            </div>

            <!-- Boundary: when to go headless -->
            <div
                class="mt-16 border-2 border-ink bg-paper-2 p-8 md:p-10 grid grid-cols-12 gap-6 items-center"
            >
                <div class="col-span-12 md:col-span-8">
                    <div
                        class="font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted mb-3"
                    >
                        Outgrown the theme entirely?
                    </div>
                    <p class="text-lg leading-relaxed text-pretty">
                        Sometimes the answer is to take the storefront off Shopify's front end and keep the commerce engine underneath. That's a bigger decision
                        with real trade-offs, and it has its own page.
                    </p>
                </div>
                <div class="col-span-12 md:col-span-4 md:justify-self-end">
                    <a
                        href="/headless-commerce-development"
                        class="group inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                    >
                        Headless commerce
                        <span
                            class="transition-transform group-hover:translate-x-0.5"
                            aria-hidden>→</span
                        >
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Final CTA -->
    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start">
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Make Shopify
                <span class="italic text-accent">yours</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Send us your store URL. We'll come back with what's slowing it
                down, which apps you're paying twice for, and what we'd build
                instead.
            </p>
            <div class="flex flex-wrap gap-3 mb-12">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-paper transition-colors"
                >
                    Start a Shopify build
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/ecommerce-development"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    All Ecommerce Work
                </a>
            </div>

            <!-- Contact strip -->
            <div
                class="w-full border-t border-paper/20 pt-8 flex flex-wrap items-center gap-x-10 gap-y-3 font-mono text-xs uppercase tracking-eyebrow text-paper/60"
            >
                <a
                    href="https://motowntech.com"
                    class="link-underline text-paper"
                    >motowntech.com</a
                >
                <a href="tel:+18459252661" class="link-underline text-paper"
                    >845-925-2661</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
