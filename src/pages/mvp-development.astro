---
import BaseLayout from "../layouts/BaseLayout.astro";
import Faq from "../components/Faq.astro";

import ConsultingIcon from "../components/icons/ConsultingIcon.astro";
import WebIcon from "../components/icons/WebIcon.astro";
import SoftwareIcon from "../components/icons/SoftwareIcon.astro";
import ApiIcon from "../components/icons/ApiIcon.astro";
import AnalyticsIcon from "../components/icons/AnalyticsIcon.astro";
import SendIcon from "../components/icons/SendIcon.astro";
import MobileIcon from "../components/icons/MobileIcon.astro";
import ShieldIcon from "../components/icons/ShieldIcon.astro";
import CloudIcon from "../components/icons/CloudIcon.astro";
import DatabaseIcon from "../components/icons/DatabaseIcon.astro";

// The build timeline in the hero — a typical eight-to-twelve week v1.
const timeline = [
    { title: "Scope Workshop", week: "wk 1", icon: ConsultingIcon },
    { title: "Flows & Design", week: "wk 2", icon: WebIcon },
    { title: "Core Build", week: "wk 3–6", icon: SoftwareIcon },
    { title: "Integrations", week: "wk 6–8", icon: ApiIcon },
    { title: "Beta With Users", week: "wk 8–10", icon: AnalyticsIcon },
    { title: "Launch & Handover", week: "wk 10+", icon: SendIcon },
];

// What's actually in the build.
const included = [
    {
        title: "The One Loop",
        icon: ConsultingIcon,
        desc: "We find the single user journey that proves your idea works, and we build that. Everything else is written down and deferred.",
    },
    {
        title: "Real Interface",
        icon: WebIcon,
        desc: "A responsive, accessible product your first users won't apologise for using.",
    },
    {
        title: "Accounts & Payments",
        icon: ShieldIcon,
        desc: "Sign-up, login, roles, and taking money: the plumbing every product needs and no founder wants to spend six weeks on.",
    },
    {
        title: "Data That Persists",
        icon: DatabaseIcon,
        desc: "A schema designed for the questions you'll ask in six months, with migrations and backups from day one.",
    },
    {
        title: "Deploy Pipeline",
        icon: CloudIcon,
        desc: "Push to deploy, with staging, rollbacks, and error alerts. Shipping an update shouldn't be an event.",
    },
    {
        title: "Mobile Where It Matters",
        icon: MobileIcon,
        desc: "Responsive web by default, native only when the product genuinely needs the camera, push, or the app store.",
    },
];

// What you walk away owning.
const deliverables = [
    { title: "Working App", icon: WebIcon, desc: "Live, on your domain, with real users on it." },
    { title: "Source & Docs", icon: SoftwareIcon, desc: "Your repo, your accounts, readable setup notes." },
    { title: "Pipeline", icon: CloudIcon, desc: "Deploys, staging, backups, and monitoring." },
    { title: "Cost Model", icon: AnalyticsIcon, desc: "What it costs to run at 100 and 10,000 users." },
    { title: "Next 90 Days", icon: SendIcon, desc: "A prioritised backlog with what to build next." },
];

// Scope discipline — the difference between a v1 that ships and one that doesn't.
const discipline = [
    {
        before: "A feature list built from every conversation you've had",
        after: "One loop that proves value, everything else parked in writing",
    },
    {
        before: "Architected for the million users you don't have yet",
        after: "Built simply, and built to be rewritten once you've earned it",
    },
    {
        before: "Launch date slips every time someone has a good idea",
        after: "Fixed scope and a fixed date, with new ideas going into the next cycle",
    },
    {
        before: "You can't change anything without calling the agency",
        after: "You own the repo, the accounts, and the deploy button",
    },
];
const faqs = [
    {
        q: "What should an MVP include?",
        a: "One user journey that proves the idea works, built properly, plus the plumbing every product needs: sign-up and login, payments, data with backups, and a way to deploy updates safely. Every other feature goes on a written list for later. That list is what keeps the launch date from moving.",
    },
    {
        q: "How long does it take to build an MVP?",
        a: "Our usual plan starts with a scope workshop in week one and design in week two. The core build runs from week three to week six, integrations follow, and real users test a beta around weeks eight to ten before launch and handover. The exact length depends on what the one loop needs, which the workshop settles.",
    },
    {
        q: "Do I need a technical co-founder to build an MVP?",
        a: "No. We build the product and hand you the code, the accounts, setup notes and the deploy pipeline, all in your name from the first commit. If you hire an engineer later, they can pick it up without calling us. If you want senior technical judgment before that hire, that is what our fractional CTO work covers.",
    },
    {
        q: "Will the MVP code be thrown away later?",
        a: "Some of it may be rewritten, and that is planned. We build the first version simply so it can be rewritten once real usage shows what matters. The parts users touch are built properly, and the data model is designed for the questions you will ask in six months, with migrations and backups from day one.",
    },
    {
        q: "Should my MVP be a mobile app or a web app?",
        a: "Usually a web app. We build responsive web by default, so it works on phones and laptops from one codebase. A native app makes sense when the product really needs the camera, push notifications or a place in the app store. Otherwise the web version is the product.",
    },
    {
        q: "What happens if we think of new features during the build?",
        a: "They go on the list for the next cycle. Scope and launch date are fixed when the build starts, because an MVP that absorbs every good idea tends to never launch. You leave with a prioritised backlog for the next 90 days, so those ideas are written down and ready when the first version is live.",
    },
];
---

<BaseLayout
    meta_title="MVP Development for Startups | Motown Solutions"
    meta_description="MVP development for founders. We scope your idea to the one loop that proves it, build a real product in weeks, and hand over the code, pipeline, and roadmap."
>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b-2 border-ink">
        <!-- Contour-line decoration -->
        <svg
            aria-hidden
            class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.12] text-ink"
            viewBox="0 0 1200 700"
            preserveAspectRatio="xMidYMid slice"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
        >
            <path d="M-50 520 Q 200 440 430 490 T 880 470 T 1260 440" />
            <path d="M-50 580 Q 200 500 430 550 T 880 530 T 1260 500" />
            <path d="M-50 640 Q 200 560 430 610 T 880 590 T 1260 560" />
            <path d="M-50 460 Q 200 380 430 430 T 880 410 T 1260 380" />
            <path d="M-50 400 Q 200 320 430 370 T 880 350 T 1260 320" />
        </svg>

        <div class="relative max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-7">

                    <h1
                        class="font-display font-bold text-display text-ink text-balance"
                    >
                        From idea to an MVP real users can <span class="italic text-accent">break</span>.
                    </h1>

                    <p
                        class="mt-10 text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        An MVP isn't a smaller version of the whole product. It's
                        the smallest thing that answers the question your
                        business depends on. We help you find that question, then
                        build the answer in weeks rather than quarters.
                    </p>

                    <div class="mt-10 flex flex-wrap gap-3">
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-ink transition-colors"
                        >
                            Scope my MVP
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#included"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            What's in a build
                        </a>
                    </div>
                </div>

                <!-- The build timeline -->
                <div class="col-span-12 lg:col-span-5 mt-12 lg:mt-0">
                    <div
                        class="border-2 border-ink bg-paper-2 lg:translate-y-2"
                        data-reveal
                    >
                        <div
                            class="flex items-center justify-between px-5 py-3 border-b-2 border-ink font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted"
                        >
                            <span>Your MVP / Timeline</span>
                            <span aria-hidden class="text-accent">● week 6</span>
                        </div>
                        {
                            timeline.map((step, i) => {
                                const Icon = step.icon;
                                return (
                                    <div
                                        class:list={[
                                            "flex items-center gap-4 px-5 py-4",
                                            i !== timeline.length - 1 &&
                                                "border-b border-ink/30",
                                        ]}
                                    >
                                        <span class="font-mono text-[10px] text-ink-muted w-14 shrink-0 whitespace-nowrap">
                                            {step.week}
                                        </span>
                                        <span class="w-9 h-9 shrink-0 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                            <Icon class="w-5 h-5" />
                                        </span>
                                        <span class="font-display font-bold tracking-tight text-lg leading-none">
                                            {step.title}
                                        </span>
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Metadata strip -->
        <div class="relative border-t border-ink/40 bg-paper">
            <div
                class="max-w-7xl mx-auto px-6 py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 font-mono text-[10px] md:text-xs uppercase tracking-eyebrow text-ink-muted"
            >
                <span>Scoping</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Design</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Build</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Beta</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Handover</span>
            </div>
        </div>
    </section>

    <!-- What's included -->
    <section id="included" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Small scope.
                        <br />
                        Real product.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Cutting scope doesn't mean cutting quality. The parts we
                        keep get built properly, because those are the parts
                        your users, and your next investor, will actually touch.
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    included.map((item) => {
                        const Icon = item.icon;
                        return (
                            <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                                <div class="flex items-center gap-4 mb-6">
                                    <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                        <Icon />
                                    </span>
                                </div>
                                <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                    {item.title}
                                </h3>
                                <p class="text-ink-muted leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Deliverables -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-7">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        What you own
                        <br />
                        at the end.
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:self-end text-ink-muted text-lg leading-relaxed"
                >
                    Everything is in your accounts, under your name, from the
                    first commit. If you hire an engineer next month, they can
                    pick it up without calling us.
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 border border-ink">
                {
                    deliverables.map((item) => {
                        const Icon = item.icon;
                        return (
                            <div class="p-7 md:p-8 border-ink border-b sm:border-r last:border-b-0 sm:[&:nth-child(even)]:border-r-0 lg:[&:not(:last-child)]:border-r lg:[&:nth-child(even)]:border-r lg:[&:nth-last-child(-n+1)]:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0">
                                <span class="w-10 h-10 mb-5 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                    <Icon />
                                </span>
                                <h3 class="font-display text-xl font-bold tracking-tight leading-tight mb-2">
                                    {item.title}
                                </h3>
                                <p class="text-sm text-ink-muted leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Scope discipline -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Why most MVPs
                        <br />
                        never launch.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Usually because nobody ever decided what wasn't in them.
                    </p>
                </div>
            </div>

            <div class="border-t border-ink">
                <div
                    class="hidden md:grid grid-cols-12 gap-8 py-4 border-b border-ink font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted"
                >
                    <span class="col-span-6">How MVPs stall</span>
                    <span class="col-span-6">How we run them</span>
                </div>
                {
                    discipline.map((row) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-center py-7 border-b border-ink">
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3 text-ink-muted">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px]"
                                >
                                    ×
                                </span>
                                <span class="leading-relaxed line-through decoration-ink/30">
                                    {row.before}
                                </span>
                            </div>
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px] text-accent"
                                >
                                    →
                                </span>
                                <span class="font-medium leading-relaxed">
                                    {row.after}
                                </span>
                            </div>
                        </div>
                    ))
                }
            </div>

            <!-- Boundary: MVP vs prototype-to-production -->
            <div
                class="mt-16 border-2 border-ink bg-paper-2 p-8 md:p-10 grid grid-cols-12 gap-6 items-center"
            >
                <div class="col-span-12 md:col-span-8">
                    <div
                        class="font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted mb-3"
                    >
                        Already started?
                    </div>
                    <p class="text-lg leading-relaxed text-pretty">
                        This page is for going from nothing to a first version.
                        If you've already got something (a vibe-coded demo, a no-code build, an AI-generated prototype), the work is different, and it has its own page.
                    </p>
                </div>
                <div class="col-span-12 md:col-span-4 md:justify-self-end">
                    <a
                        href="/prototype-to-production"
                        class="group inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                    >
                        Prototype to production
                        <span
                            class="transition-transform group-hover:translate-x-0.5"
                            aria-hidden>→</span
                        >
                    </a>
                </div>
            </div>
        </div>
    </section>

    <Faq items={faqs} heading="Questions founders ask about MVPs." />

    <!-- Final CTA -->
    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start">
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Ship the
                <span class="italic text-accent">first version</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Bring the idea in whatever shape it's in: a doc, a deck, a drawing. We'll come back with the loop worth building, a
                timeline, and a number.
            </p>
            <div class="flex flex-wrap gap-3 mb-12">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-paper transition-colors"
                >
                    Scope my MVP
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/startup-consulting"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    Startup Consulting
                </a>
            </div>

            <!-- Contact strip -->
            <div
                class="w-full border-t border-paper/20 pt-8 flex flex-wrap items-center gap-x-10 gap-y-3 font-mono text-xs uppercase tracking-eyebrow text-paper/60"
            >
                <a
                    href="https://motowntech.com"
                    class="link-underline text-paper"
                    >motowntech.com</a
                >
                <a href="tel:+18459252661" class="link-underline text-paper"
                    >845-925-2661</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
