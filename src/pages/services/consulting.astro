---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { Image } from "astro:assets";
import Faq from "../../components/Faq.astro";

import processImage from "../../img/it-consultant-presenting-technology-strategy-to-bu.jpg";

const services = [
    {
        title: "IT Strategy",
        desc: "IT roadmaps tied to what the business is trying to do",
        iconPath:
            "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01",
        bullets: [
            "Technology assessment",
            "Strategic planning",
            "Digital transformation",
            "ROI analysis",
        ],
        link: { href: "/it-strategy-consulting", label: "IT strategy consulting" },
    },
    {
        title: "Software Selection",
        desc: "Pick software that fits, with the total cost understood before you sign",
        iconPath:
            "M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z",
        bullets: [
            "Requirements analysis",
            "Vendor evaluation",
            "Cost-benefit analysis",
            "Implementation planning",
        ],
        link: { href: "/software-selection-consulting", label: "Software selection consulting" },
    },
    {
        title: "Process Optimization",
        desc: "Simplify how work gets done before automating any of it",
        iconPath: "M13 10V3L4 14h7v7l9-11h-7z",
        bullets: [
            "Workflow analysis",
            "Automation opportunities",
            "Best practices implementation",
            "Change management",
        ],
        link: { href: "/process-optimization-consulting", label: "Process optimisation consulting" },
    },
    {
        title: "Platform Modernization Advisory",
        desc: "Evaluate legacy stacks, plan migrations, and optimize cloud investments",
        iconPath:
            "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253",
        bullets: [
            "Current-state architecture reviews",
            "Workshops & seminars",
            "Documentation & guides",
            "Ongoing support",
        ],
        link: { href: "/legacy-system-modernization", label: "Legacy system modernisation" },
    },
];

const situations = [
    {
        t: "Your stack grew by accident",
        d: "Each tool was picked on its own, often from whichever vendor called that quarter, and nobody decides when two teams disagree. We write a roadmap tied to your priorities and budget, then review it with you every quarter.",
    },
    {
        t: "You're about to buy major software",
        d: "We agree your requirements before any vendor is contacted, script the demos against your real scenarios and model implementation, migration and exit costs alongside the licence price.",
    },
    {
        t: "A process everyone works around",
        d: "Before anything gets automated, we map the process, measure cycle time and error rate, and remove the steps that add nothing. Changes are piloted with one team first.",
    },
    {
        t: "An old system you can't switch off",
        d: "We find the seams, plan an incremental replacement and run the old and new systems side by side until the numbers reconcile.",
    },
    {
        t: "A raise, a sale or a security review is coming",
        d: "We audit the codebase on your timeline, before an investor's engineer does, and help you prepare for the SOC 2 report buyers often ask for.",
    },
];

const related = [
    {
        href: "/blog/fractional-cto-for-startups",
        title: "Fractional vs. full-time CTO: which a startup needs",
        d: "What a startup without a senior technical lead is missing, and what a part-time CTO takes on.",
    },
    {
        href: "/blog/technical-due-diligence-explained",
        title: "What technical due diligence checks before a raise or sale",
        d: "What a technical due diligence checks before a raise or an acquisition.",
    },
    {
        href: "/blog/inherited-codebase",
        title: "Taking over someone else's codebase without breaking it",
        d: "How we take over someone else's codebase that still works, and make it safe to change.",
    },
    {
        href: "/fractional-cto",
        title: "Fractional CTO",
        d: "Senior technical judgment on retainer, starting with a two-week audit.",
    },
    {
        href: "/technical-due-diligence",
        title: "Technical due diligence",
        d: "A two-week, fixed-scope audit for founders preparing a raise and for investors reviewing a company.",
    },
];

const faqs = [
    {
        q: "What does an IT strategy engagement produce?",
        a: "A roadmap tied to your business priorities and budget, an architecture your teams agree on, and governance that names who decides what. We assess your current systems first and come back with a plan and a number. After that we review the plan with you each quarter against what actually happened.",
    },
    {
        q: "Can you help us choose between software vendors?",
        a: "Yes. We agree requirements before any vendor is contacted, run scripted demos against your real scenarios and source our own reference calls. We model implementation, migration and exit costs along with the licence, and review the contract's renewal terms, price increases, data ownership and exit clauses. You get an independent recommendation you can defend.",
    },
    {
        q: "Should we automate a process or fix it first?",
        a: "Fix it first. We map the process, measure cycle time and error rate, and remove the steps that add nothing before anything is built. The changes are piloted with the team that runs the process and measured against the baseline. Once the process is worth keeping, automating it is a separate piece of work.",
    },
    {
        q: "How do you replace a legacy system without stopping the business?",
        a: "Incrementally. We put a facade in front of the old system, capture its behaviour as tests and replace it piece by piece. Old and new run side by side, processing the same work, until the outputs reconcile. Each phase delivers value on its own and can be stopped at any point.",
    },
    {
        q: "We're a startup without a technical lead. Is this the right service?",
        a: "Usually our startup consulting is a better fit. Depending on where you are, that means an MVP build, a fractional CTO on retainer or a technical due diligence before a raise. A fractional CTO engagement starts with a two-week, fixed-scope audit with written findings.",
    },
];

const approach = [
    {
        t: "Discovery & Assessment",
        d: "We review your current systems, business goals, and pain points",
    },
    {
        t: "Strategy Development",
        d: "We write a roadmap with clear priorities and timelines",
    },
    {
        t: "Implementation Support",
        d: "We stay involved, hands-on, through execution",
    },
    {
        t: "Continuous Improvement",
        d: "We track results and adjust the plan as things change",
    },
];
---

<BaseLayout
    meta_title="IT Consulting Services | Motown Solutions"
    meta_description="IT consulting services: technology strategy and roadmaps, software selection, process optimisation, and legacy platform modernization advice."
>
    <!-- Hero -->
    <section class="relative border-b-2 border-ink overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-10">
                    <h1
                        class="font-display font-bold text-display text-ink text-balance"
                    >
                        IT consulting
                        <br />
                        you can <span class="italic text-accent">act on</span>
                    </h1>
                </div>
                <div class="col-span-12 lg:col-span-7 lg:col-start-4 mt-10 md:mt-16">
                    <p
                        class="text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        Our consultants help you make technology decisions that match your business goals, from the roadmap to the software you buy.
                    </p>
                    <div class="mt-10 flex flex-wrap gap-3" data-reveal>
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-ink text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-paper hover:text-ink transition-colors"
                        >
                            Schedule Consultation
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#services"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            View Services
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services -->
    <section id="services" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Consulting Services
                    </h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 border border-ink">
                {
                    services.map((svc) => (
                        <div class="p-8 md:p-10 border-ink border-b md:[&:nth-child(odd)]:border-r md:[&:nth-child(n+3)]:border-b-0 last:border-b-0">
                            <div class="flex items-center gap-4 mb-6">
                                <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                    <svg
                                        class="w-5 h-5"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d={svc.iconPath}
                                        />
                                    </svg>
                                </span>
                            </div>
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                {svc.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed mb-5">
                                {svc.desc}
                            </p>
                            <ul class="space-y-2 text-sm">
                                {svc.bullets.map((b) => (
                                    <li class="flex items-start gap-3">
                                        <span
                                            aria-hidden
                                            class="font-mono mt-[2px]"
                                        >
                                            →
                                        </span>
                                        <span>{b}</span>
                                    </li>
                                ))}
                            </ul>
                            {svc.link && (
                                <a
                                    href={svc.link.href}
                                    class="link-underline inline-block mt-6 font-mono text-xs uppercase tracking-[0.15em]"
                                    >{svc.link.label}&nbsp;→</a
                                >
                            )}
                        </div>
                    ))
                }
            </div>

            <p class="mt-8 text-ink-muted leading-relaxed max-w-2xl">
                Earlier-stage company without a technical lead? That's a different engagement:
                <a
                    href="/startup-consulting"
                    class="link-underline font-medium text-ink"
                    >startup consulting</a
                >.
            </p>
        </div>
    </section>

    <!-- When to call us -->
    <section class="border-t-2 border-ink py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2 class="font-display font-bold text-h2 tracking-tight text-balance">What brings clients to us</h2>
            </div>

            <div class="border-t border-ink">
                {
                    situations.map((item) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-start py-8 px-1 border-b border-ink">
                            <h3 class="col-span-12 md:col-span-5 font-display text-xl md:text-2xl font-bold tracking-tight leading-snug">
                                {item.t}
                            </h3>
                            <p class="col-span-12 md:col-span-7 md:pl-4 text-ink-muted leading-relaxed max-w-prose text-sm md:text-base">
                                {item.d}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Approach -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Our Consulting Approach
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        We learn how your business runs, then give you recommendations you can act on.
                    </p>
            </div>

            <div class="grid grid-cols-12 gap-6 md:gap-10">
                <div class="col-span-12 md:col-span-5">
                    <div class="border border-ink aspect-[4/3] overflow-hidden">
                        <Image
                            src={processImage}
                            alt="IT consultant presenting a technology strategy to business leaders"
                            class="w-full h-full object-cover"
                        />
                    </div>
                </div>
                <div class="col-span-12 md:col-span-7">
                    <div class="border-t border-ink">
                        {
                            approach.map((step) => (
                                <div class="grid grid-cols-12 gap-4 md:gap-8 items-start py-8 px-1 border-b border-ink">
                                    <h3 class="col-span-12 md:col-span-5 font-display text-xl md:text-2xl font-bold tracking-tight leading-snug">
                                        {step.t}
                                    </h3>
                                    <p class="col-span-12 md:col-span-7 md:pl-4 text-ink-muted leading-relaxed max-w-prose text-sm md:text-base">
                                        {step.d}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Related work -->
    <section class="border-t-2 border-ink py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2 class="font-display font-bold text-h2 tracking-tight text-balance">Read more about how we work</h2>
                </div>
            </div>

            <ul class="border-t border-ink">
                {
                    related.map((item) => (
                        <li class="border-b border-ink">
                            <a href={item.href} class="group grid grid-cols-12 gap-4 md:gap-8 items-start py-8 px-1">
                                <span class="col-span-12 md:col-span-5 font-display text-xl md:text-2xl font-bold tracking-tight leading-snug group-hover:text-accent transition-colors">
                                    {item.title}
                                </span>
                                <span class="col-span-11 md:col-span-6 md:pl-4 text-ink-muted leading-relaxed text-sm md:text-base">
                                    {item.d}
                                </span>
                                <span aria-hidden class="col-span-1 text-right font-mono transition-transform group-hover:translate-x-1">→</span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <Faq items={faqs} heading="Questions about consulting." />

    <!-- Final CTA -->
    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div
            class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start"
        >
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Bring us the <span class="italic text-accent">decision</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Book a consultation and tell us which technology decisions are on your desk.
            </p>
            <div class="flex flex-wrap gap-3">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-paper text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-ink hover:text-paper transition-colors"
                >
                    Schedule Consultation
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/services"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    View All Services
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
