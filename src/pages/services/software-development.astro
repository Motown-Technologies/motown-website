---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Reuse existing icons you already created
import MobileIcon from "../../components/icons/MobileIcon.astro";
import WebIcon from "../../components/icons/WebIcon.astro";

// New icons from above
import ApiIcon from "../../components/icons/ApiIcon.astro";
import CloudIcon from "../../components/icons/CloudIcon.astro";
import DatabaseIcon from "../../components/icons/DatabaseIcon.astro";
import EnterpriseIcon from "../../components/icons/EnterpriseIcon.astro";

import { Image } from "astro:assets";
import agileImage from "../../img/agile-software-development-team-collaboration-whit.jpg";

const capabilities = [
    {
        title: "Web Applications",
        desc: "Responsive, scalable web apps built on modern frameworks",
        icon: WebIcon,
        bullets: [
            "Custom dashboards & management systems",
            "Progressive Web Apps",
            "E-commerce & client portals",
            "Integrations with third-party APIs & services",
        ],
        link: {
            href: "/web-application-development",
            label: "Web application development",
        },
    },
    {
        title: "Enterprise Solutions",
        desc: "Systems designed to grow with your business",
        icon: EnterpriseIcon,
        bullets: [
            "Custom CRM & ERP systems",
            "Business intelligence dashboards",
            "Workflow automation",
            "Legacy system modernization",
        ],
        link: { href: "/enterprise-software-development", label: "Enterprise software development" },
    },
    {
        title: "API Development",
        desc: "Secure, well-documented APIs for your integrations",
        icon: ApiIcon,
        bullets: [
            "RESTful & GraphQL APIs",
            "Third-party integrations",
            "Scalable design & architecture",
            "API security & authentication",
        ],
        link: { href: "/api-development", label: "API development" },
    },
    {
        title: "Cloud Solutions",
        desc: "Cloud-native applications built for performance and reliability",
        icon: CloudIcon,
        bullets: [
            "AWS, Azure, Google Cloud",
            "Serverless architecture",
            "Container orchestration",
            "DevOps & CI/CD pipelines",
        ],
        link: { href: "/cloud-application-development", label: "Cloud application development" },
    },
    {
        title: "Mobile Backend",
        desc: "Backend systems that support mobile apps at scale",
        icon: MobileIcon,
        bullets: [
            "Push notifications",
            "User authentication & authorization",
            "Real-time data sync",
            "Analytics & monitoring",
        ],
        link: { href: "/mobile-backend-development", label: "Mobile backend development" },
    },
    {
        title: "Database Design",
        desc: "Optimized data architecture for performance and scalability",
        icon: DatabaseIcon,
        bullets: [
            "SQL & NoSQL databases",
            "Data modeling & optimization",
            "Migration & replication",
            "Backup & disaster recovery",
        ],
        link: { href: "/database-design", label: "Database design" },
    },
];

const process = [
    {
        t: "Discovery & Planning",
        d: "We analyze your requirements, define project scope, and create a detailed roadmap",
    },
    {
        t: "Design & Architecture",
        d: "We design the interface and the system architecture",
    },
    {
        t: "Development & Testing",
        d: "We build it with continuous testing and QA",
    },
    {
        t: "Deployment & Support",
        d: "We launch your application and provide ongoing maintenance and support",
    },
];

const techBlocks = [
    {
        title: "Frontend Technologies",
        items: [
            "React & Next.js",
            "Vue.js & Nuxt",
            "Angular",
            "Astro",
            "JavaScript & TypeScript",
            "CSS & Tailwind",
        ],
    },
    {
        title: "Backend Technologies",
        items: [
            "Node.js & Express",
            ".NET Core",
            "Python & Django",
            "PHP & Laravel",
            "PostgreSQL",
            "MySQL/MariaDB",
        ],
    },
    {
        title: "Cloud & DevOps",
        items: [
            "AWS & Azure",
            "Digital Ocean",
            "Docker & Kubernetes",
            "GitHub Actions",
            "Vercel & Netlify",
            "CI/CD",
        ],
    },
    {
        title: "Mobile & More",
        items: [
            "React Native",
            "Flutter",
            "GraphQL",
            "WebSockets",
            "Stripe & Payments",
            "Auth0 & OAuth",
        ],
    },
];
---

<BaseLayout
    meta_title="Custom Software Development | Motown Solutions"
    meta_description="Custom software development: web applications, enterprise systems, APIs, cloud-native applications, mobile backends, and database design."
>
    <!-- Hero -->
    <section class="relative border-b-2 border-ink overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-10">
                    <h1
                        class="font-display font-bold text-hero text-ink text-balance"
                    >
                        Custom software for
                        <br />
                        how your business <span class="italic text-accent">runs</span>
                    </h1>
                </div>
                <div class="col-span-12 lg:col-span-7 lg:col-start-4 mt-10 md:mt-16">
                    <p
                        class="text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        We build custom web applications, enterprise systems, APIs, and the cloud and data infrastructure under them.
                    </p>
                    <div class="mt-10 flex flex-wrap gap-3" data-reveal>
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-ink text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-paper hover:text-ink transition-colors"
                        >
                            Start Your Project
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#capabilities"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            View Capabilities
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Capabilities -->
    <section id="capabilities" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        What We Build
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:col-start-8 md:self-end"
                >
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        We take projects from first concept through deployment
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    capabilities.map((cap) => {
                        const Icon = cap.icon;
                        return (
                            <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                                <div class="flex items-center gap-4 mb-6">
                                    <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                        <Icon />
                                    </span>
                                </div>
                                <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                    {cap.title}
                                </h3>
                                <p class="text-ink-muted leading-relaxed mb-5">
                                    {cap.desc}
                                </p>
                                <ul class="space-y-2 text-sm">
                                    {cap.bullets.map((b) => (
                                        <li class="flex items-start gap-3">
                                            <span
                                                aria-hidden
                                                class="font-mono mt-[2px]"
                                            >
                                                →
                                            </span>
                                            <span>{b}</span>
                                        </li>
                                    ))}
                                </ul>
                                {cap.link && (
                                    <a
                                        href={cap.link.href}
                                        class="link-underline inline-block mt-6 font-mono text-xs uppercase tracking-[0.15em]"
                                        >{cap.link.label}&nbsp;→</a
                                    >
                                )}
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Process -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Our Development Process
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:col-start-8 md:self-end"
                >
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        We keep you informed at every stage and build software that does what it was meant to do.
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-12 gap-6 md:gap-10 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-5">
                    <div class="border border-ink aspect-[4/3] overflow-hidden">
                        <Image
                            src={agileImage}
                            alt="Software development team collaborating at a whiteboard"
                            class="w-full h-full object-cover"
                        />
                    </div>
                </div>
                <div class="col-span-12 md:col-span-7">
                    <div class="border-t border-ink">
                        {
                            process.map((step) => (
                                <div class="grid grid-cols-12 gap-4 md:gap-8 items-start py-8 px-1 border-b border-ink">
                                    <h3 class="col-span-12 md:col-span-5 font-display text-xl md:text-2xl font-bold tracking-tight leading-snug">
                                        {step.t}
                                    </h3>
                                    <p class="col-span-12 md:col-span-7 md:pl-4 text-ink-muted leading-relaxed max-w-prose text-sm md:text-base">
                                        {step.d}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Technologies -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Technologies We Master
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:col-start-8 md:self-end"
                >
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        The tools we use most often
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 border border-ink">
                {
                    techBlocks.map((block) => (
                        <div class="p-8 md:p-10 border-ink border-b md:[&:nth-child(odd)]:border-r md:[&:nth-child(n+3)]:border-b-0 last:border-b-0">
                            <div class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted mb-6">
                                — {block.title}
                            </div>
                            <ul class="grid grid-cols-2 gap-y-2 gap-x-4 text-sm md:text-base">
                                {block.items.map((tech) => (
                                    <li class="flex items-start gap-2">
                                        <span
                                            aria-hidden
                                            class="font-mono mt-[2px]"
                                        >
                                            ·
                                        </span>
                                        <span>{tech}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Final CTA -->
    <section
        id="contact"
        class="section-ink border-t-2 border-ink"
        data-reveal
    >
        <div
            class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start"
        >
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Ready to Build Something <span class="italic text-accent"
                    >Amazing</span
                >?
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Tell us about your project, and we'll tell you how we'd build it.
            </p>
            <div class="flex flex-wrap gap-3">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-paper text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-ink hover:text-paper transition-colors"
                >
                    Get in Touch
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/services"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    View All Services
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
