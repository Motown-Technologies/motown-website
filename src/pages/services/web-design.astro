---
import { Image } from "astro:assets";
import processImage from "../../img/web-design-process-with-wireframes-and-mockups-on-.jpg";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Faq from "../../components/Faq.astro";

const services = [
    {
        title: "Responsive Design",
        desc: "Websites that work on every screen, from phone to desktop",
        iconPath:
            "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
        bullets: [
            "Mobile-first approach",
            "Cross-browser compatibility",
            "Fluid layouts & grids",
            "Touch-optimized interfaces",
        ],
        link: { href: "/responsive-web-design", label: "Responsive web design" },
    },
    {
        title: "UI/UX Design",
        desc: "Interfaces designed around research with your users",
        iconPath:
            "M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01",
        bullets: [
            "User research & personas",
            "Wireframing & prototyping",
            "Usability testing",
            "Accessibility standards",
        ],
        link: { href: "/ui-ux-design-services", label: "UI/UX design" },
    },
    {
        title: "E-commerce Design",
        desc: "Online stores designed to turn visits into orders",
        iconPath:
            "M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z",
        bullets: [
            "Product catalog design",
            "Shopping cart optimization",
            "Checkout flow design",
            "Payment integration",
        ],
        link: { href: "/ecommerce-development", label: "Ecommerce development" },
    },
    {
        title: "Landing Pages",
        desc: "Single pages built to turn paid traffic into leads",
        iconPath: "M13 10V3L4 14h7v7l9-11h-7z",
        bullets: [
            "Compelling headlines & copy",
            "Clear call-to-actions",
            "Lead capture forms",
            "Clear user paths",
        ],
        link: { href: "/landing-page-design", label: "Landing page design" },
    },
    {
        title: "Website Redesign",
        desc: "A new design and better UX for the site you already have",
        iconPath:
            "M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15",
        bullets: [
            "Site audit & analysis",
            "Modern design trends",
            "Performance optimization",
            "SEO improvements",
        ],
        link: { href: "/website-redesign", label: "Website redesign" },
    },
];

const situations = [
    {
        t: "A redesign that can't lose its rankings",
        d: "Most redesigns that lose traffic skipped the URL map. We list every indexed page, give each one a 301 redirect to its replacement, and compare rankings against a recorded baseline after launch.",
    },
    {
        t: "WordPress has become a job of its own",
        d: "Plugin updates nobody dares run and mobile pages that load slowly. We rebuild the site as pre-built static pages, carry over every post and URL, and keep an editor your team already knows.",
    },
    {
        t: "It works on a laptop and fails on a phone",
        d: "Tap targets that need a second attempt and tables that push the page sideways. We build from the narrowest screen outward and test on real phones over mobile networks.",
    },
    {
        t: "Paid traffic lands on a page that does four things",
        d: "A landing page has one job. We build it around a single offer, with the proof placed where visitors start to doubt it.",
    },
    {
        t: "Nobody watches the site after launch",
        d: "Sites usually break months later, when an update stops the contact form and nobody notices. We patch on a schedule, test on staging first and monitor the pages that bring in enquiries.",
    },
];

const related = [
    {
        href: "/case-studies/endoscopy-center",
        label: "Endoscopy center",
        d: "A WordPress site rebuilt as static pages, with WordPress kept as the editor staff already use.",
    },
    {
        href: "/case-studies/healthcare-practice",
        label: "Multi-site healthcare practice",
        d: "An inherited React app and a Django admin turned into a static site with a real CMS.",
    },
    {
        href: "/blog/when-to-leave-wordpress",
        label: "When it's time to leave WordPress",
        d: "The signs that upkeep has taken over, and when staying put is fine.",
    },
    {
        href: "/blog/headless-wordpress-clinic",
        label: "Staff still edit WordPress. Patients never load it.",
        d: "How publishing works on the endoscopy center's rebuilt site, and why it stays up.",
    },
    {
        href: "/blog/shopify-custom-or-headless",
        label: "Shopify, a custom theme or headless",
        d: "How we help stores choose, and when headless is the wrong call.",
    },
];

const faqs = [
    {
        q: "How long does it take to build a website?",
        a: "A simple website might take 2 to 4 weeks, and a complex web application 3 to 6 months. The difference comes from how many page types, integrations and content migrations are involved. We give you a timeline for your project after the first conversation, once we know what the site has to do.",
    },
    {
        q: "Will a redesign hurt our search rankings?",
        a: "It can, and the usual cause is old URLs that nobody mapped. Before cutover we list every indexed page, point each one at its replacement with a 301 redirect and record a baseline. After launch we track rankings, errors and conversions against that baseline daily through the weeks when problems tend to surface.",
    },
    {
        q: "Can our team keep editing in WordPress if you rebuild the site?",
        a: "Yes. We can keep WordPress as the back office your editors already use and build the public site from it as static pages, so visitors never reach WordPress or its database. When an editor hits publish, the site rebuilds itself. If you would rather leave WordPress completely, we can move you to a newer CMS instead.",
    },
    {
        q: "Should our store use Shopify, a custom theme or a headless build?",
        a: "Most stores do well on Shopify with a custom theme, which ships sooner and is easier for a small team to run. Headless earns its complexity when the platform is the limit, for example when the theme can't render the brand or you run a separate store per market. We would talk a two-person team with a tight deadline out of it.",
    },
    {
        q: "Will the site work properly on phones?",
        a: "We design from the narrowest screen outward, size controls for thumbs and keep the main actions within reach on a large phone. Phones get correctly sized images in modern formats, and tables reflow or scroll in their own frame. Before launch we test on actual phones over mobile connections.",
    },
    {
        q: "Do you look after the site after launch?",
        a: "Yes. Maintenance covers security patches tested on staging first, monitoring on the pages that bring in enquiries, backups we verify by restoring them, and the small content changes that otherwise wait for months. Each month you get a short note on what was patched, what broke, what was fixed and what needs a decision.",
    },
];

const process = [
    {
        t: "Research & Strategy",
        d: "We study your brand, competitors, and audience before designing anything",
    },
    {
        t: "Wireframing & Prototyping",
        d: "We create wireframes and interactive prototypes to visualize the user experience",
    },
    {
        t: "Visual Design",
        d: "We design on-brand visuals for every page",
    },
    {
        t: "Development & Launch",
        d: "We build the site and test it thoroughly before launch",
    },
];
---

<BaseLayout
    meta_title="Web Design & Development Services | Motown Solutions"
    meta_description="Web design and development: responsive websites, UI/UX design, ecommerce stores, landing pages, and website redesigns built to convert."
>
    <!-- Hero -->
    <section class="relative border-b-2 border-ink overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-10">
                    <h1
                        class="font-display font-bold text-display text-ink text-balance"
                    >
                        Web design and development that <span class="italic text-accent">converts</span>.
                    </h1>
                </div>
                <div class="col-span-12 lg:col-span-7 lg:col-start-4 mt-10 md:mt-16">
                    <p
                        class="text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        We design and build websites that are easy to use and built to turn visitors into customers, from the first concept through launch.
                    </p>
                    <div class="mt-10 flex flex-wrap gap-3" data-reveal>
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-ink text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-paper hover:text-ink transition-colors"
                        >
                            Start Your Project
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#services"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            View Services
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services grid -->
    <section id="services" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        What We Design
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:col-start-8 md:self-end"
                >
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Landing pages, full sites, online stores, and redesigns
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    services.map((svc) => (
                        <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                            <div class="flex items-center gap-4 mb-6">
                                <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                    <svg
                                        class="w-5 h-5"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d={svc.iconPath}
                                        />
                                    </svg>
                                </span>
                            </div>
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                {svc.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed mb-5">
                                {svc.desc}
                            </p>
                            <ul class="space-y-2 text-sm">
                                {svc.bullets.map((b) => (
                                    <li class="flex items-start gap-3">
                                        <span
                                            aria-hidden
                                            class="font-mono mt-[2px]"
                                        >
                                            →
                                        </span>
                                        <span>{b}</span>
                                    </li>
                                ))}
                            </ul>
                            {svc.link && (
                                <a
                                    href={svc.link.href}
                                    class="link-underline inline-block mt-6 font-mono text-xs uppercase tracking-[0.15em]"
                                    >{svc.link.label}&nbsp;→</a
                                >
                            )}
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- When to call us -->
    <section class="border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-7">
                    <h2 class="font-display font-bold text-h2 tracking-tight text-balance">
                        What usually brings people to us.
                    </h2>
                </div>
            </div>
            <div class="border-t border-ink">
                {
                    situations.map((s) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-start py-8 px-1 border-b border-ink">
                            <h3 class="col-span-12 md:col-span-5 font-display text-xl md:text-2xl font-bold tracking-tight leading-tight">
                                {s.t}
                            </h3>
                            <p class="col-span-12 md:col-span-7 md:pl-4 text-ink-muted leading-relaxed">
                                {s.d}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Design Process -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Our Design Process
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:col-start-8 md:self-end"
                >
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Four stages take the site from research to launch, with your business goals guiding each one.
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-12 gap-6 md:gap-10">
                <div class="col-span-12 md:col-span-5">
                    <div class="border border-ink aspect-[4/3] overflow-hidden">
                        <Image
                            src={processImage}
                            alt="Website wireframes and mockups from the design process"
                            class="w-full h-full object-cover"
                            loading="lazy"
                        />
                    </div>
                </div>
                <div class="col-span-12 md:col-span-7">
                    <div class="border-t border-ink">
                        {
                            process.map((step) => (
                                <div class="grid grid-cols-12 gap-4 md:gap-8 items-start py-8 px-1 border-b border-ink">
                                    <h3 class="col-span-12 md:col-span-5 font-display text-xl md:text-2xl font-bold tracking-tight leading-tight">
                                        {step.t}
                                    </h3>
                                    <p class="col-span-12 md:col-span-7 md:pl-4 text-ink-muted leading-relaxed text-sm md:text-base">
                                        {step.d}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Related work -->
    <section class="border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-7">
                    <h2 class="font-display font-bold text-h2 tracking-tight text-balance">
                        Case studies and posts.
                    </h2>
                </div>
            </div>
            <ul class="border-t border-ink">
                {
                    related.map((item) => (
                        <li class="border-b border-ink">
                            <a href={item.href} class="group grid grid-cols-12 gap-4 md:gap-8 items-start py-6 px-1">
                                <span class="col-span-12 md:col-span-5 font-display text-xl md:text-2xl font-bold tracking-tight leading-tight group-hover:text-accent transition-colors">
                                    {item.label}
                                </span>
                                <span class="col-span-12 md:col-span-7 md:pl-4 text-ink-muted leading-relaxed">
                                    {item.d}
                                </span>
                            </a>
                        </li>
                    ))
                }
            </ul>
        </div>
    </section>

    <Faq items={faqs} heading="Questions about web projects." />

    <!-- Final CTA -->
    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div
            class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start"
        >
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Let's talk about your <span class="italic text-accent">site</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Tell us what your site needs to do for your business.
            </p>
            <div class="flex flex-wrap gap-3">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-paper text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-ink hover:text-paper transition-colors"
                >
                    Get Started
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/services"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    View All Services
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
