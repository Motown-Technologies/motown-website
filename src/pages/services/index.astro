---
import services, { type Service } from "../../data/services";
import BaseLayout from "../../layouts/BaseLayout.astro";

const toSlug = (s: string) =>
    s
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)/g, "");
---

<BaseLayout
    meta_title="Custom Software, AI & Automation Services | Motown Solutions"
    meta_description="Motown Solutions services: custom software, AI development, web design, mobile apps, automation, and IT consulting, plus specialist work by problem."
>
    <!-- Hero -->
    <section class="relative border-b-2 border-ink overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-10">
                    <h1
                        class="font-display font-bold text-display text-ink text-balance"
                    >
                        Software, AI, web,
                        <br />
                        and <span class="italic text-accent">automation</span>.
                    </h1>
                </div>
                <div class="col-span-12 lg:col-span-7 lg:col-start-4 mt-10 md:mt-16">
                    <p
                        class="text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        We build software, websites, mobile apps, and automation, and we advise on the strategy behind them.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Services showroom with inline bullets -->
    <section class="py-16 md:py-20" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="border-t border-ink/30">
                {
                    services.map((svc: Service) => {
                        const href =
                            svc.href ?? "/services/" + toSlug(svc.title);
                        return (
                            <a
                                href={href}
                                class="group block relative border-b border-ink/30 hover:border-ink transition-colors"
                            >
                                <span
                                    aria-hidden
                                    data-sweep
                                    class="pointer-events-none absolute inset-0 bg-ink origin-left scale-x-0 group-hover:scale-x-100 group-active:scale-x-100 transition-transform duration-[400ms] ease-sweep group-active:duration-[120ms]"
                                />
                                <div class="relative grid grid-cols-12 gap-4 md:gap-8 py-10 md:py-12 px-4 md:px-6 transition-colors duration-[400ms] ease-sweep group-hover:text-paper">
                                    <div class="col-span-12 md:col-span-6">
                                        <h3 class="font-display text-3xl md:text-5xl font-bold tracking-tight leading-[1] mb-5">
                                            {svc.title}
                                        </h3>
                                        <p class="text-ink-muted transition-colors duration-[400ms] ease-sweep group-hover:text-paper/80 leading-relaxed max-w-lg">
                                            {svc.description}
                                        </p>
                                    </div>

                                    <div class="col-span-12 md:col-span-5 md:pl-4">
                                        <div class="font-mono text-[11px] md:text-xs uppercase tracking-eyebrow text-ink-muted transition-colors duration-[400ms] ease-sweep group-hover:text-paper/60 mb-4">
                                            What we offer
                                        </div>
                                        <ul class="space-y-2">
                                            {svc.bullets.map((b) => (
                                                <li class="flex items-start gap-3 text-sm md:text-base leading-relaxed">
                                                    <span
                                                        aria-hidden
                                                        class="font-mono mt-[2px]"
                                                    >
                                                        →
                                                    </span>
                                                    <span>{b}</span>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>

                                    <div class="col-span-12 md:col-span-1 md:text-right md:self-start md:mt-1">
                                        <span
                                            aria-hidden
                                            class="inline-block font-mono text-xl md:text-2xl transition-transform group-hover:translate-x-1"
                                        >
                                            →
                                        </span>
                                    </div>
                                </div>
                            </a>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Specialist work -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Deeper on
                        <br />
                        specific work.
                    </h2>
                <p class="mt-5 max-w-2xl text-ink-muted text-lg leading-relaxed">
                    The services above cover how we work. These go into detail on
                    a particular problem, which helps if you already know what you need.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink bg-paper">
                {
                    [
                        {
                            group: "Startup & Product",
                            items: [
                                ["/startup-consulting", "Startup Consulting"],
                                ["/mvp-development", "MVP Development"],
                                ["/fractional-cto", "Fractional CTO"],
                                [
                                    "/technical-due-diligence",
                                    "Technical Due Diligence",
                                ],
                                [
                                    "/prototype-to-production",
                                    "Prototype to Production",
                                ],
                                ["/spreadsheet-to-app", "Spreadsheet to App"],
                                [
                                    "/dedicated-development-team",
                                    "Dedicated Teams",
                                ],
                            ],
                        },
                        {
                            group: "Ecommerce",
                            items: [
                                [
                                    "/ecommerce-development",
                                    "Ecommerce Development",
                                ],
                                ["/shopify-development", "Shopify Development"],
                                [
                                    "/headless-commerce-development",
                                    "Headless Commerce",
                                ],
                            ],
                        },
                        {
                            group: "AI",
                            items: [
                                [
                                    "/custom-ai-model-development",
                                    "Custom AI Models",
                                ],
                                ["/llm-fine-tuning", "LLM Fine-Tuning"],
                                ["/rag-development", "RAG Development"],
                                ["/ai-agent-development", "AI Agents"],
                                [
                                    "/ai-integration-services",
                                    "AI Integrations",
                                ],
                                ["/mlops-services", "MLOps & Guardrails"],
                            ],
                        },
                        {
                            group: "Software & Platform",
                            items: [
                                [
                                    "/web-application-development",
                                    "Web Application Development",
                                ],
                                [
                                    "/enterprise-software-development",
                                    "Enterprise Software",
                                ],
                                ["/api-development", "API Development"],
                                [
                                    "/cloud-application-development",
                                    "Cloud Application Development",
                                ],
                                ["/cloud-migration-services", "Cloud Migration"],
                                [
                                    "/mobile-backend-development",
                                    "Mobile Backend",
                                ],
                                ["/database-design", "Database Design"],
                                [
                                    "/data-warehouse-development",
                                    "Data Warehouse & BI",
                                ],
                            ],
                        },
                        {
                            group: "Web & Design",
                            items: [
                                [
                                    "/responsive-web-design",
                                    "Responsive Web Design",
                                ],
                                ["/ui-ux-design-services", "UI/UX Design"],
                                ["/landing-page-design", "Landing Pages"],
                                ["/website-redesign", "Website Redesign"],
                                ["/migrate-from-wordpress", "WordPress Migration"],
                                ["/website-maintenance", "Website Maintenance"],
                            ],
                        },
                        {
                            group: "Mobile",
                            items: [
                                [
                                    "/cross-platform-app-development",
                                    "Cross-Platform Apps",
                                ],
                                [
                                    "/app-maintenance-and-support",
                                    "App Maintenance",
                                ],
                            ],
                        },
                        {
                            group: "Automation",
                            items: [
                                [
                                    "/business-process-automation",
                                    "Business Process Automation",
                                ],
                                ["/marketing-automation", "Marketing Automation"],
                                [
                                    "/data-integration-services",
                                    "Data Integration",
                                ],
                                ["/rpa-development", "RPA Development"],
                                ["/workflow-automation", "Workflow Automation"],
                                ["/freight-edi-integration", "Freight EDI"],
                            ],
                        },
                        {
                            group: "Advisory",
                            items: [
                                ["/it-strategy-consulting", "IT Strategy"],
                                [
                                    "/software-selection-consulting",
                                    "Software Selection",
                                ],
                                [
                                    "/process-optimization-consulting",
                                    "Process Optimisation",
                                ],
                                [
                                    "/legacy-system-modernization",
                                    "Legacy Modernisation",
                                ],
                                ["/soc-2-readiness", "SOC 2 Readiness"],
                            ],
                        },
                        {
                            group: "Industries",
                            items: [
                                [
                                    "/healthcare-software-development",
                                    "Healthcare Software",
                                ],
                                [
                                    "/logistics-software-development",
                                    "Logistics Software",
                                ],
                            ],
                        },
                    ].map((col) => (
                        <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                            <div class="font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted mb-6">
                                {col.group}
                            </div>
                            <ul class="space-y-3">
                                {col.items.map(([href, label]) => (
                                    <li>
                                        <a
                                            href={href}
                                            class="link-underline font-display text-lg font-bold leading-tight"
                                        >
                                            {label}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div
            class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start"
        >
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Not sure where to <span class="italic text-accent">start</span>?
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Tell us what you're working on, and we'll tell you how we can help.
            </p>
            <div class="flex flex-wrap gap-3">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-paper text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-ink hover:text-paper transition-colors"
                >
                    Get Started
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    Back to Home
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
