---
import BaseLayout from "../../layouts/BaseLayout.astro";

import { Image } from "astro:assets";

import processImage from "../../img/business-automation-dashboard-with-analytics-and-w.jpg";

const solutions = [
    {
        title: "Business Process Automation",
        desc: "Automate the approvals, documents, and data entry your team handles by hand",
        iconPath:
            "M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4",
        bullets: [
            "Document processing & routing",
            "Approval workflows",
            "Data entry automation",
            "Report generation",
        ],
        link: { href: "/business-process-automation", label: "Business process automation" },
    },
    {
        title: "Marketing Automation",
        desc: "Email and nurture campaigns that respond to what each customer does",
        iconPath:
            "M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z",
        bullets: [
            "Email campaign automation",
            "Lead nurturing workflows",
            "Social media scheduling",
            "Customer segmentation",
        ],
        link: { href: "/marketing-automation", label: "Marketing automation" },
    },
    {
        title: "Data Integration",
        desc: "Connect your systems so data moves between them without re-keying",
        iconPath:
            "M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4",
        bullets: [
            "API integrations",
            "Real-time data sync",
            "ETL pipelines",
            "Database automation",
        ],
        link: { href: "/data-integration-services", label: "Data integration services" },
    },
    {
        title: "RPA Solutions",
        desc: "Deploy software robots to handle repetitive, rule-based tasks",
        iconPath:
            "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
        bullets: [
            "Screen scraping & data extraction",
            "Invoice processing",
            "Form filling automation",
            "Legacy system automation",
        ],
        link: { href: "/rpa-development", label: "RPA development" },
    },
    {
        title: "AI-Powered Automation",
        desc: "AI that reads documents, answers questions, and handles routine decisions",
        iconPath:
            "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z",
        bullets: [
            "Natural language processing",
            "Predictive analytics",
            "Chatbots & virtual assistants",
            "Intelligent document processing",
        ],
        link: { href: "/ai-agent-development", label: "AI agent development" },
    },
    {
        title: "Custom Automation",
        desc: "Workflows built around how your business actually runs",
        iconPath:
            "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z",
        bullets: [
            "Custom workflow design",
            "Industry-specific solutions",
            "Integration with existing systems",
            "Scalable architecture",
        ],
        link: { href: "/workflow-automation", label: "Custom workflow automation" },
    },
];

const benefits = [
    {
        title: "Increase Efficiency",
        desc: "Less manual work and shorter processing times",
    },
    {
        title: "Reduce Errors",
        desc: "Automated steps run the same way every time",
    },
    {
        title: "Save Hours Per Week",
        desc: "Your team spends its time on work that needs a person",
    },
    {
        title: "Return On Investment",
        desc: "Savings you can measure against what the automation cost",
    },
];

const process = [
    {
        t: "Discovery",
        d: "We analyze your processes to identify automation opportunities",
    },
    {
        t: "Design",
        d: "Create detailed automation workflows and integration plans",
    },
    {
        t: "Implement",
        d: "Build and test automation solutions with your team",
    },
    {
        t: "Optimize",
        d: "Monitor performance and continuously improve automation",
    },
];
---

<BaseLayout
    meta_title="Business Automation Services | Motown Solutions"
    meta_description="Business automation services: workflow and process automation, RPA, data integration, marketing automation, and AI-assisted document processing."
>
    <!-- Hero -->
    <section class="relative border-b-2 border-ink overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-10">
                    <h1
                        class="font-display font-bold text-hero text-ink text-balance"
                    >
                        Business automation for the work done by <span class="italic text-accent">hand</span>.
                    </h1>
                </div>
                <div class="col-span-12 lg:col-span-7 lg:col-start-4 mt-10 md:mt-16">
                    <p
                        class="text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        We automate the repetitive work in your operations, which cuts errors and gives your team its time back.
                    </p>
                    <div class="mt-10 flex flex-wrap gap-3" data-reveal>
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-ink text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-paper hover:text-ink transition-colors"
                        >
                            Automate Your Workflow
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#solutions"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            View Solutions
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Solutions -->
    <section id="solutions" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Automation Solutions
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:col-start-8 md:self-end"
                >
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Single-task automations, multi-step workflows, and everything in between
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    solutions.map((sol) => (
                        <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                            <div class="flex items-center gap-4 mb-6">
                                <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                    <svg
                                        class="w-5 h-5"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d={sol.iconPath}
                                        />
                                    </svg>
                                </span>
                            </div>
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                {sol.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed mb-5">
                                {sol.desc}
                            </p>
                            <ul class="space-y-2 text-sm">
                                {sol.bullets.map((b) => (
                                    <li class="flex items-start gap-3">
                                        <span
                                            aria-hidden
                                            class="font-mono mt-[2px]"
                                        >
                                            →
                                        </span>
                                        <span>{b}</span>
                                    </li>
                                ))}
                            </ul>
                                {sol.link && (
                                    <a
                                        href={sol.link.href}
                                        class="link-underline inline-block mt-6 font-mono text-xs uppercase tracking-[0.15em]"
                                        >{sol.link.label}&nbsp;→</a
                                    >
                                )}
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Benefits -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Why Automate with Motown Solutions?
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:col-start-8 md:self-end"
                >
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        The results show up as fewer manual hours and fewer errors.
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-12 gap-6 md:gap-10">
                <div class="col-span-12 md:col-span-5">
                    <div class="border border-ink aspect-[4/3] overflow-hidden">
                        <Image
                            src={processImage}
                            alt="Business automation dashboard showing workflow analytics"
                            class="w-full h-full object-cover"
                        />
                    </div>
                </div>
                <div class="col-span-12 md:col-span-7">
                    <div class="border-t border-ink">
                        {
                            benefits.map((b) => (
                                <div class="grid grid-cols-12 gap-4 md:gap-8 items-start py-8 px-1 border-b border-ink">
                                    <h3 class="col-span-12 md:col-span-5 font-display text-xl md:text-2xl font-bold tracking-tight leading-snug">
                                        {b.title}
                                    </h3>
                                    <p class="col-span-12 md:col-span-7 md:pl-4 text-ink-muted leading-relaxed max-w-prose text-sm md:text-base">
                                        {b.desc}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Process -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Our Automation Process
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:col-start-8 md:self-end"
                >
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Four stages, from finding the right processes to improving them after launch
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 border border-ink"
            >
                {
                    process.map((step) => (
                        <div class="p-8 md:p-10 border-ink border-b lg:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 md:[&:nth-child(odd)]:border-r lg:border-r lg:[&:nth-child(odd)]:border-r lg:last:border-r-0">
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-4">
                                {step.t}
                            </h3>
                            <p class="text-ink-muted leading-relaxed">
                                {step.d}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Final CTA -->
    <section
        id="contact"
        class="section-ink border-t-2 border-ink"
        data-reveal
    >
        <div
            class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start"
        >
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Find the work worth <span class="italic text-accent">automating</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Tell us which tasks eat up your team's week, and we'll show you what can be automated. The first consultation is free.
            </p>
            <div class="flex flex-wrap gap-3">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-paper text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-ink hover:text-paper transition-colors"
                >
                    Get Started
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    View All Services
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
