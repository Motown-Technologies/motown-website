---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NumberedRow from "../../components/NumberedRow.astro";
import Faq from "../../components/Faq.astro";

import { Image } from "astro:assets";
import processImg from "../../img/mobile-app-development-team-working-on-app-design-.jpg";

const capabilities = [
    {
        title: "Cross-Platform",
        desc: "One codebase for iOS and Android, built with React Native or Flutter",
        iconPath:
            "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z",
        bullets: [
            "React Native & Flutter",
            "Shared codebase",
            "Native performance",
            "Faster time to market",
        ],
        link: { href: "/cross-platform-app-development", label: "Cross-platform app development" },
    },
    {
        title: "Backend Integration",
        desc: "The APIs, sync, and notifications behind your app",
        iconPath:
            "M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01",
        bullets: [
            "RESTful & GraphQL APIs",
            "Real-time data sync",
            "Push notifications",
            "Cloud storage integration",
        ],
        link: { href: "/mobile-backend-development", label: "Mobile backend development" },
    },
    {
        title: "App Maintenance",
        desc: "Ongoing support to keep your app running smoothly",
        iconPath:
            "M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z",
        bullets: [
            "Bug fixes & updates",
            "OS compatibility updates",
            "Performance monitoring",
            "Feature enhancements",
        ],
        link: { href: "/app-maintenance-and-support", label: "App maintenance & support" },
    },
];

const situations = [
    {
        h: "The app has to run on iOS and Android",
        d: "We build one codebase in React Native or Flutter, picked on your team's existing skills and what the app needs. Business rules, state and networking are written once.",
    },
    {
        h: "Users keep getting logged out or uploads fail",
        d: "These problems usually live in the backend. We refresh sign-in tokens in the background and make uploads resumable, so a dropped connection doesn't cost anyone a photo.",
    },
    {
        h: "The app has to work without a signal",
        d: "We give the app a local store it trusts, a queue for changes made offline and a sync strategy that decides what happens when two devices edit the same record.",
    },
    {
        h: "Launch is close and store review is a worry",
        d: "We check the App Store and Google Play review guidelines during the build, including the rules that most often cause rejections, so they don't come up in launch week.",
    },
    {
        h: "Nobody has touched the app since it shipped",
        d: "We test against new OS versions, patch dependencies and work through crash reports. Tell us what's live and we'll audit it before quoting to take it on.",
    },
];

const related = [
    {
        title: "Cross-Platform Apps",
        description: "One codebase in React Native or Flutter, native modules where the framework can't reach, store submission and over-the-air updates.",
        href: "/cross-platform-app-development",
    },
    {
        title: "Mobile Backends",
        description: "Sign-in, sync, push notifications, media uploads and offline support for apps on real phone networks.",
        href: "/mobile-backend-development",
    },
    {
        title: "App Maintenance",
        description: "OS testing, security patches, crash triage and store compliance for apps that are already live.",
        href: "/app-maintenance-and-support",
    },
    {
        title: "Native App or Web?",
        description: "From our post on scoping an MVP: when a first version needs a native app and when the web version is enough.",
        href: "/blog/mvp-what-to-build-first",
    },
];

const faqs = [
    {
        q: "Do we need separate apps for iOS and Android?",
        a: "Usually not. We build one codebase in React Native or Flutter and choose between them based on your team's existing skills and what the app needs. Business rules, state and networking are written once, and that is most of the code. Anything the framework can't reach, such as some hardware, background work or a native-only SDK, gets a small native module.",
    },
    {
        q: "Do we need a native app at all?",
        a: "Not always. For a first version we build responsive web by default. A native app makes sense when the product really needs the camera, push notifications or a place in the app store. When it does, we build it cross-platform so one team maintains one codebase.",
    },
    {
        q: "Will you handle the App Store and Google Play submission?",
        a: "Yes. We check the store review guidelines while we build, including the rules that most often cause rejections, so they don't surface in launch week. After launch, small fixes can go out as over-the-air updates where the platform rules allow it, so a typo doesn't have to wait for a full store review.",
    },
    {
        q: "Can you build the backend for our app too?",
        a: "Yes. We build backends that expect a phone on a weak connection: sign-in with Apple and Google, token refresh that keeps people signed in, push notifications through APNs and FCM, resumable photo uploads served from a CDN, and versioned APIs so older app versions keep working while they are still on people's phones.",
    },
    {
        q: "Can the app work without a connection?",
        a: "Yes, if we plan for it from the start. The app keeps a local store it trusts and a queue of changes made offline, and a sync strategy decides what happens when the same record changes on two devices. Without that, an app loses data the moment someone walks into a tunnel or a lift.",
    },
    {
        q: "What happens after the app launches?",
        a: "We can keep maintaining it. That means testing against operating system betas before they ship, updating dependencies on a schedule, working through crash reports by frequency and impact, and applying app store policy changes before their deadlines. If someone else built your app, tell us what's live and when it was last updated, and we'll audit it and quote for taking it on.",
    },
];

const process = [
    {
        h: "Strategy & Planning",
        d: "We define your app's goals, features, and technical requirements",
    },
    {
        h: "Design & Prototype",
        d: "We design the screens and build clickable prototypes",
    },
    {
        h: "Development & Testing",
        d: "We build the app and test it on real devices",
    },
    {
        h: "Launch & Support",
        d: "We handle app store submission and provide ongoing support",
    },
];
---

<BaseLayout
    meta_title="Mobile App Development | Motown Solutions"
    meta_description="Mobile app development for iOS and Android: cross-platform apps in React Native and Flutter, mobile backends, and ongoing app maintenance."
>
    <!-- Hero -->
    <section class="relative border-b-2 border-ink overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-10">
                    <h1
                        class="font-display font-bold text-display text-ink text-balance"
                    >
                        iOS and Android apps,
                        <br />
                        built <span class="italic text-accent">once</span>
                    </h1>
                </div>
                <div class="col-span-12 lg:col-span-7 lg:col-start-4 mt-10 md:mt-16">
                    <p
                        class="text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        We build cross-platform apps for iOS and Android, along with the backends that run them and the upkeep after launch.
                    </p>
                    <div class="mt-10 flex flex-wrap gap-3" data-reveal>
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-ink text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-paper hover:text-ink transition-colors"
                        >
                            Start Your App
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#capabilities"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            View Capabilities
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Capabilities -->
    <section id="capabilities" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        What We Build
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:col-start-8 md:self-end"
                >
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        We build consumer and enterprise apps, plus the systems behind them
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    capabilities.map((cap) => (
                        <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                            <div class="flex items-center gap-4 mb-6">
                                <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                    <svg
                                        class="w-5 h-5"
                                        viewBox="0 0 24 24"
                                        fill="none"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d={cap.iconPath}
                                        />
                                    </svg>
                                </span>
                            </div>
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                {cap.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed mb-5">
                                {cap.desc}
                            </p>
                            <ul class="space-y-2 text-sm">
                                {cap.bullets.map((b) => (
                                    <li class="flex items-start gap-3">
                                        <span
                                            aria-hidden
                                            class="font-mono mt-[2px]"
                                        >
                                            →
                                        </span>
                                        <span>{b}</span>
                                    </li>
                                ))}
                            </ul>
                                {cap.link && (
                                    <a
                                        href={cap.link.href}
                                        class="link-underline inline-block mt-6 font-mono text-xs uppercase tracking-[0.15em]"
                                        >{cap.link.label}&nbsp;→</a
                                    >
                                )}
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- When to call us -->
    <section class="border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Where most mobile projects start
                    </h2>
                </div>
            </div>

            <div class="border-t border-ink">
                {
                    situations.map((s) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-start py-8 px-1 border-b border-ink">
                            <h3 class="col-span-12 md:col-span-5 font-display text-xl md:text-2xl font-bold tracking-tight leading-snug">
                                {s.h}
                            </h3>
                            <p class="col-span-12 md:col-span-7 md:pl-4 text-ink-muted leading-relaxed max-w-prose text-sm md:text-base">
                                {s.d}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Process -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Our Development Process
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:col-start-8 md:self-end"
                >
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        We work in short iterations and test on real devices throughout.
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-12 gap-6 md:gap-10">
                <div class="col-span-12 md:col-span-5">
                    <div class="border border-ink aspect-[4/3] overflow-hidden">
                        <Image
                            src={processImg}
                            alt="Mobile app team reviewing app designs"
                            class="w-full h-full object-cover"
                            loading="lazy"
                        />
                    </div>
                </div>
                <div class="col-span-12 md:col-span-7">
                    <div class="border-t border-ink">
                        {
                            process.map((s) => (
                                <div class="grid grid-cols-12 gap-4 md:gap-8 items-start py-8 px-1 border-b border-ink">
                                    <h3 class="col-span-12 md:col-span-5 font-display text-xl md:text-2xl font-bold tracking-tight leading-snug">
                                        {s.h}
                                    </h3>
                                    <p class="col-span-12 md:col-span-7 md:pl-4 text-ink-muted leading-relaxed max-w-prose text-sm md:text-base">
                                        {s.d}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Related work -->
    <section class="border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        More on mobile
                    </h2>
                </div>
            </div>

            <div>
                {
                    related.map((r) => (
                        <NumberedRow
                            title={r.title}
                            description={r.description}
                            href={r.href}
                        />
                    ))
                }
            </div>
        </div>
    </section>

    <Faq items={faqs} heading="Questions about mobile apps." />

    <!-- Final CTA -->
    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div
            class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start"
        >
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Have an <span class="italic text-accent">app</span> in mind?
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Tell us what it needs to do and which devices matter. We'll come back with the framework choice, what has to be native and a realistic timeline.
            </p>
            <div class="flex flex-wrap gap-3">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-paper text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-ink hover:text-paper transition-colors"
                >
                    Get Started
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/services"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    View All Services
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
