---
import BaseLayout from "../../layouts/BaseLayout.astro";

import AiIcon from "../../components/icons/AiIcon.astro";
import ApiIcon from "../../components/icons/ApiIcon.astro";
import AutomationIcon from "../../components/icons/AutomationIcon.astro";
import CloudIcon from "../../components/icons/CloudIcon.astro";
import DatabaseIcon from "../../components/icons/DatabaseIcon.astro";
import SoftwareIcon from "../../components/icons/SoftwareIcon.astro";

const capabilities = [
    {
        title: "Custom AI Models",
        desc: "Models built for your domain, whether trained, distilled, or composed from open-source foundations.",
        icon: AiIcon,
        bullets: [
            "Domain-specific model design",
            "Open-weight fine-tunes (Llama, Mistral, Qwen)",
            "Distillation & smaller specialist models",
            "Private deployment on your infrastructure",
        ],
        link: { href: "/custom-ai-model-development", label: "Custom AI model development" },
    },
    {
        title: "LLM Fine-Tuning",
        desc: "Adapt frontier models to your data, tone, and judgment, with rigorous evaluation at every step.",
        icon: SoftwareIcon,
        bullets: [
            "Supervised fine-tuning (SFT) & DPO",
            "Instruction & preference datasets",
            "Eval harness design & regression testing",
            "Cost vs. quality tradeoff analysis",
        ],
        link: { href: "/llm-fine-tuning", label: "LLM fine-tuning" },
    },
    {
        title: "RAG & Retrieval",
        desc: "Wire your AI into the knowledge it actually needs: your documents and your data.",
        icon: DatabaseIcon,
        bullets: [
            "Vector & hybrid search pipelines",
            "Document chunking & embedding strategy",
            "Query rewriting & re-ranking",
            "Citation & grounding for trust",
        ],
        link: { href: "/rag-development", label: "RAG development" },
    },
    {
        title: "AI Agents & Automation",
        desc: "Multi-step agents that draft, decide, and act inside your workflows.",
        icon: AutomationIcon,
        bullets: [
            "Tool-using agents & function calling",
            "Long-horizon task planning",
            "Human-in-the-loop checkpoints",
            "Workflow integration with existing systems",
        ],
        link: { href: "/ai-agent-development", label: "AI agent development" },
    },
    {
        title: "AI Integrations",
        desc: "Bring AI into the products and tools your team already uses, without locking you into one vendor.",
        icon: ApiIcon,
        bullets: [
            "Provider-agnostic abstractions",
            "Streaming, batching, & cost controls",
            "Identity, audit, & access policy",
            "OpenAI, Anthropic, Google, open-source",
        ],
        link: { href: "/ai-integration-services", label: "AI integration services" },
    },
    {
        title: "MLOps & Guardrails",
        desc: "Production AI that is monitored, evaluated, and built with guardrails from the start.",
        icon: CloudIcon,
        bullets: [
            "Online evals & drift detection",
            "Prompt injection & safety guardrails",
            "Cost, latency, & quality dashboards",
            "Versioning, rollback, & A/B testing",
        ],
        link: { href: "/mlops-services", label: "MLOps & guardrails" },
    },
];

const process = [
    {
        t: "Use Case & Feasibility",
        d: "We map the business problem, identify where AI helps versus where it doesn't, and de-risk early with a clear evaluation plan.",
    },
    {
        t: "Data & Eval Setup",
        d: "We assess data readiness, build labeled eval sets, and define the metrics you'll judge the model on before any training begins.",
    },
    {
        t: "Modeling & Iteration",
        d: "Prompt, fine-tune, or train: we pick the simplest approach that meets the bar and iterate against your eval set.",
    },
    {
        t: "Deployment & Monitoring",
        d: "We ship to production with guardrails, observability, and a feedback loop so the system gets better with use.",
    },
];

const techBlocks = [
    {
        title: "Foundation Models",
        items: [
            "OpenAI (GPT, o-series)",
            "Anthropic Claude",
            "Google Gemini",
            "Meta Llama",
            "Mistral",
            "Qwen & DeepSeek",
        ],
    },
    {
        title: "Frameworks & Tooling",
        items: [
            "PyTorch",
            "Hugging Face",
            "LangChain & LlamaIndex",
            "DSPy",
            "vLLM & Ollama",
            "OpenAI Evals",
        ],
    },
    {
        title: "Vector & Data",
        items: [
            "Pinecone",
            "Weaviate",
            "Qdrant",
            "pgvector",
            "Postgres & S3",
            "DuckDB & Parquet",
        ],
    },
    {
        title: "Deployment & Ops",
        items: [
            "AWS Bedrock",
            "Azure OpenAI",
            "Modal & Replicate",
            "RunPod",
            "Hugging Face Inference",
            "Docker & Kubernetes",
        ],
    },
];
---

<BaseLayout
    meta_title="AI Development Services | Motown Solutions"
    meta_description="Custom AI models, LLM fine-tuning, RAG, agents, and production MLOps. We build AI for specific business problems."
>
    <!-- Hero -->
    <section class="relative border-b-2 border-ink overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-10">
                    <h1
                        class="font-display font-bold text-hero text-ink text-balance"
                    >
                        AI development that solves real <span class="italic text-accent">problems</span>.
                    </h1>
                </div>
                <div class="col-span-12 lg:col-span-7 lg:col-start-4 mt-10 md:mt-16">
                    <p
                        class="text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        We design custom AI models, fine-tune frontier LLMs to
                        your data, and build production-grade AI systems for
                        teams that need more than a generic chatbot. That includes private deployments, retrieval systems, and agents.
                    </p>
                    <div class="mt-10 flex flex-wrap gap-3" data-reveal>
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-ink text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-paper hover:text-ink transition-colors"
                        >
                            Start Your Project
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#capabilities"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            View Capabilities
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Capabilities -->
    <section id="capabilities" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        What We Build
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:col-start-8 md:self-end"
                >
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        End-to-end AI systems (model, retrieval, evaluation, and deployment) tuned to your problem and your data.
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    capabilities.map((cap) => {
                        const Icon = cap.icon;
                        return (
                            <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                                <div class="flex items-center gap-4 mb-6">
                                    <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                        <Icon />
                                    </span>
                                </div>
                                <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                    {cap.title}
                                </h3>
                                <p class="text-ink-muted leading-relaxed mb-5">
                                    {cap.desc}
                                </p>
                                <ul class="space-y-2 text-sm">
                                    {cap.bullets.map((b) => (
                                        <li class="flex items-start gap-3">
                                            <span
                                                aria-hidden
                                                class="font-mono mt-[2px]"
                                            >
                                                →
                                            </span>
                                            <span>{b}</span>
                                        </li>
                                    ))}
                                </ul>
                                {cap.link && (
                                    <a
                                        href={cap.link.href}
                                        class="link-underline inline-block mt-6 font-mono text-xs uppercase tracking-[0.15em]"
                                        >{cap.link.label}&nbsp;→</a
                                    >
                                )}
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Process -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Our AI Process
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:col-start-8 md:self-end"
                >
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        We start from your problem rather than the model, and we only ship what we can measure.
                    </p>
                </div>
            </div>

            <div class="border-t border-ink">
                {
                    process.map((step) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-start py-8 px-1 border-b border-ink">
                            <h3 class="col-span-12 md:col-span-5 font-display text-xl md:text-2xl font-bold tracking-tight leading-snug">
                                {step.t}
                            </h3>
                            <p class="col-span-12 md:col-span-7 md:pl-4 text-ink-muted leading-relaxed max-w-prose text-sm md:text-base">
                                {step.d}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Stack -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Models & Tools We Use
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:col-start-8 md:self-end"
                >
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Provider-agnostic by default. We pick the right model for the job, whether proprietary, open, or somewhere in between.
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 border border-ink">
                {
                    techBlocks.map((block) => (
                        <div class="p-8 md:p-10 border-ink border-b md:[&:nth-child(odd)]:border-r md:[&:nth-child(n+3)]:border-b-0 last:border-b-0">
                            <div class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted mb-6">
                                — {block.title}
                            </div>
                            <ul class="grid grid-cols-2 gap-y-2 gap-x-4 text-sm md:text-base">
                                {block.items.map((tech) => (
                                    <li class="flex items-start gap-2">
                                        <span
                                            aria-hidden
                                            class="font-mono mt-[2px]"
                                        >
                                            ·
                                        </span>
                                        <span>{tech}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Final CTA -->
    <section
        id="contact"
        class="section-ink border-t-2 border-ink"
        data-reveal
    >
        <div
            class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start"
        >
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Ready to put AI to <span class="italic text-accent">work</span>?
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Tell us the problem you're trying to solve. We'll tell you
                whether AI is the right tool, and how we'd build it if it is.
            </p>
            <div class="flex flex-wrap gap-3">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-paper text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-ink hover:text-paper transition-colors"
                >
                    Get in Touch
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/services"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    View All Services
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
