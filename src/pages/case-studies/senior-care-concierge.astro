---
import BaseLayout from "../../layouts/BaseLayout.astro";

const outcomes = [
    {
        before: "\"Submitted by\" was a dropdown of six hard-coded names, because the demo had no users",
        after: "Invite-only accounts with two-factor and passkeys; no administrator ever handles a password",
    },
    {
        before: "Everything was visible to everyone, because there was no one to hide it from yet",
        after: "Per-facility isolation enforced beneath every query, so no screen can forget it",
    },
    {
        before: "Facility logins and Wi-Fi keys sat in ordinary fields",
        after: "Encrypted at rest, masked by default, revealed only by an owner or admin, and the reveal is logged",
    },
    {
        before: "No record of who changed what, or when",
        after: "An append-only audit log, with a timeline on every record and on every user",
    },
    {
        before: "Reports were something you read on screen",
        after: "Excel, CSV and PDF exports, saved views, and scheduled delivery straight to a mailbox",
    },
    {
        before: "A working model of the idea, running on a low-code platform",
        after: "An application the operator owns, in their own cloud account, under their own compliance agreement",
    },
];

const pillars = [
    {
        n: "01",
        title: "Reproduce first. Fortify second.",
        body: "The proof of concept had already done the hard thinking: the screens, the data, the way a concierge actually works a call. The specification was written in two halves for that reason: reproduce the workflow the team already knows, faithfully, and then add everything a demo is allowed to skip. Staff who had used the prototype needed no retraining.",
    },
    {
        n: "02",
        title: "PHI shaped the architecture",
        body: "Resident data is protected health information, and that was a decision on day one rather than a hardening pass at the end. It is why facility isolation lives in a global query scope instead of in controllers, why credentials mask themselves unless deliberately revealed, and why the automatic logoff is three coordinated layers rather than a session timeout.",
    },
    {
        n: "03",
        title: "Then it went past the brief",
        body: "An externally-facing facility portal with hard per-facility isolation and shared ticket threads, a rebuilt reporting suite with server-rendered charts and scheduled delivery, and full-screen wallboards for facility lobbies that show aggregate figures only, never a resident's name.",
    },
];

const build = [
    {
        title: "One boundary, failing closed",
        body: "Facility isolation is a single global scope applied to every facility-owned record, and it can only ever narrow a query, never widen one. Internal staff see across the portfolio; a facility user sees exactly their facilities; a facility user linked to nothing matches nothing, rather than everything. Because it only narrows, it is safe to leave on by default, and a job that genuinely needs to cross facilities opts out in the open.",
    },
    {
        title: "Secrets that mask themselves",
        body: "Facility credentials are encrypted at rest and hydrated into an object that redacts itself when printed, logged or serialized to JSON. There is no way to leak one into a response or a log line by accident. Reading it takes an explicit, permission-gated, audited call. Because the safe path is the default, security doesn't depend on everyone remembering.",
    },
    {
        title: "Logging you out without losing your place",
        body: "HIPAA requires termination on inactivity but names no duration. Three layers: a rolling idle timeout, an absolute session cap, and a countdown warning about a minute out. The subtle part is that the browser heartbeats while idle so a graceful sign-out (with an explanation and a validated return link) beats the server session simply expiring underneath you.",
    },
    {
        title: "Charts that survive a queue with no browser",
        body: "Scheduled reports render in a background worker where no browser exists, so a chart drawn by the client could never reach them. The same server-computed series is drawn as SVG on the server and embedded as an image, because the PDF engine drops inline SVG but rasterises SVG images, which in turn keeps the charts to plain shapes.",
    },
    {
        title: "Wallboards that carry nothing worth stealing",
        body: "Lobby screens run on their own revocable, rotatable read-only links, exempt from the idle and absolute timeouts that govern everyone else. That is safe because the surface shows aggregate, de-identified figures and no PHI at all. The security model let a real product requirement through instead of blocking it.",
    },
    {
        title: "Where it lives, decided twice",
        body: "The first decision was one cloud, one compliance agreement. The second moved the database to a provider with self-serve compliance and branching. The third reversed that, on analysis: the compliance tier made the costs a wash, while the split meant two clouds, two agreements and a database outside the network boundary, and branching is a developer convenience the client gets nothing from. Both decisions are still in the repository, including the one that was reversed.",
    },
];

const rigor = [
    {
        risk: "The interface hides a button and everyone assumes that's security",
        undo: "Authorization always happens server-side. Gates and role middleware are the source of truth, and the frontend only shows and hides",
    },
    {
        risk: "An external facility user reaches internal data",
        undo: "Two separate role models. Facility users hold none of the internal abilities, and every internal check tests both",
    },
    {
        risk: "A change breaks something quietly",
        undo: "Every change clears the same gate: tests, static analysis, formatter, type-check, lint, and a production build",
    },
    {
        risk: "Compliance is claimed rather than done",
        undo: "A hardening document that marks each item as client sign-off or ops runbook, and records the known gaps rather than papering over them",
    },
    {
        risk: "Data is destroyed on a schedule nobody agreed to",
        undo: "Purge and retention run on documented rules, and the destructive recycle window ships disabled until the client's privacy officer sets it",
    },
];
---

<BaseLayout
    meta_title="HIPAA Prototype Rebuild Case Study | Motown Solutions"
    meta_description="A senior-care operator's low-code prototype rebuilt as a production app with authentication, per-facility isolation, audit trails, and PHI handled as PHI."
>
    <section class="relative overflow-hidden border-b-2 border-ink">
        <svg
            aria-hidden
            class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.12] text-ink"
            viewBox="0 0 1200 700"
            preserveAspectRatio="xMidYMid slice"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
        >
            <rect x="120" y="120" width="300" height="200" />
            <rect x="160" y="160" width="300" height="200" />
            <rect x="200" y="200" width="300" height="200" />
            <path d="M620 120 V 620" />
            <rect x="700" y="180" width="380" height="120" />
            <rect x="700" y="340" width="380" height="120" />
            <path d="M760 240 h 260 M760 400 h 260" />
            <circle cx="730" cy="240" r="10" />
            <circle cx="730" cy="400" r="10" />
        </svg>

        <div class="relative max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6 lg:items-center">
                <div class="col-span-12 lg:col-span-7">

                    <h1
                        class="font-display font-bold text-hero text-ink text-balance"
                    >
                        A prototype proves
                        <br />
                        the idea. It can't hold
                        <span class="italic text-accent">someone's name</span>.
                    </h1>

                    <p
                        class="mt-10 text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        A multi-facility senior-care operator ran its concierge team (resident and family concerns, admissions, discharges, daily tasks) on a low-code proof of concept. The thinking was right and the workflow was
                        right. What it could not do was carry a real resident's
                        record, because it had no users, no permissions, no
                        audit trail, and nothing standing between one facility's
                        data and another's.
                    </p>

                    <div class="mt-10 flex flex-wrap gap-3">
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-ink transition-colors"
                        >
                            Take a prototype to production
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#outcomes"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            What changed
                        </a>
                    </div>
                </div>

                <div class="col-span-12 lg:col-span-5 mt-12 lg:mt-0">
                    <div
                        class="border-2 border-ink bg-paper-2 lg:translate-y-2"
                        data-reveal
                    >
                        <div
                            class="flex items-center justify-between px-5 py-3 border-b-2 border-ink font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted"
                        >
                            <span>At A Glance</span>
                            <span aria-hidden class="text-accent"
                                >● pre-launch</span
                            >
                        </div>

                        <div class="flex items-end gap-5 px-5 py-6 border-b border-ink/30">
                            <span
                                class="font-display font-bold text-6xl leading-[0.85] tracking-tight"
                                >3</span
                            >
                            <span
                                class="text-sm text-ink-muted leading-snug pb-1"
                                >surfaces: staff app, facility<br />portal, lobby wallboards</span
                            >
                        </div>
                        {
                            [
                                ["Sector", "Senior care — multi-facility"],
                                ["Data", "Resident records, treated as PHI"],
                                ["Isolation", "Per-facility, beneath every query"],
                                ["Stack", "Laravel 13 · Vue 3 · Postgres"],
                                ["Hosting", "HIPAA-compliant cloud"],
                            ].map(([k, v], i, arr) => (
                                <div
                                    class:list={[
                                        "px-5 py-3.5",
                                        i !== arr.length - 1 &&
                                            "border-b border-ink/30",
                                    ]}
                                >
                                    <div class="font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted">
                                        {k}
                                    </div>
                                    <div class="mt-1 font-display font-bold tracking-tight text-lg leading-snug">
                                        {v}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Before / after -->
    <section id="outcomes" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        The same screens.
                        <br />
                        A system underneath them.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        A proof of concept is allowed to skip everything that
                        makes software safe to run a business on. That is what
                        makes it fast, and it is exactly the gap between a
                        convincing demo and a tool a regulated operation can
                        actually adopt.
                    </p>
                </div>
            </div>

            <div class="border-t border-ink">
                <div
                    class="hidden md:grid grid-cols-12 gap-8 py-4 border-b border-ink font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted"
                >
                    <span class="col-span-6">The prototype</span>
                    <span class="col-span-6">The application</span>
                </div>
                {
                    outcomes.map((row) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-center py-7 border-b border-ink">
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3 text-ink-muted">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px]"
                                >
                                    ×
                                </span>
                                <span class="leading-relaxed line-through decoration-ink/30">
                                    {row.before}
                                </span>
                            </div>
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px] text-accent"
                                >
                                    →
                                </span>
                                <span class="font-medium leading-relaxed">
                                    {row.after}
                                </span>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Three pillars -->
    <section class="border-t-2 border-ink bg-paper-2 py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-7">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        How the rebuild
                        <br />
                        was framed.
                    </h2>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 border border-ink bg-paper">
                {
                    pillars.map((p, i, arr) => (
                        <div
                            class:list={[
                                "p-8 md:p-10 border-ink",
                                i !== arr.length - 1 &&
                                    "border-b md:border-b-0 md:border-r",
                            ]}
                        >
                            <div class="font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted mb-6">
                                {p.n}
                            </div>
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-4">
                                {p.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed">
                                {p.body}
                            </p>
                        </div>
                    ))
                }
            </div>

            <blockquote
                class="mt-14 border-l-2 border-accent pl-6 md:pl-8 max-w-3xl"
            >
                <p
                    class="font-display font-bold text-2xl md:text-3xl tracking-tight leading-tight text-balance"
                >
                    One navy edge, a quiet field of data, and red only when
                    someone is waiting.
                </p>
                <p class="mt-4 text-ink-muted leading-relaxed">
                    The design system is one document with one idea in it. Brand
                    colour at full strength on the sidebar and nowhere else; red
                    reserved exclusively for outstanding work, which is what
                    makes red mean something at four o'clock on a busy shift. A
                    second saturated surface was tried and pulled back for
                    competing with the data. The stated anti-reference is the
                    wall-of-grey clinical system everyone in care already
                    dreads.
                </p>
            </blockquote>
        </div>
    </section>

    <!-- Inside the build -->
    <section class="border-t-2 border-ink py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Where the compliance
                        <br />
                        actually lives.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        It lives in the code, at the points where a developer on a deadline would otherwise have to remember. That is the only kind of compliance that survives a busy month.
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    build.map((item) => (
                        <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                {item.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed">
                                {item.body}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Rigor -->
    <section class="border-t-2 border-ink bg-paper-2 py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        We audited it
                        <br />
                        like we hadn't built it.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Handing an operator a system that holds their residents'
                        information is not a moment for optimism. Two sweeps ran
                        against a full working dataset before launch: one asking what is broken, and one asking what was promised and
                        never built.
                    </p>
                </div>
            </div>

            <div class="border-t border-ink">
                <div
                    class="hidden md:grid grid-cols-12 gap-8 py-4 border-b border-ink font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted"
                >
                    <span class="col-span-5">The way it goes wrong</span>
                    <span class="col-span-7">What stops it</span>
                </div>
                {
                    rigor.map((row) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-center py-6 border-b border-ink">
                            <div class="col-span-12 md:col-span-5 text-ink-muted leading-relaxed">
                                {row.risk}
                            </div>
                            <div class="col-span-12 md:col-span-7 flex items-start gap-3">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px] text-accent"
                                >
                                    →
                                </span>
                                <span class="font-medium leading-relaxed">
                                    {row.undo}
                                </span>
                            </div>
                        </div>
                    ))
                }
            </div>

            <div class="grid grid-cols-12 gap-6 mt-14">
                <div class="col-span-12 lg:col-span-6 border-2 border-ink bg-paper p-8 md:p-10">
                    <div
                        class="font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted mb-6"
                    >
                        — What the sweep found
                    </div>
                    <p class="text-ink-muted leading-relaxed mb-4">
                        48 findings, verified against a seeded working set of 33
                        facilities and several thousand tickets rather than by
                        reading code. External facility accounts were appearing
                        in internal staff pickers, which would eventually have routed a resident's name to an account outside the
                        organisation. A report's own default date range took
                        456 seconds and six gigabytes to produce a PDF; after a
                        row cap, 21 seconds and a tenth of the memory.
                    </p>
                    <p class="text-ink-muted leading-relaxed">
                        Eight were fixed the same night, and five of those eight were regressions introduced hours earlier. That is why we audit before launch instead of trusting the last green test run.
                    </p>
                </div>
                <div class="col-span-12 lg:col-span-6 border-2 border-ink bg-paper p-8 md:p-10">
                    <div
                        class="font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted mb-6"
                    >
                        — And two findings we argued with
                    </div>
                    <p class="text-ink-muted leading-relaxed mb-4">
                        Two were rejected as wrong. One proposed fix would have
                        broken a bug fix the client had asked for while securing
                        nothing, because the same payload was already broadcast publicly by design. The real defect was a misleading comment. Three others were fixed more broadly than
                        written, once the same bug turned up in code paths the
                        sweep had missed. Two were deferred deliberately, with
                        the reason recorded in the code.
                    </p>
                    <p class="text-ink-muted leading-relaxed">
                        An audit is only worth something if you are willing to
                        argue with it. A list of findings accepted wholesale is
                        a list nobody read closely.
                    </p>
                </div>
            </div>

            <p class="mt-12 text-ink-muted leading-relaxed max-w-2xl">
                This is
                <a
                    href="/prototype-to-production"
                    class="link-underline font-medium text-ink"
                    >prototype to production</a
                > work in
                <a
                    href="/healthcare-software-development"
                    class="link-underline font-medium text-ink"
                    >healthcare software</a
                >, and the posture behind it is the same one that carries a team
                through
                <a
                    href="/soc-2-readiness"
                    class="link-underline font-medium text-ink"
                    >a compliance review</a
                >.
            </p>
        </div>
    </section>

    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start">
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                The demo was the
                <span class="italic text-accent">easy half</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Send us what you've built and what it has to hold: regulated data, real users, other people's information. We will tell you
                what has to change before it can carry that, what can stay
                exactly as it is, and what the rebuild costs.
            </p>
            <div class="flex flex-wrap gap-3 mb-12">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-paper transition-colors"
                >
                    Take a prototype to production
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/prototype-to-production"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    Prototype to Production
                </a>
            </div>

            <div
                class="w-full border-t border-paper/20 pt-8 flex flex-wrap items-center gap-x-10 gap-y-3 font-mono text-xs uppercase tracking-eyebrow text-paper/60"
            >
                <a
                    href="https://motowntech.com"
                    class="link-underline text-paper">motowntech.com</a
                >
                <a href="tel:+18459252661" class="link-underline text-paper"
                    >845-925-2661</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
