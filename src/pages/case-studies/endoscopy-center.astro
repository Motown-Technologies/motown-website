---
import BaseLayout from "../../layouts/BaseLayout.astro";

const outcomes = [
    {
        before: "A full WordPress site, with PHP, a database and a plugin surface in the path of every patient request",
        after: "Static HTML served from Appwrite Sites on infrastructure we run; WordPress is never in the request path",
    },
    {
        before: "Every edit rendered live through PHP on every visit, and so did every theme and plugin update",
        after: "Pressing publish triggers one static rebuild, and a burst of ten edits produces a single build",
    },
    {
        before: "A slow or unreachable CMS took the public site down with it",
        after: "The pages are already built, so a CMS outage only affects staff",
    },
    {
        before: "Images left over from the old site silently 404'd, and shifted the layout as they loaded",
        after: "Legacy URLs rewritten at build, with dimensions and lazy loading injected into CMS-authored images",
    },
    {
        before: "Meta descriptions written by hand, when they were written at all",
        after: "Derived from the page's own content at build time, so editors get correct tags by doing nothing",
    },
];

const pillars = [
    {
        n: "01",
        title: "The CMS is a build-time dependency",
        body: "Staff keep the editorial surface they already know. WordPress exposes its content over GraphQL, the site fetches all of it while building (pages, providers, procedures, and the navigation menu itself) and ships plain HTML. Patients never touch WordPress. Every other decision here follows from that one.",
    },
    {
        n: "02",
        title: "A build that refuses to guess",
        body: "Every response from the CMS is validated before it is used, so a renamed field stops the build loudly instead of silently rendering a page that is wrong. Editor HTML is treated as untrusted on the way in. And a production build never invents content: if a fetch fails, the result is a not-found page, not a placeholder that looks real.",
    },
    {
        n: "03",
        title: "Publishing triggers a build",
        body: "An editor pressing publish is the only thing that changes the public site. A small WordPress plugin notices the change, waits out a short quiet period so a burst of edits becomes one job, and asks the host for a fresh build. Nothing about that requires an editor to know it is happening.",
    },
];

const build = [
    {
        title: "Publish once, build once",
        body: "A small WordPress plugin we wrote calls the hosting API when published content changes. Edits are debounced through a 90-second scheduled event, so a burst of ten saves produces a single build. A system cron keeps that scheduler ticking even when no editor has the admin open.",
    },
    {
        title: "Validating what the CMS sends",
        body: "WordPress schemas drift: fields get renamed, field groups get restructured, and IDs come back inconsistently typed. Every GraphQL response is checked against a schema at build time, so a shape change becomes a loud, catchable failure instead of a page that silently renders wrong.",
    },
    {
        title: "Treating CMS HTML as untrusted",
        body: "Editor HTML is injected into pages, which makes it a real attack surface if the CMS trust boundary ever moves. A sanitizing pass strips scripts, frames, forms, event handlers and javascript URLs. While it is in there, it also rewrites broken legacy upload URLs and adds lazy loading to images. It is pattern-based rather than a full HTML parser, which is a deliberate trade-off for a single-tenant site with trusted editors.",
    },
    {
        title: "One way in, with a timeout",
        body: "Every CMS query routes through a single client with a ten-second timeout and two retries on a backoff. Content fetching had started out duplicated inline across a dozen page files; consolidating it into typed services is what made timeouts, retries and validation a single change rather than twelve, and it later made a major framework upgrade a non-event.",
    },
    {
        title: "A CI build that doesn't need the CMS",
        body: "Continuous integration runs a full build against a local mock GraphQL server on every push. Query and schema breakage is caught without depending on the live CMS being reachable from a build runner, and a broken build never reaches the site.",
    },
    {
        title: "Failure states that stay out of the index",
        body: "Not-found and fallback states carry noindex, so a bad build cannot leave a stub page in search results. Every page gets a meta description generated from its own content. Fonts are self-hosted, the hero image is prioritised for first paint, and every image carries explicit dimensions so nothing shifts as it loads.",
    },
];

const steps = [
    {
        n: "01",
        title: "An editor presses publish",
        body: "In wp-admin, exactly as before. It could be a page, a provider bio, a procedure, or a menu item; the plugin only cares that published content changed.",
    },
    {
        n: "02",
        title: "The plugin waits ninety seconds",
        body: "A scheduled WP-Cron event collapses a flurry of saves into one job. A system cron keeps that scheduler ticking when no editor has the admin open, so nothing waits for the next visitor to wp-admin.",
    },
    {
        n: "03",
        title: "The host builds the site",
        body: "Appwrite Sites pulls every page, provider, procedure and the menu over GraphQL, validates each response against its schema, sanitizes editor HTML, and writes plain files. A bad response fails the build here, before any patient sees it.",
    },
    {
        n: "04",
        title: "The old site stays up until the new one is ready",
        body: "A failed build changes nothing. A successful one swaps in a complete set of pages. Either way, the CMS could go offline the next minute and the public site would not notice.",
    },
];

const timeline = [
    {
        title: "Out from under WordPress",
        body: "The site was a full WordPress install, themed and served by PHP on every request. Homepage and facility page rebuilt as static pages reading from the same WordPress content, hosted on Appwrite Sites from day one. The shape of the site (static output, CMS at build time only) was fixed here and never revisited.",
    },
    {
        title: "The whole site over GraphQL",
        body: "Providers, procedures and administrators modelled as custom post types and pulled through WPGraphQL. Home, contact, quality and facility pages parsed from Gutenberg blocks. Navigation generated from the WordPress menu, so editors keep control of it.",
    },
    {
        title: "Hardening sprint",
        body: "Content fetching, which had grown up duplicated across page files, consolidated into typed services with timeouts and retries. Schema validation, HTML sanitization, centralised configuration, environment-aware logging and a mocked-CMS CI build all landed here, alongside self-hosted fonts, image dimensions and generated meta descriptions.",
    },
    {
        title: "Accessibility pass",
        body: "Contrast, a working skip link, reduced-motion guards, iframe titles, and heading and landmark structure, with a browser-driven test suite for keyboard navigation and reflow left in the repository so it stays that way.",
    },
    {
        title: "Astro 7",
        body: "Major framework upgrade, plus redirect and broken-link fixes. The earlier consolidation is what made this uneventful.",
    },
    {
        title: "Publish-to-build",
        body: "The WordPress plugin went live, so an editor's publish is what builds the site, with no developer or deploy button involved. A nondiscrimination notice was added.",
    },
];
---

<BaseLayout
    meta_title="Headless WordPress Case Study | Motown Solutions"
    meta_description="An endoscopy center's WordPress site rebuilt as a static Astro frontend. Staff still edit in WordPress, and pressing publish rebuilds the public site."
>
    <section class="relative overflow-hidden border-b-2 border-ink">
        <svg
            aria-hidden
            class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.12] text-ink"
            viewBox="0 0 1200 700"
            preserveAspectRatio="xMidYMid slice"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
        >
            <rect x="80" y="240" width="220" height="160" />
            <path d="M300 320 H 520" />
            <path d="M480 300 l 40 20 l -40 20" />
            <rect x="520" y="200" width="200" height="240" />
            <path d="M720 320 H 940" />
            <path d="M900 300 l 40 20 l -40 20" />
            <rect x="940" y="180" width="80" height="60" />
            <rect x="940" y="290" width="80" height="60" />
            <rect x="940" y="400" width="80" height="60" />
            <rect x="1060" y="180" width="80" height="60" />
            <rect x="1060" y="290" width="80" height="60" />
            <rect x="1060" y="400" width="80" height="60" />
        </svg>

        <div class="relative max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6 lg:items-center">
                <div class="col-span-12 lg:col-span-7">

                    <h1
                        class="font-display font-bold text-hero text-ink text-balance"
                    >
                        Staff still edit WordPress.
                        <br />
                        Patients
                        <span class="italic text-accent">never load it</span>.
                    </h1>

                    <p
                        class="mt-10 text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        An outpatient endoscopy center was running its public
                        site as a full WordPress install, with PHP, database and plugins serving every patient request. Staff liked
                        editing it. Nobody liked how it loaded. WordPress stayed
                        exactly where it was. Everything in front of it changed.
                    </p>

                    <div class="mt-10 flex flex-wrap gap-3">
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-ink transition-colors"
                        >
                            Rethink your site
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#publishing"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            How publishing works
                        </a>
                    </div>
                </div>

                <div class="col-span-12 lg:col-span-5 mt-12 lg:mt-0">
                    <div
                        class="border-2 border-ink bg-paper-2 lg:translate-y-2"
                        data-reveal
                    >
                        <div
                            class="flex items-center justify-between px-5 py-3 border-b-2 border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted"
                        >
                            <span>At A Glance</span>
                            <span aria-hidden class="text-accent"><span class="status-dot">●</span> live</span>
                        </div>

                        {
                            [
                                ["Sector", "Healthcare, outpatient endoscopy"],
                                ["Audience", "Patients, caregivers, referring physicians"],
                                ["Stack", "Astro 7 · WPGraphQL · Tailwind 4 · Appwrite Sites"],
                                ["CMS at request time", "None. The site is static"],
                                ["Editing", "WordPress, exactly as before"],
                            ].map(([k, v], i, arr) => (
                                <div
                                    class:list={[
                                        "px-5 py-3.5",
                                        i !== arr.length - 1 &&
                                            "border-b border-ink/30",
                                    ]}
                                >
                                    <div class="font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted">
                                        {k}
                                    </div>
                                    <div class="mt-1 font-display font-bold text-lg leading-snug">
                                        {v}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Before / after -->
    <section id="outcomes" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Nothing changed for staff.
                        <br />
                        Everything changed for visitors.
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Replacing a CMS is usually the expensive way to fix a
                        slow site, and it costs the staff everything they know.
                        Keeping the CMS and moving it out of the request path
                        gets the same result without asking anyone to relearn
                        their job.
                    </p>
            </div>

            <div class="border-t border-ink">
                <div
                    class="hidden md:grid grid-cols-12 gap-8 py-4 border-b border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted"
                >
                    <span class="col-span-6">Before</span>
                    <span class="col-span-6">Now</span>
                </div>
                {
                    outcomes.map((row) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-center py-7 border-b border-ink">
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3 text-ink-muted">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px]"
                                >
                                    ×
                                </span>
                                <span class="leading-relaxed line-through decoration-ink/30">
                                    {row.before}
                                </span>
                            </div>
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px] text-accent"
                                >
                                    →
                                </span>
                                <span class="font-medium leading-relaxed">
                                    {row.after}
                                </span>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Three pillars -->
    <section class="border-t-2 border-ink bg-paper-2 py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-7">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Three rules the
                        <br />
                        build runs on.
                    </h2>
                </div>
            </div>

            <div data-stagger class="grid grid-cols-1 md:grid-cols-3 border border-ink bg-paper">
                {
                    pillars.map((p, i, arr) => (
                        <div
                            class:list={[
                                "p-8 md:p-10 border-ink",
                                i !== arr.length - 1 &&
                                    "border-b md:border-b-0 md:border-r",
                            ]}
                        >
                            <div class="font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted mb-6">
                                {p.n}
                            </div>
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-4">
                                {p.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed">
                                {p.body}
                            </p>
                        </div>
                    ))
                }
            </div>

            <blockquote
                class="mt-14 border-l-2 border-accent pl-6 md:pl-8 max-w-3xl"
            >
                <p
                    class="font-display font-bold text-2xl md:text-3xl tracking-tight leading-tight text-balance"
                >
                    Patients don't notice when the CMS is down, even for a week.
                </p>
                <p class="mt-4 text-ink-muted leading-relaxed">
                    Content is fetched at build time.
                    The pages a patient loads were finished the last time an
                    editor pressed publish, so a plugin update, a slow database
                    or an expiring certificate on the editorial side is a staff
                    inconvenience rather than an outage on the public site. The
                    trade-off is that a build needs WordPress reachable
                    while it runs. When it isn't, the build fails and the previous site stays up, which is the failure mode you want.
                </p>
            </blockquote>
        </div>
    </section>

    <!-- Inside the build -->
    <section class="border-t-2 border-ink py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Making a build-time
                        <br />
                        dependency safe.
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Moving the CMS out of the request path moves the risk
                        into the build. A naive version of this architecture
                        ships a broken site the first time WordPress is slow.
                        Most of the engineering here is about that.
                    </p>
            </div>

            <div data-stagger
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    build.map((item) => (
                        <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                {item.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed">
                                {item.body}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Publishing -->
    <section
        id="publishing"
        class="border-t-2 border-ink bg-paper-2 py-20 md:py-28"
        data-reveal
    >
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        What happens when
                        <br />
                        an editor hits save.
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        The whole point of keeping WordPress was that staff
                        would not have to learn anything new. So the pipeline
                        between their publish button and the public site has to be invisible to them, and safe when something goes wrong.
                    </p>
            </div>

            <div class="border-t border-ink">
                {
                    steps.map((t) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 py-8 border-b border-ink">
                            <div class="col-span-12 md:col-span-2 font-mono text-xs uppercase tracking-eyebrow text-ink-muted pt-1">
                                {t.n}
                            </div>
                            <div class="col-span-12 md:col-span-4">
                                <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight">
                                    {t.title}
                                </h3>
                            </div>
                            <div class="col-span-12 md:col-span-6 text-ink-muted leading-relaxed">
                                {t.body}
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Timeline -->
    <section class="border-t-2 border-ink py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Six moves,
                        <br />
                        one decision.
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        The shape of the site was decided in the first month and
                        never revisited. What the rest of the time bought was
                        the discipline around it: validation, sanitization, and
                        a deploy that no longer depends on anyone remembering
                        to press it.
                    </p>
            </div>

            <div class="border-t border-ink">
                {
                    timeline.map((t) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 py-8 border-b border-ink">
                            <div class="col-span-12 md:col-span-2 pt-2">
                                <span aria-hidden class="block w-2.5 h-2.5 rounded-full bg-accent" />
                            </div>
                            <div class="col-span-12 md:col-span-4">
                                <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight">
                                    {t.title}
                                </h3>
                            </div>
                            <div class="col-span-12 md:col-span-6 text-ink-muted leading-relaxed">
                                {t.body}
                            </div>
                        </div>
                    ))
                }
            </div>

            <p class="mt-12 text-ink-muted leading-relaxed max-w-2xl">
                Built with Astro 7, Tailwind CSS 4, Alpine.js, TypeScript,
                graphql-request, zod, WordPress with WPGraphQL and WPGraphQL
                Gutenberg, Appwrite Sites, and Node
                22. This is
                <a
                    href="/website-redesign"
                    class="link-underline font-medium text-ink"
                    >website redesign</a
                > and
                <a
                    href="/migrate-from-wordpress"
                    class="link-underline font-medium text-ink"
                    >WordPress migration</a
                > work for
                <a
                    href="/healthcare-software-development"
                    class="link-underline font-medium text-ink"
                    >healthcare</a
                >, and the reason it keeps working is
                <a
                    href="/website-maintenance"
                    class="link-underline font-medium text-ink"
                    >ongoing maintenance</a
                >.
            </p>
        </div>
    </section>

    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start">
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Your editors are
                <span class="italic text-accent">not the problem</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Tell us what your team edits today and what your site has to do
                for the people who visit it. We will tell you whether the CMS
                needs replacing or just needs getting out of the way, and what either one costs.
            </p>
            <div class="flex flex-wrap gap-3 mb-12">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-paper transition-colors"
                >
                    Rethink your site
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/website-redesign"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    Website Redesign
                </a>
            </div>

            <div
                class="w-full border-t border-paper/20 pt-8 flex flex-wrap items-center gap-x-10 gap-y-3 font-mono text-xs uppercase tracking-eyebrow text-paper/60"
            >
                <a
                    href="https://motowntech.com"
                    class="link-underline text-paper">motowntech.com</a
                >
                <a href="tel:+18459252661" class="link-underline text-paper"
                    >845-925-2661</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
