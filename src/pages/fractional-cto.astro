---
import BaseLayout from "../layouts/BaseLayout.astro";
import Faq from "../components/Faq.astro";

import EnterpriseIcon from "../components/icons/EnterpriseIcon.astro";
import ConsultingIcon from "../components/icons/ConsultingIcon.astro";
import AnalyticsIcon from "../components/icons/AnalyticsIcon.astro";
import ShieldIcon from "../components/icons/ShieldIcon.astro";
import SoftwareIcon from "../components/icons/SoftwareIcon.astro";
import CloudIcon from "../components/icons/CloudIcon.astro";
import SendIcon from "../components/icons/SendIcon.astro";

// The coverage map in the hero — what the role actually covers.
const coverage = [
    { title: "Architecture Calls", icon: EnterpriseIcon },
    { title: "Hiring & Team", icon: ConsultingIcon },
    { title: "Vendor & Spend", icon: CloudIcon },
    { title: "Security & Compliance", icon: ShieldIcon },
    { title: "Roadmap Tradeoffs", icon: SoftwareIcon },
    { title: "Board Narrative", icon: AnalyticsIcon },
];

// What we own once we're in.
const owned = [
    {
        title: "The Hard Calls",
        icon: EnterpriseIcon,
        desc: "Rewrite or refactor, build or buy, monolith or split: someone makes the call, writes it down and defends it, so it stops sliding into the next sprint.",
    },
    {
        title: "Your Engineers",
        icon: ConsultingIcon,
        desc: "One-to-ones, code review standards, and technical mentoring for a team that's never had anyone senior to escalate to.",
    },
    {
        title: "Hiring",
        icon: SendIcon,
        desc: "Scope the role, write the brief, screen the candidates, run the technical loop. We sit on the other side of the table with you.",
    },
    {
        title: "Spend",
        icon: CloudIcon,
        desc: "Cloud bills, tool sprawl, and contractor rates. Most seed-stage stacks have 30% of spend nobody has questioned in a year.",
    },
    {
        title: "Risk",
        icon: ShieldIcon,
        desc: "Security posture, compliance questionnaires, single points of failure, and the parts of the system only one person understands.",
    },
    {
        title: "The Board Story",
        icon: AnalyticsIcon,
        desc: "The technical section of the update, in language investors trust, written by someone who can answer the follow-up question.",
    },
];

// Engagement shapes.
const engagements = [
    {
        title: "Audit",
        cadence: "2 weeks",
        desc: "A fixed-scope read of your stack, team, and roadmap. Ends with a written findings doc and a prioritised list of what to fix first.",
        best: "Best when you suspect something's wrong but can't name it.",
    },
    {
        title: "Sprint",
        cadence: "4 to 8 weeks",
        desc: "We embed to land one specific thing: a migration, a re-architecture, a compliance push, a first engineering hire.",
        best: "Best when you know the problem and need it closed out.",
    },
    {
        title: "Retainer",
        cadence: "Ongoing",
        desc: "A standing day or two a week. Architecture review, team support, board prep, and someone to call when a decision can't wait.",
        best: "Best when the gap is permanent until you hire a full-time CTO.",
    },
];

// What a month looks like.
const monthly = [
    { title: "Decision Records", icon: SoftwareIcon, desc: "Every call written down, with the reasoning." },
    { title: "Architecture Review", icon: EnterpriseIcon, desc: "Standing review of what's being built." },
    { title: "Team Support", icon: ConsultingIcon, desc: "One-to-ones and code review standards." },
    { title: "Spend Report", icon: CloudIcon, desc: "What you're paying for and what to cut." },
    { title: "Board Summary", icon: AnalyticsIcon, desc: "Technical update, investor-ready." },
];

// The gap a missing technical lead leaves.
const gap = [
    {
        before: "No one senior to escalate a technical decision to",
        after: "A standing call and an answer inside the day",
    },
    {
        before: "Architecture decided by whoever argued hardest",
        after: "Decisions written down, with the tradeoffs on record",
    },
    {
        before: "The board asks about scale and you improvise",
        after: "A technical narrative you can defend under questioning",
    },
    {
        before: "First senior hire is a guess with a six-figure downside",
        after: "Role scoped, loop designed, technical screen we run with you",
    },
];

const faqs = [
    {
        q: "What does a fractional CTO do?",
        a: "A fractional CTO makes the senior technical calls a startup has nobody to make: architecture, build or buy, hiring, security and compliance, vendor and cloud spend, and the technical section of the board update. We write each decision down with its reasoning, review what the team is building, and support your engineers with one-to-ones and code review standards.",
    },
    {
        q: "How much time does a fractional CTO spend with us?",
        a: "It depends on the shape of the engagement. An audit is a fixed two weeks and ends with a written findings document. A sprint runs 4 to 8 weeks to close out one specific problem, such as a migration or a first engineering hire. A retainer is a standing day or two a week for as long as you need it.",
    },
    {
        q: "When should a startup hire a full-time CTO instead?",
        a: "When the gap stops being occasional. Most seed-stage companies need someone senior for the four or five calls a month that are expensive to get wrong, and a fractional CTO covers that. A retainer is meant to hold the role until you hire a full-time CTO, and we can help you scope that hire and run its technical interviews.",
    },
    {
        q: "Can a fractional CTO help us hire engineers?",
        a: "Yes. We scope the role, write the brief, screen candidates and run the technical interview loop with you, sitting on your side of the table. A first senior hire made without that is a guess with a six-figure downside, so a first engineering hire is one of the things a sprint engagement can cover.",
    },
    {
        q: "What do we get each month on a retainer?",
        a: "Five things land every month: decision records with the reasoning behind each call, a standing architecture review of what's being built, support for your team through one-to-ones and code review, a spend report showing what you pay for and what to cut, and an investor-ready technical summary for the board.",
    },
];
---

<BaseLayout
    meta_title="Fractional CTO for Startups | Motown Solutions"
    meta_description="A fractional CTO for startups without senior technical leadership: architecture decisions, engineering hiring, security, spend, and board reporting."
>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b-2 border-ink">
        <!-- Contour-line decoration -->
        <svg
            aria-hidden
            class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.12] text-ink"
            viewBox="0 0 1200 700"
            preserveAspectRatio="xMidYMid slice"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
        >
            <path d="M-50 520 Q 200 440 430 490 T 880 470 T 1260 440" />
            <path d="M-50 580 Q 200 500 430 550 T 880 530 T 1260 500" />
            <path d="M-50 640 Q 200 560 430 610 T 880 590 T 1260 560" />
            <path d="M-50 460 Q 200 380 430 430 T 880 410 T 1260 380" />
            <path d="M-50 400 Q 200 320 430 370 T 880 350 T 1260 320" />
        </svg>

        <div class="relative max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-7">

                    <h1
                        class="font-display font-bold text-hero text-ink text-balance"
                    >
                        A fractional CTO for the decisions that <span class="italic text-accent">matter</span>.
                    </h1>

                    <p
                        class="mt-10 text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        Most seed-stage companies don't need a full-time CTO.
                        They need someone senior making the four or five calls a
                        month that are expensive to get wrong, and standing behind them afterwards.
                    </p>

                    <div class="mt-10 flex flex-wrap gap-3">
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-ink transition-colors"
                        >
                            Book a founder call
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#engagements"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            How it works
                        </a>
                    </div>
                </div>

                <!-- The coverage map -->
                <div class="col-span-12 lg:col-span-5 mt-12 lg:mt-0">
                    <div
                        class="border-2 border-ink bg-paper-2 lg:translate-y-2"
                        data-reveal
                    >
                        <div
                            class="flex items-center justify-between px-5 py-3 border-b-2 border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted"
                        >
                            <span>Your Team / Coverage</span>
                            <span aria-hidden class="text-accent">● retained</span>
                        </div>
                        {
                            coverage.map((item, i) => {
                                const Icon = item.icon;
                                return (
                                    <div
                                        class:list={[
                                            "flex items-center gap-4 px-5 py-4",
                                            i !== coverage.length - 1 &&
                                                "border-b border-ink/30",
                                        ]}
                                    >
                                        <span class="font-mono text-[11px] text-ink-muted w-6 shrink-0">
                                            0{i + 1}
                                        </span>
                                        <span class="w-9 h-9 shrink-0 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                            <Icon class="w-5 h-5" />
                                        </span>
                                        <span class="font-display font-bold text-lg leading-none">
                                            {item.title}
                                        </span>
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Metadata strip -->
        <div class="relative border-t border-ink/40 bg-paper">
            <div
                class="max-w-7xl mx-auto px-6 py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 font-mono text-[11px] md:text-xs uppercase tracking-eyebrow text-ink-muted"
            >
                <span>Architecture</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Hiring</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Security</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Spend</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Board</span>
            </div>
        </div>
    </section>

    <!-- What we own -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Not advice.
                        <br />
                        Ownership.
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        An advisor tells you what they'd do and leaves. We make the call, put our name on it,
                        and are still here when it plays out.
                    </p>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    owned.map((item) => {
                        const Icon = item.icon;
                        return (
                            <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                                <div class="flex items-center gap-4 mb-6">
                                    <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                        <Icon />
                                    </span>
                                </div>
                                <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                    {item.title}
                                </h3>
                                <p class="text-ink-muted leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Engagements -->
    <section id="engagements" class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Three shapes,
                        <br />
                        depending on the gap.
                    </h2>
                <p class="mt-5 max-w-2xl text-ink-muted text-lg leading-relaxed">
                    Every engagement starts with the audit. What follows depends on what it finds, and there's no obligation for it to lead
                    anywhere.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 border border-ink bg-paper">
                {
                    engagements.map((item, i) => (
                        <div class="flex flex-col p-8 md:p-10 border-ink border-b lg:border-b-0 lg:border-r last:border-b-0 lg:last:border-r-0">
                            <div class="flex items-baseline justify-between mb-6">
                                <span class="font-mono text-[11px] text-ink-muted">
                                    0{i + 1}
                                </span>
                                <span class="font-mono text-[11px] uppercase tracking-eyebrow text-accent">
                                    {item.cadence}
                                </span>
                            </div>
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                {item.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed mb-5">
                                {item.desc}
                            </p>
                            <p class="mt-auto text-sm font-medium leading-relaxed border-t border-ink/20 pt-5">
                                {item.best}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- What lands every month -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        What lands
                        <br />
                        every month.
                    </h2>
                <p class="mt-5 max-w-2xl text-ink-muted text-lg leading-relaxed">
                    Retainers go bad when nobody can point at the output. These
                    are the artefacts, and they arrive whether or not anything
                    caught fire that month.
                </p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 border border-ink">
                {
                    monthly.map((item) => {
                        const Icon = item.icon;
                        return (
                            <div class="p-7 md:p-8 border-ink border-b sm:border-r last:border-b-0 sm:[&:nth-child(even)]:border-r-0 lg:[&:not(:last-child)]:border-r lg:[&:nth-child(even)]:border-r lg:[&:nth-last-child(-n+1)]:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0">
                                <span class="w-10 h-10 mb-5 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                    <Icon />
                                </span>
                                <h3 class="font-display text-xl font-bold leading-tight mb-2">
                                    {item.title}
                                </h3>
                                <p class="text-sm text-ink-muted leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- The gap -->
    <section class="border-t-2 border-ink py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        What's missing
                        <br />
                        without one.
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        A team can ship for a long time without senior technical
                        leadership. The bill arrives later, usually during a
                        raise or a rewrite.
                    </p>
            </div>

            <div class="border-t border-ink">
                <div
                    class="hidden md:grid grid-cols-12 gap-8 py-4 border-b border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted"
                >
                    <span class="col-span-6">Today</span>
                    <span class="col-span-6">On retainer</span>
                </div>
                {
                    gap.map((row) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-center py-7 border-b border-ink">
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3 text-ink-muted">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px]"
                                >
                                    ×
                                </span>
                                <span class="leading-relaxed line-through decoration-ink/30">
                                    {row.before}
                                </span>
                            </div>
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px] text-accent"
                                >
                                    →
                                </span>
                                <span class="font-medium leading-relaxed">
                                    {row.after}
                                </span>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <Faq items={faqs} heading="Questions about fractional CTOs." />

    <!-- Final CTA -->
    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start">
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Senior judgment,
                <span class="italic text-accent">on retainer</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Two weeks, fixed scope, written findings. At the end you'll know
                what's actually wrong with your stack and your team, and whether you need us after that.
            </p>
            <div class="flex flex-wrap gap-3 mb-12">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-paper transition-colors"
                >
                    Book a founder call
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/startup-consulting"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    Startup Consulting
                </a>
                <a
                    href="/dedicated-development-team"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    Dedicated Teams
                </a>
            </div>

            <!-- Contact strip -->
            <div
                class="w-full border-t border-paper/20 pt-8 flex flex-wrap items-center gap-x-10 gap-y-3 font-mono text-xs uppercase tracking-eyebrow text-paper/60"
            >
                <a
                    href="https://motowntech.com"
                    class="link-underline text-paper"
                    >motowntech.com</a
                >
                <a href="tel:+18459252661" class="link-underline text-paper"
                    >845-925-2661</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
