---
import BaseLayout from "../layouts/BaseLayout.astro";

const process = [
    {
        title: "Discovery & Immersion",
        body: "We interview stakeholders and audit what exists, then run short workshops to agree on goals and constraints.",
    },
    {
        title: "Co-Design & Prototyping",
        body: "We map user flows, sketch the architecture, and build clickable prototypes so stakeholders can try the experience and refine it early.",
    },
    {
        title: "Build & Launch",
        body: "Cross-functional teams ship in short sprints, with automated tests and QA behind every release.",
    },
    {
        title: "Growth & Optimization",
        body: "After launch, analytics and experiments keep the product improving, and we train your team to run it.",
    },
];

const values = [
    {
        title: "Innovation",
        body: "We adopt new technologies early and put the useful ones to work in client projects.",
    },
    {
        title: "Excellence",
        body: "Every release goes through automated tests and QA, and we fix the small details as well as the big ones.",
    },
    {
        title: "Collaboration",
        body: "We work with your team throughout, with regular check-ins, so you stay involved.",
    },
    {
        title: "Results-Driven",
        body: "We measure what the product changes after launch, with analytics and experiments.",
    },
];

const reasons = [
    {
        title: "Expert Team",
        body: "Engineers and designers who have built web apps, mobile apps, AI systems and automation for healthcare, nonprofit and operations teams.",
    },
    {
        title: "Proven Track Record",
        body: "Case studies across healthcare, senior care, nonprofits and auction operations.",
    },
    {
        title: "Agile Approach",
        body: "We work in short iterations with regular check-ins, so you can change priorities as you go.",
    },
    {
        title: "Ongoing Support",
        body: "Bug fixes, updates, security patches and new features after launch.",
    },
    {
        title: "Client-Focused",
        body: "We start by understanding what you're trying to solve, then build to that.",
    },
];
const glance = [
    ["Based", "New York and Florida"],
    ["Team", "2 to 10 people"],
    ["We build", "Custom software, AI, web, mobile and automation"],
    ["Industries", "Healthcare, senior care, nonprofits, auction houses"],
    ["Ways to work", "Projects, ongoing support, fractional CTO"],
    ["Focused projects", "Roughly 4 to 8 weeks"],
];
---

<BaseLayout
    meta_title="About Motown Solutions | Software in New York and Florida"
    meta_description="Motown Solutions is a software company in New York and Florida. We build custom software, websites, mobile apps and automation tools for clients across the US."
>
    <!-- Hero -->
    <section class="relative border-b-2 border-ink overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-10">
                    <h1
                        class="font-display font-bold text-display text-ink text-balance"
                    >
                        An agency for
                        <br />
                        modern <span class="italic text-accent">ideas</span>.
                    </h1>
                </div>
                <div class="col-span-12 lg:col-span-7 lg:col-start-4 mt-10 md:mt-16">
                    <p
                        class="text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        Motown Solutions builds websites, custom software, and automation tools for businesses. We pair technical expertise with a designer's eye. We're based in New York and Florida and work with clients across the US.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Process -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        The same four stages on every project.
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Every project follows the same four stages, and you can see where it stands from the first conversation through launch and after.
                    </p>
            </div>
            <div
                class="grid gap-0 md:grid-cols-4 border border-ink"
            >
                {
                    process.map((step) => (
                        <div class="p-8 md:p-10 border-ink border-b md:border-b-0 md:border-r last:border-r-0 last:border-b-0">
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-4">
                                {step.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed">
                                {step.body}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Our Story -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 md:gap-12 lg:items-start">
                <div class="col-span-12 lg:col-span-7">
                    <h2 class="font-display font-bold text-h2 tracking-tight text-balance mb-8">
                        Who you'll be working with.
                    </h2>
                    <div class="space-y-5 text-ink-muted leading-relaxed text-lg max-w-2xl">
                        <p>
                            Motown Solutions is a team of engineers and
                            designers in New York and Florida. We build custom
                            software, websites, mobile apps, AI tools and
                            automation, and we stay on after launch to maintain
                            what we built.
                        </p>
                        <p>
                            Most projects start with something that already
                            exists and isn't keeping up: a spreadsheet the
                            business has outgrown, a prototype that now has to
                            hold real data, or a site that's slow and hard to
                            change. We learn how your team works first, then
                            build the simplest thing that fits it. You own the
                            code, the accounts and the documentation from day
                            one.
                        </p>
                    </div>
                </div>

                <div class="col-span-12 lg:col-span-5">
                    <div class="border-2 border-ink bg-paper">
                        <div class="px-5 py-3 border-b-2 border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted">
                            At a glance
                        </div>
                        {
                            glance.map(([k, v], i, arr) => (
                                <div class:list={["px-5 py-3.5", i !== arr.length - 1 && "border-b border-ink/30"]}>
                                    <div class="font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted">{k}</div>
                                    <div class="mt-1 font-display font-bold tracking-tight text-lg leading-snug">{v}</div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Values -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        The principles
                        <br />
                        that guide us.
                    </h2>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 border border-ink">
                {
                    values.map((v) => (
                        <div class="p-8 md:p-10 border-ink border-b md:[&:nth-child(odd)]:border-r md:[&:nth-child(n+3)]:border-b-0 last:border-b-0">
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                {v.title}
                            </h3>
                            <p class="text-ink-muted leading-relaxed">
                                {v.body}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Why Choose Us -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-7">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Technical expertise,
                        <br />
                        creative conviction.
                    </h2>
                </div>
            </div>

            <div class="border border-ink">
                {
                    reasons.map((r) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-start py-7 md:py-8 px-6 md:px-8 border-b border-ink last:border-b-0">
                            <h3 class="col-span-12 md:col-span-5 font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight">
                                {r.title}
                            </h3>
                            <p class="col-span-12 md:col-span-7 md:pl-4 text-ink-muted leading-relaxed max-w-prose">
                                {r.body}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA — inverted -->
    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div
            class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start"
        >
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Ready to work
                <br />
                <span class="italic text-accent">together</span>?
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Get in touch and tell us what you're working on.
            </p>
            <div class="flex flex-wrap gap-3">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-paper text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-ink hover:text-paper transition-colors"
                >
                    Contact Us
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/services"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    View Our Services
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
