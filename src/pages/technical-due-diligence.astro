---
import BaseLayout from "../layouts/BaseLayout.astro";

import EnterpriseIcon from "../components/icons/EnterpriseIcon.astro";
import SoftwareIcon from "../components/icons/SoftwareIcon.astro";
import ShieldIcon from "../components/icons/ShieldIcon.astro";
import CloudIcon from "../components/icons/CloudIcon.astro";
import ConsultingIcon from "../components/icons/ConsultingIcon.astro";
import ApiIcon from "../components/icons/ApiIcon.astro";
import AnalyticsIcon from "../components/icons/AnalyticsIcon.astro";
import AutomationIcon from "../components/icons/AutomationIcon.astro";
import SendIcon from "../components/icons/SendIcon.astro";

// The audit scope in the hero.
const scope = [
    { title: "Architecture", icon: EnterpriseIcon },
    { title: "Code Quality", icon: SoftwareIcon },
    { title: "Security", icon: ShieldIcon },
    { title: "Infrastructure & Cost", icon: CloudIcon },
    { title: "Team & Bus Factor", icon: ConsultingIcon },
    { title: "IP & Licensing", icon: ApiIcon },
];

// What we actually look at, and what we're looking for.
const examined = [
    {
        title: "Architecture",
        icon: EnterpriseIcon,
        desc: "Whether the system can absorb the next 18 months of roadmap, or whether the plan assumes a rewrite nobody has budgeted for.",
    },
    {
        title: "Code Quality",
        icon: SoftwareIcon,
        desc: "Test coverage where it counts, consistency, and how much of the codebase a new engineer could safely change in their first month.",
    },
    {
        title: "Security",
        icon: ShieldIcon,
        desc: "Auth, access control, secrets handling, data exposure, and dependency vulnerabilities. These are the findings that stall a deal at the worst moment.",
    },
    {
        title: "Infrastructure & Cost",
        icon: CloudIcon,
        desc: "What the platform costs today, what it costs at 10× the load, and which line items scale in a way nobody has modelled.",
    },
    {
        title: "Team & Bus Factor",
        icon: ConsultingIcon,
        desc: "Which systems only one person understands, what's undocumented, and what actually happens if that person resigns mid-raise.",
    },
    {
        title: "IP & Licensing",
        icon: ApiIcon,
        desc: "Who owns the code, whether contractor agreements assign it, and whether any dependency carries a licence your acquirer won't accept.",
    },
];

// What lands at the end.
const deliverables = [
    { title: "Findings Report", icon: SoftwareIcon, desc: "Plain-language write-up, evidence attached." },
    { title: "Risk Register", icon: ShieldIcon, desc: "Ranked by likelihood and deal impact." },
    { title: "Remediation Plan", icon: AutomationIcon, desc: "What to fix, in what order, at what cost." },
    { title: "Cost Model", icon: AnalyticsIcon, desc: "Run-rate today and under projected growth." },
    { title: "Data-Room Summary", icon: SendIcon, desc: "A one-pager written for investors." },
];

// The timing argument — the whole pitch of this page.
const timing = [
    {
        before: "Their engineer finds it, in week three of the raise",
        after: "You find it first, on a timeline you control",
    },
    {
        before: "A surprise becomes leverage in someone else's negotiation",
        after: "A known issue with a costed plan already attached",
    },
    {
        before: "Contractor-built code with no assignment on file",
        after: "Clean IP chain and a dependency licence inventory",
    },
    {
        before: "\"We'll fix that after close,\" priced into your valuation",
        after: "Fixed beforehand, or disclosed on your own terms",
    },
];
---

<BaseLayout
    meta_title="Technical Due Diligence | Motown Solutions"
    meta_description="Technical due diligence before a raise or exit: architecture, code quality, security, cloud cost, key-person risk, and IP, with a costed remediation plan."
>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b-2 border-ink">
        <!-- Contour-line decoration -->
        <svg
            aria-hidden
            class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.12] text-ink"
            viewBox="0 0 1200 700"
            preserveAspectRatio="xMidYMid slice"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
        >
            <g class="hero-drift">
                <path d="M-50 520 Q 200 440 430 490 T 880 470 T 1260 440" />
                <path d="M-50 580 Q 200 500 430 550 T 880 530 T 1260 500" />
                <path d="M-50 640 Q 200 560 430 610 T 880 590 T 1260 560" />
                <path d="M-50 460 Q 200 380 430 430 T 880 410 T 1260 380" />
                <path d="M-50 400 Q 200 320 430 370 T 880 350 T 1260 320" />
            </g>
</svg>

        <div class="relative max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-7">

                    <h1
                        class="font-display font-bold text-hero text-ink text-balance"
                    >
                        Technical due diligence: know what's in the codebase before they <span class="italic text-accent">do</span>.
                    </h1>

                    <p
                        class="mt-10 text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        Someone is going to read your code with a critical eye: an investor's engineer, an acquirer's team, or an enterprise buyer's security reviewer. The question is whether you've read it that way first.
                    </p>

                    <div class="mt-10 flex flex-wrap gap-3">
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-ink transition-colors"
                        >
                            Book an audit
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#examined"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            What we examine
                        </a>
                    </div>
                </div>

                <!-- The audit scope -->
                <div class="col-span-12 lg:col-span-5 mt-12 lg:mt-0">
                    <div
                        class="border-2 border-ink bg-paper-2 lg:translate-y-2"
                        data-reveal
                    >
                        <div
                            class="flex items-center justify-between px-5 py-3 border-b-2 border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted"
                        >
                            <span>Audit / Scope</span>
                            <span aria-hidden class="text-accent"><span class="status-dot">●</span> 2-week</span>
                        </div>
                        {
                            scope.map((item, i) => {
                                const Icon = item.icon;
                                return (
                                    <div data-step
                                        class:list={[
                                            "flex items-center gap-4 px-5 py-4",
                                            i !== scope.length - 1 &&
                                                "border-b border-ink/30",
                                        ]}
                                    >
                                        <span class="font-mono text-[11px] text-ink-muted w-6 shrink-0">
                                            0{i + 1}
                                        </span>
                                        <span class="w-9 h-9 shrink-0 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                            <Icon class="w-5 h-5" />
                                        </span>
                                        <span class="font-display font-bold text-lg leading-none">
                                            {item.title}
                                        </span>
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Metadata strip -->
        <div class="relative border-t border-ink/40 bg-paper">
            <div
                class="max-w-7xl mx-auto px-6 py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 font-mono text-[11px] md:text-xs uppercase tracking-eyebrow text-ink-muted"
            >
                <span>Architecture</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Code</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Security</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Cost</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>IP</span>
            </div>
        </div>
    </section>

    <!-- What we examine -->
    <section id="examined" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Six places
                        <br />
                        deals go wrong.
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        We look where a buyer's technical reviewer looks, and we
                        write it up the way they would, so nothing in their
                        report is new information to you.
                    </p>
            </div>

            <div data-stagger
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    examined.map((item) => {
                        const Icon = item.icon;
                        return (
                            <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                                <div class="flex items-center gap-4 mb-6">
                                    <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                        <Icon />
                                    </span>
                                </div>
                                <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                    {item.title}
                                </h3>
                                <p class="text-ink-muted leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Deliverables -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Five documents,
                        <br />
                        two weeks.
                    </h2>
                <p class="mt-5 max-w-2xl text-ink-muted text-lg leading-relaxed">
                    Written to be forwarded. Every finding carries evidence, an
                    estimated cost to fix, and a plain sentence explaining why it
                    matters to a non-engineer.
                </p>
            </div>

            <div data-stagger class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 border border-ink">
                {
                    deliverables.map((item) => {
                        const Icon = item.icon;
                        return (
                            <div class="p-7 md:p-8 border-ink border-b sm:border-r last:border-b-0 sm:[&:nth-child(even)]:border-r-0 lg:[&:not(:last-child)]:border-r lg:[&:nth-child(even)]:border-r lg:[&:nth-last-child(-n+1)]:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0">
                                <span class="w-10 h-10 mb-5 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                    <Icon />
                                </span>
                                <h3 class="font-display text-xl font-bold leading-tight mb-2">
                                    {item.title}
                                </h3>
                                <p class="text-sm text-ink-muted leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Timing -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="mb-10 md:mb-12">
                <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Same findings.
                        <br />
                        Different leverage.
                    </h2>
                <p
                        class="mt-5 max-w-2xl text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        A problem you disclose is a line item. The same problem,
                        discovered by the other side, is a discount.
                    </p>
            </div>

            <div class="border-t border-ink">
                <div
                    class="hidden md:grid grid-cols-12 gap-8 py-4 border-b border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted"
                >
                    <span class="col-span-6">They find it</span>
                    <span class="col-span-6">You find it first</span>
                </div>
                {
                    timing.map((row) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-center py-7 border-b border-ink">
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3 text-ink-muted">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px]"
                                >
                                    ×
                                </span>
                                <span class="leading-relaxed line-through decoration-ink/30">
                                    {row.before}
                                </span>
                            </div>
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px] text-accent"
                                >
                                    →
                                </span>
                                <span class="font-medium leading-relaxed">
                                    {row.after}
                                </span>
                            </div>
                        </div>
                    ))
                }
            </div>

            <!-- Two audiences -->
            <div class="mt-16 grid grid-cols-1 md:grid-cols-2 border-2 border-ink">
                <div
                    class="flex flex-col p-8 md:p-10 border-b md:border-b-0 md:border-r border-ink"
                >
                    <div
                        class="font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted mb-4"
                    >
                        If you're the founder
                    </div>
                    <p class="text-lg leading-relaxed text-pretty mb-6">
                        Run it four to six weeks before you open a data room.
                        That's enough time to fix what's cheap, cost what isn't,
                        and walk into diligence with the answers already written. Buyers increasingly ask for a
                        SOC 2 report alongside it; see
                        <a href="/soc-2-readiness" class="link-underline font-medium text-ink">SOC 2 readiness</a>.
                    </p>
                    <a
                        href="/prototype-to-production"
                        class="link-underline mt-auto self-start font-mono text-xs uppercase tracking-[0.15em]"
                        >Need the fixes done too →</a
                    >
                </div>
                <div class="flex flex-col p-8 md:p-10 bg-paper-2">
                    <div
                        class="font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted mb-4"
                    >
                        If you're the investor
                    </div>
                    <p class="text-lg leading-relaxed text-pretty mb-6">
                        We run the same audit on a company you're considering,
                        and report to you rather than to them: architecture,
                        risk, cost to fix, and how much of the roadmap the
                        current system can actually carry.
                    </p>
                    <a
                        href="/contact"
                        class="link-underline mt-auto self-start font-mono text-xs uppercase tracking-[0.15em]"
                        >Commission a review →</a
                    >
                </div>
            </div>
        </div>
    </section>

    <!-- Final CTA -->
    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start">
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                No
                <span class="italic text-accent">surprises</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Two weeks, fixed scope, five documents. Whatever is in there,
                you'll be the one who found it, and you'll have a costed plan
                attached before anyone asks.
            </p>
            <div class="flex flex-wrap gap-3 mb-12">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-paper transition-colors"
                >
                    Book an audit
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/startup-consulting"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    Startup Consulting
                </a>
            </div>

            <!-- Contact strip -->
            <div
                class="w-full border-t border-paper/20 pt-8 flex flex-wrap items-center gap-x-10 gap-y-3 font-mono text-xs uppercase tracking-eyebrow text-paper/60"
            >
                <a
                    href="https://motowntech.com"
                    class="link-underline text-paper"
                    >motowntech.com</a
                >
                <a href="tel:+18459252661" class="link-underline text-paper"
                    >845-925-2661</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
