---
import BaseLayout from "../layouts/BaseLayout.astro";
import NumberedRow from "../components/NumberedRow.astro";
import Faq from "../components/Faq.astro";

import DatabaseIcon from "../components/icons/DatabaseIcon.astro";
import SoftwareIcon from "../components/icons/SoftwareIcon.astro";
import ShieldIcon from "../components/icons/ShieldIcon.astro";
import AutomationIcon from "../components/icons/AutomationIcon.astro";
import ApiIcon from "../components/icons/ApiIcon.astro";
import AnalyticsIcon from "../components/icons/AnalyticsIcon.astro";

// The hero sheet: the workbook every business runs on, mid-failure.
const sheetCols = ["A", "B", "C", "D"];
const sheetRows = [
    ["Client", "Status", "Owner", "Total"],
    ["Acme Co.", "Active", "J. Ruiz", "$12,400"],
    ["Northwind", "Pending", "—", "#REF!"],
    ["Globex", "active ", "M. Chen", "$8,950"],
    ["Initech", "Active", "J. Ruiz", "#VALUE!"],
    ["Umbrella", "???", "", "$3,200"],
];

// What the spreadsheet becomes.
const layers = [
    {
        title: "A Real Database",
        icon: DatabaseIcon,
        desc: "Your tabs become a proper schema with related tables and validated fields. History stops vanishing when someone sorts one column.",
    },
    {
        title: "Purpose-Built Screens",
        icon: SoftwareIcon,
        desc: "Forms and views shaped around how your team works, so nobody scrolls to column AF to update a status.",
    },
    {
        title: "Users & Permissions",
        icon: ShieldIcon,
        desc: "Logins, roles, and audit trails, so everyone sees what they need and can only change what they should.",
    },
    {
        title: "Automated Workflows",
        icon: AutomationIcon,
        desc: "The app takes over the copy-pasting, reminder emails, and Friday rollups that someone does by hand now.",
    },
    {
        title: "Integrations",
        icon: ApiIcon,
        desc: "Connected to your accounting, CRM, email, and payment tools, so data flows in instead of getting re-keyed.",
    },
    {
        title: "Reporting",
        icon: AnalyticsIcon,
        desc: "Live dashboards built on clean data, replacing the pivot table that only one person knows how to refresh.",
    },
];

// Spreadsheet vs. app — the pain points we hear on every first call.
const beforeAfter = [
    {
        before: "One wrong paste breaks every formula downstream",
        after: "Validated inputs and calculations that can't be overwritten",
    },
    {
        before: "Final_v7_REAL.xlsx emailed around the office",
        after: "One source of truth, live for everyone",
    },
    {
        before: "Anyone with the link can see and edit everything",
        after: "Role-based access with a full audit log",
    },
    {
        before: "Slows to a crawl past a few thousand rows",
        after: "A database built to handle years of growth",
    },
    {
        before: "Only one person understands how it works",
        after: "Documented logic your whole team can rely on",
    },
];

// How we get from the workbook to the app.
const steps = [
    {
        title: "Map the sheet",
        desc: "We walk through every tab, formula, macro, and workaround in your workbook and map out what it actually does.",
    },
    {
        title: "Model the data",
        desc: "Rows and columns become a clean data model. Along the way, the duplicates and inconsistencies hiding in the cells come to the surface.",
    },
    {
        title: "Build the app",
        desc: "Screens, permissions, and automations get built around your workflow, and you see working software every week or two.",
    },
    {
        title: "Migrate & cut over",
        desc: "Your existing data is imported and cleaned, then both run side by side until you trust the app. Only then does the spreadsheet retire.",
    },
];

const faqs = [
    {
        q: "Can you turn our Excel or Google Sheets file into an app?",
        a: "Yes. We work from Excel, Google Sheets, Airtable and Access files, including VBA macros. We walk through every tab, formula, macro and workaround to map what the workbook actually does, then use it as the spec for the app: a real database, screens shaped around how your team works, logins and permissions, and reports built on clean data.",
    },
    {
        q: "How long does it take to replace a spreadsheet with an app?",
        a: "Most take roughly 4 to 8 weeks. Where yours falls depends on how many sheets, people and integrations the app has to cover. We confirm a timeline once we have seen your spreadsheet and how your team uses it, and your team keeps working in the spreadsheet until the app is ready.",
    },
    {
        q: "Will we lose any data when we move off the spreadsheet?",
        a: "No. Your existing data is imported and cleaned as part of the move. While we model it, the duplicates and inconsistencies hiding in the cells come to the surface, so you can decide how to fix them before they reach the new system. The spreadsheet only retires once the app holds everything you need.",
    },
    {
        q: "Can our team keep using the spreadsheet while you build?",
        a: "Yes. Your team keeps working in the spreadsheet for the whole build. When the app is ready, both run side by side until you trust the app, and only then does the spreadsheet go away. You see working software every week or two along the way, so you can steer the build as it takes shape.",
    },
    {
        q: "Can the app connect to our accounting software and CRM?",
        a: "Yes. We connect the app to the tools you already use, such as accounting, CRM, email and payment systems, so data flows in on its own instead of being typed in twice. The app can also take over the copy-pasting, reminder emails and weekly rollups that someone on your team does by hand today.",
    },
    {
        q: "Who can see and change the data in the app?",
        a: "Only the people you allow. Everyone signs in with their own account, and roles decide what each person can see and what they can change. Every change is recorded in an audit log, so when a number looks wrong you can see who changed it and when, and stop guessing whose paste broke the formula.",
    },
    {
        q: "Have you replaced a spreadsheet like ours before?",
        a: "Yes. An auction house we built for ran its inventory across spreadsheets, a shared photo folder and a group chat. We replaced them with one system of record where each item moves through seven stages from intake to sold, every change is attributed to a person, and deletes can be undone. The auction operations case study has the full story.",
    },
];
---

<BaseLayout
    meta_title="Turn Your Spreadsheet Into an App | Motown Solutions"
    meta_description="Outgrown Excel or Google Sheets? We turn spreadsheet workflows into secure web apps with a real database, user permissions, automation, and reporting."
>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b-2 border-ink">
        <!-- Grid-line decoration -->
        <svg
            aria-hidden
            class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.08] text-ink"
            viewBox="0 0 1200 700"
            preserveAspectRatio="xMidYMid slice"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
        >
            {Array.from({ length: 13 }, (_, i) => <path d={`M${i * 100} 0 V700`} />)}
            {Array.from({ length: 15 }, (_, i) => <path d={`M0 ${i * 50} H1200`} />)}
        </svg>

        <div class="relative max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-7">

                    <h1
                        class="font-display font-bold text-hero text-ink text-balance"
                    >
                        Your business
                        <br />
                        outgrew the spreadsheet.
                        <br />
                        Make it a
                        <span class="italic text-accent">real app</span>.
                    </h1>

                    <p
                        class="mt-10 text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        That Excel file or Google Sheet got you this far. We
                        turn it into secure, production-ready software, with a
                        real database, proper logins, automated workflows, and
                        reports you can trust. We keep the logic that works
                        and drop the parts that keep breaking.
                    </p>

                    <div class="mt-10 flex flex-wrap gap-3">
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-ink transition-colors"
                        >
                            Replace my spreadsheet
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#build"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            See what we build
                        </a>
                    </div>
                </div>

                <!-- The sheet, mid-failure -->
                <div class="col-span-12 lg:col-span-5 mt-12 lg:mt-0">
                    <div
                        class="border-2 border-ink bg-paper-2 lg:translate-y-2"
                        data-reveal
                    >
                        <div
                            class="flex items-center justify-between px-5 py-3 border-b-2 border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted"
                        >
                            <span>Operations_FINAL_v7.xlsx</span>
                            <span aria-hidden class="text-accent">● 3 errors</span>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full font-mono text-xs border-collapse">
                                <thead>
                                    <tr class="text-ink-muted">
                                        <th class="w-8 border-b border-r border-ink/30"></th>
                                        {
                                            sheetCols.map((c) => (
                                                <th class="px-3 py-2 font-normal text-left border-b border-r border-ink/30 last:border-r-0">
                                                    {c}
                                                </th>
                                            ))
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    {
                                        sheetRows.map((row, i) => (
                                            <tr class:list={[i === 0 && "font-bold"]}>
                                                <td class="px-2 py-2 text-center text-ink-muted border-r border-ink/30 border-b border-ink/30">
                                                    {i + 1}
                                                </td>
                                                {row.map((cell) => (
                                                    <td
                                                        class:list={[
                                                            "px-3 py-2 whitespace-nowrap border-b border-r border-ink/30 last:border-r-0",
                                                            cell.startsWith("#") &&
                                                                "text-accent bg-accent/10",
                                                        ]}
                                                    >
                                                        {cell}
                                                    </td>
                                                ))}
                                            </tr>
                                        ))
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metadata strip -->
        <div class="relative border-t border-ink/40 bg-paper">
            <div
                class="max-w-7xl mx-auto px-6 py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 font-mono text-[11px] md:text-xs uppercase tracking-eyebrow text-ink-muted"
            >
                <span>Excel</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Google Sheets</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Airtable</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Access</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>VBA &amp; Macros</span>
            </div>
        </div>
    </section>

    <!-- Before / After -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Signs you've
                        <br />
                        outgrown the sheet.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Spreadsheets are a great way to start a process. Once
                        that process runs the business, they start to fail, and
                        usually without anyone noticing until it costs you.
                    </p>
                </div>
            </div>

            <div class="border-t border-ink">
                <div
                    class="hidden md:grid grid-cols-12 gap-8 py-4 border-b border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted"
                >
                    <span class="col-span-6">Spreadsheet</span>
                    <span class="col-span-6">Production App</span>
                </div>
                {
                    beforeAfter.map((row) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-center py-7 border-b border-ink">
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3 text-ink-muted">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px]"
                                >
                                    ×
                                </span>
                                <span class="leading-relaxed line-through decoration-ink/30">
                                    {row.before}
                                </span>
                            </div>
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px] text-accent"
                                >
                                    →
                                </span>
                                <span class="font-medium leading-relaxed">
                                    {row.after}
                                </span>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- What we build -->
    <section id="build" class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Everything the sheet
                        <br />
                        was trying to be.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Your spreadsheet already captures how the business
                        runs. We use it as the spec and build the software it
                        was standing in for.
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink bg-paper"
            >
                {
                    layers.map((layer) => {
                        const Icon = layer.icon;
                        return (
                            <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                                <div class="flex items-center gap-4 mb-6">
                                    <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                        <Icon />
                                    </span>
                                </div>
                                <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                    {layer.title}
                                </h3>
                                <p class="text-ink-muted leading-relaxed">
                                    {layer.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Process -->
    <section class="border-t-2 border-ink py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        From workbook
                        <br />
                        to working app.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Your team keeps using the spreadsheet while we build.
                        It only goes away once the app has proven itself.
                    </p>
                </div>
            </div>

            <div>
                {
                    steps.map((step, i) => (
                        <NumberedRow
                            title={`0${i + 1} ${step.title}`}
                            description={step.desc}
                        />
                    ))
                }
            </div>
        </div>
    </section>

    <Faq items={faqs} heading="Questions about replacing a spreadsheet." />

    <!-- Final CTA -->
    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start">
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Turn the sheet into
                <span class="italic text-accent">software</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Show us the spreadsheet your business depends on. We'll map
                what it does, tell you what the app would look like, and give
                you a realistic timeline to get there.
            </p>
            <div class="flex flex-wrap gap-3 mb-12">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-paper transition-colors"
                >
                    Replace my spreadsheet
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/prototype-to-production"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    Have a prototype instead?
                </a>
            </div>

            <!-- Contact strip -->
            <div
                class="w-full border-t border-paper/20 pt-8 flex flex-wrap items-center gap-x-10 gap-y-3 font-mono text-xs uppercase tracking-eyebrow text-paper/60"
            >
                <a
                    href="https://motowntech.com"
                    class="link-underline text-paper"
                    >motowntech.com</a
                >
                <a href="tel:+18459252661" class="link-underline text-paper"
                    >845-925-2661</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
