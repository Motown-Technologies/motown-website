---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts } from "../../lib/posts";
import PostList from "../../components/PostList.astro";

// /blog, then /blog/2, /blog/3 ... Post slugs must not be bare numbers.
export const getStaticPaths = (async ({ paginate }) => paginate(await getPosts(), { pageSize: 12 })) satisfies GetStaticPaths;

const { page } = Astro.props;
---

<BaseLayout
    meta_title={page.currentPage === 1 ? "Blog: Custom Software, AI & Automation | Motown Solutions" : `Blog, page ${page.currentPage} | Motown Solutions`}
    meta_description={page.currentPage === 1
        ? "Articles on custom software, AI and automation from Motown Solutions, drawn from client projects: what we built, what we decided and why."
        : `More articles on custom software, AI and automation from Motown Solutions. Page ${page.currentPage} of ${page.lastPage}.`}
>
    <section class="relative border-b-2 border-ink overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <h1 class="font-display font-bold text-display text-ink text-balance">
                Notes from
                <br />
                the <span class="italic text-accent">workbench</span>.
            </h1>
        </div>
    </section>

    <PostList page={page} />
</BaseLayout>
