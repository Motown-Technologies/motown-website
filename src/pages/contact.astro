---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    meta_title="Contact Motown Solutions | Start a Software Project"
    meta_description="Tell us about your project and we usually reply within 24 hours. We build custom software, websites, apps, and automation. Call 845-925-2661."
>
    <!-- Hero -->
    <section class="relative border-b-2 border-ink overflow-hidden">
        <div class="max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-10">
                    <div class="flex items-center gap-3 mb-8">
                        <span aria-hidden class="inline-block w-8 h-px bg-ink"
                        ></span>
                        <span
                            class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted"
                            >Contact / Get in touch</span
                        >
                    </div>
                    <h1
                        class="font-display font-bold text-display text-ink text-balance"
                    >
                        Let's start
                        <br />
                        building <span class="italic text-accent">together</span
                        >.
                    </h1>
                </div>
                <div
                    class="col-span-12 lg:col-span-7 lg:col-start-4 mt-10 md:mt-16"
                >
                    <p
                        class="text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        Have a project in mind? Tell us about it, and we'll talk through how we can help.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Form + Info -->
    <section class="py-16 md:py-24" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-10 md:gap-16">
                <!-- Form -->
                <div class="col-span-12 lg:col-span-7">
                    <div class="flex items-center gap-3 mb-6">
                        <span aria-hidden class="inline-block w-8 h-px bg-ink"
                        ></span>
                        <span
                            class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted"
                            >Send us a message</span
                        >
                    </div>
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance mb-10"
                    >
                        Tell us about
                        <br />
                        your project.
                    </h2>

                    <form
                        class="space-y-8"
                        action="https://api.web3forms.com/submit"
                        method="POST"
                        data-contact-form
                        data-success-message="Thanks! We'll get back to you shortly."
                        data-error-message="Something went wrong. Please try again."
                        novalidate
                    >
                        <input
                            type="hidden"
                            name="access_key"
                            value="9333b567-0c0f-46d0-a446-f4b9795d1885"
                        />

                        <div class="grid md:grid-cols-2 gap-8">
                            <div class="relative">
                                <label
                                    for="firstName"
                                    class="block font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted mb-2"
                                    >First Name</label
                                >
                                <input
                                    type="text"
                                    id="firstName"
                                    name="firstName"
                                    class="w-full bg-transparent border-0 border-b border-ink/30 py-3 text-ink placeholder:text-ink-muted/50 focus:outline-hidden focus:border-ink transition-colors"
                                    placeholder="John"
                                    required
                                />
                            </div>
                            <div class="relative">
                                <label
                                    for="lastName"
                                    class="block font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted mb-2"
                                    >Last Name</label
                                >
                                <input
                                    type="text"
                                    id="lastName"
                                    name="lastName"
                                    class="w-full bg-transparent border-0 border-b border-ink/30 py-3 text-ink placeholder:text-ink-muted/50 focus:outline-hidden focus:border-ink transition-colors"
                                    placeholder="Doe"
                                    required
                                />
                            </div>
                        </div>

                        <div>
                            <label
                                for="email"
                                class="block font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted mb-2"
                                >Email Address</label
                            >
                            <input
                                type="email"
                                id="email"
                                name="email"
                                class="w-full bg-transparent border-0 border-b border-ink/30 py-3 text-ink placeholder:text-ink-muted/50 focus:outline-hidden focus:border-ink transition-colors"
                                placeholder="john@example.com"
                                required
                            />
                        </div>

                        <div>
                            <label
                                for="phone"
                                class="block font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted mb-2"
                                >Phone Number</label
                            >
                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                class="w-full bg-transparent border-0 border-b border-ink/30 py-3 text-ink placeholder:text-ink-muted/50 focus:outline-hidden focus:border-ink transition-colors"
                                placeholder="(555) 123-4567"
                            />
                        </div>

                        <div>
                            <label
                                for="message"
                                class="block font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted mb-2"
                                >Project Details</label
                            >
                            <textarea
                                id="message"
                                name="message"
                                rows="5"
                                class="w-full bg-transparent border-0 border-b border-ink/30 py-3 text-ink placeholder:text-ink-muted/50 focus:outline-hidden focus:border-ink transition-colors resize-none"
                                placeholder="Tell us about your project..."
                                required></textarea>
                        </div>

                        <!-- honeypot: bots fill this, Web3Forms drops the submission -->
                        <input
                            type="checkbox"
                            name="botcheck"
                            class="hidden"
                            style="display: none;"
                            tabindex="-1"
                            autocomplete="off"
                            aria-hidden="true"
                        />

                        <p
                            class="hidden border border-ink bg-paper-2 px-4 py-3 text-sm font-mono text-ink"
                            data-form-success
                            role="status"
                        >
                        </p>
                        <p
                            class="hidden border border-ink bg-ink text-paper px-4 py-3 text-sm font-mono"
                            data-form-error
                            role="alert"
                        >
                        </p>

                        <button
                            type="submit"
                            class="group w-full inline-flex items-center justify-center gap-3 bg-ink text-paper font-mono text-xs md:text-sm uppercase tracking-[0.15em] px-6 py-5 border-2 border-ink hover:bg-paper hover:text-ink transition-[color,background-color,border-color,opacity] duration-200 ease-out disabled:opacity-60 disabled:cursor-not-allowed"
                            data-submit-button
                        >
                            <span
                                class="hidden h-4 w-4 border-2 border-current/30 border-t-current rounded-full animate-spin [animation-duration:0.6s]"
                                aria-hidden="true"
                                data-submit-loader></span>
                            <span data-submit-label>Send Message</span>
                            <span
                                aria-hidden
                                class="transition-transform group-hover:translate-x-0.5"
                                data-submit-icon>→</span
                            >
                        </button>
                    </form>
                </div>

                <!-- Contact info -->
                <aside class="col-span-12 lg:col-span-4 lg:col-start-9">
                    <div class="flex items-center gap-3 mb-6">
                        <span aria-hidden class="inline-block w-8 h-px bg-ink"
                        ></span>
                        <span
                            class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted"
                            >Direct</span
                        >
                    </div>
                    <h2
                        class="font-display text-3xl md:text-4xl font-bold tracking-tight leading-tight mb-8"
                    >
                        Or reach us
                        <br />
                        directly.
                    </h2>

                    <dl class="border-t border-ink">
                        <div
                            class="flex items-start gap-4 py-5 border-b border-ink"
                        >
                            <dt
                                class="font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted w-16 shrink-0 pt-1"
                            >
                                Email
                            </dt>
                            <dd>
                                <a
                                    href="mailto:contact@motowntech.com"
                                    class="link-underline font-medium"
                                >
                                    contact@motowntech.com
                                </a>
                            </dd>
                        </div>
                        <div
                            class="flex items-start gap-4 py-5 border-b border-ink"
                        >
                            <dt
                                class="font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted w-16 shrink-0 pt-1"
                            >
                                Phone
                            </dt>
                            <dd>
                                <a
                                    href="tel:+18459252661"
                                    class="link-underline font-medium"
                                >
                                    845-925-2661
                                </a>
                            </dd>
                        </div>
                        <div
                            class="flex items-start gap-4 py-5 border-b border-ink"
                        >
                            <dt
                                class="font-mono text-[10px] uppercase tracking-eyebrow text-ink-muted w-16 shrink-0 pt-1"
                            >
                                Based
                            </dt>
                            <dd class="font-medium">
                                New York, NY. Working with clients across the US.
                            </dd>
                        </div>
                    </dl>

                    <p class="mt-8 text-ink-muted leading-relaxed">
                        We're here to answer your questions and discuss your
                        next project. Typical response time is under 24 hours.
                    </p>
                </aside>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12">
                <div class="col-span-12 md:col-span-6">
                    <div class="flex items-center gap-3 mb-5">
                        <span aria-hidden class="inline-block w-8 h-px bg-ink"
                        ></span>
                        <span
                            class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted"
                            >FAQ</span
                        >
                    </div>
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Common questions.
                    </h2>
                </div>
            </div>

            <div class="border-t border-ink">
                <details class="group border-b border-ink">
                    <summary
                        class="flex items-start justify-between gap-4 py-6 cursor-pointer list-none"
                    >
                        <h3
                            class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight"
                        >
                            How long does a typical project take?
                        </h3>
                        <span
                            aria-hidden
                            class="font-mono text-2xl leading-none pt-1 transition-transform group-open:rotate-45"
                            >+</span
                        >
                    </summary>
                    <p class="pb-6 text-ink-muted leading-relaxed max-w-3xl">
                        Project timelines vary based on scope and complexity. A
                        simple website might take 2–4 weeks, while a complex web
                        application could take 3–6 months. We'll provide a
                        detailed timeline during our initial consultation.
                    </p>
                </details>

                <details class="group border-b border-ink">
                    <summary
                        class="flex items-start justify-between gap-4 py-6 cursor-pointer list-none"
                    >
                        <h3
                            class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight"
                        >
                            What is your development process?
                        </h3>
                        <span
                            aria-hidden
                            class="font-mono text-2xl leading-none pt-1 transition-transform group-open:rotate-45"
                            >+</span
                        >
                    </summary>
                    <p class="pb-6 text-ink-muted leading-relaxed max-w-3xl">
                        We work in short iterations with regular check-ins, moving through discovery, design, development, testing, and deployment. You stay involved throughout.
                    </p>
                </details>

                <details class="group border-b border-ink">
                    <summary
                        class="flex items-start justify-between gap-4 py-6 cursor-pointer list-none"
                    >
                        <h3
                            class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight"
                        >
                            Do you provide ongoing support?
                        </h3>
                        <span
                            aria-hidden
                            class="font-mono text-2xl leading-none pt-1 transition-transform group-open:rotate-45"
                            >+</span
                        >
                    </summary>
                    <p class="pb-6 text-ink-muted leading-relaxed max-w-3xl">
                        Yes. We offer maintenance and support packages to keep
                        your application running smoothly: bug fixes, updates, security patches, and new features as needed.
                    </p>
                </details>

                <details class="group border-b border-ink">
                    <summary
                        class="flex items-start justify-between gap-4 py-6 cursor-pointer list-none"
                    >
                        <h3
                            class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight"
                        >
                            What technologies do you work with?
                        </h3>
                        <span
                            aria-hidden
                            class="font-mono text-2xl leading-none pt-1 transition-transform group-open:rotate-45"
                            >+</span
                        >
                    </summary>
                    <p class="pb-6 text-ink-muted leading-relaxed max-w-3xl">
                        We specialize in modern web technologies including
                        React, Next.js, Node.js, Python, and cloud platforms
                        like AWS and Azure. We pick the stack that fits the project.
                    </p>
                </details>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    /* Result banner. Was appearing the instant `hidden` came off, shoving the
       submit button down with no bridge. display + allow-discrete lets the
       entrance animate out of display:none without JS. Never scale(0). */
    [data-form-success],
    [data-form-error] {
        opacity: 1;
        scale: 1;
        transition:
            opacity 200ms var(--ease-out),
            scale 200ms var(--ease-out),
            display 200ms allow-discrete;
    }

    @starting-style {
        [data-form-success],
        [data-form-error] {
            opacity: 0;
            scale: 0.98;
        }
    }

    /* Submit morph. Label text, spinner and arrow all changed in the same
       frame, mid-button, at the moment the user is watching hardest. The blur
       bridges them so the eye reads one morph instead of three teleports.
       2px — heavy blur is expensive in Safari. */
    [data-submit-button] > * {
        transition:
            opacity 160ms var(--ease-out),
            filter 160ms var(--ease-out);
    }

    [data-submit-button][data-swapping] > * {
        opacity: 0.6;
        filter: blur(2px);
    }

    @media (prefers-reduced-motion: reduce) {
        [data-submit-button][data-swapping] > * {
            filter: none;
        }
    }
</style>

<script type="module">
    const form = document.querySelector("[data-contact-form]");
    const submitButton = form?.querySelector("[data-submit-button]");
    const loader = form?.querySelector("[data-submit-loader]");
    const submitIcon = form?.querySelector("[data-submit-icon]");
    const submitLabel = form?.querySelector("[data-submit-label]");
    const successMessage = form?.querySelector("[data-form-success]");
    const errorMessage = form?.querySelector("[data-form-error]");
    const successText = form?.dataset.successMessage ?? "Message sent!";
    const errorText = form?.dataset.errorMessage ?? "Please try again.";

    const setSubmittingState = (isSubmitting) => {
        if (!submitButton) return;
        // Disable immediately — double-submit protection can't wait on a beat.
        if (isSubmitting) submitButton.setAttribute("disabled", "true");

        // Everything else changes at the blur's peak, so the three swaps read
        // as one morph. 120ms into a 160ms blur.
        submitButton.dataset.swapping = "";
        window.setTimeout(() => {
            if (isSubmitting) {
                loader?.classList.remove("hidden");
                submitIcon?.classList.add("hidden");
                if (submitLabel) submitLabel.textContent = "Sending...";
            } else {
                submitButton.removeAttribute("disabled");
                loader?.classList.add("hidden");
                submitIcon?.classList.remove("hidden");
                if (submitLabel) submitLabel.textContent = "Send Message";
            }
            delete submitButton.dataset.swapping;
        }, 120);
    };

    const clearMessages = () => {
        successMessage?.classList.add("hidden");
        errorMessage?.classList.add("hidden");
    };

    const showMessage = (type, text) => {
        if (!text) return;
        if (type === "success") {
            if (successMessage) {
                successMessage.textContent = text;
                successMessage.classList.remove("hidden");
            }
            errorMessage?.classList.add("hidden");
        } else {
            if (errorMessage) {
                errorMessage.textContent = text;
                errorMessage.classList.remove("hidden");
            }
            successMessage?.classList.add("hidden");
        }
    };

    form?.addEventListener("submit", async (event) => {
        if (!form.checkValidity()) {
            event.preventDefault();
            form.reportValidity();
            return;
        }

        event.preventDefault();
        clearMessages();
        setSubmittingState(true);

        try {
            const formData = new FormData(form);
            const response = await fetch("https://api.web3forms.com/submit", {
                method: "POST",
                body: formData,
            });

            const result = await response.json();

            if (response.ok && result.success) {
                form.reset();
                showMessage("success", successText);
            } else {
                showMessage("error", result.message ?? errorText);
            }
        } catch (error) {
            showMessage("error", errorText);
        } finally {
            setSubmittingState(false);
        }
    });
</script>

