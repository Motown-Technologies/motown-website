---
import BaseLayout from "../layouts/BaseLayout.astro";

import MarketingIcon from "../components/icons/MarketingIcon.astro";
import WebIcon from "../components/icons/WebIcon.astro";
import SoftwareIcon from "../components/icons/SoftwareIcon.astro";
import ShieldIcon from "../components/icons/ShieldIcon.astro";
import SendIcon from "../components/icons/SendIcon.astro";
import AnalyticsIcon from "../components/icons/AnalyticsIcon.astro";
import ApiIcon from "../components/icons/ApiIcon.astro";
import CloudIcon from "../components/icons/CloudIcon.astro";
import AiIcon from "../components/icons/AiIcon.astro";
import DatabaseIcon from "../components/icons/DatabaseIcon.astro";
import MailIcon from "../components/icons/MailIcon.astro";

// The customer journey in the hero — every place a sale is won or lost.
const journey = [
    { title: "Discovery & Search", icon: MarketingIcon },
    { title: "Product Experience", icon: WebIcon },
    { title: "Cart & Checkout", icon: SoftwareIcon },
    { title: "Payments", icon: ShieldIcon },
    { title: "Fulfilment", icon: SendIcon },
    { title: "Retention & Data", icon: AnalyticsIcon },
];

// What we actually build.
const built = [
    {
        title: "Storefront",
        icon: WebIcon,
        desc: "A storefront that looks like your brand rather than a theme, and renders fast enough that nobody leaves before it finishes.",
    },
    {
        title: "Product Discovery",
        icon: MarketingIcon,
        desc: "Search that survives typos, filters people can actually use, and merchandising rules you control without a developer.",
    },
    {
        title: "Checkout",
        icon: SoftwareIcon,
        desc: "Fewer steps, guest checkout, saved addresses, and the wallets your customers already have set up on their phone.",
    },
    {
        title: "Operations",
        icon: ApiIcon,
        desc: "Inventory, orders, and product data synced with the ERP, PIM, or spreadsheet the business actually runs on.",
    },
    {
        title: "Performance",
        icon: CloudIcon,
        desc: "Core Web Vitals treated as a revenue metric, with image pipelines, caching, and edge delivery tuned for real mobile connections.",
    },
    {
        title: "Personalization",
        icon: AiIcon,
        desc: "Recommendations, segments, and lifecycle flows that use your order history instead of a generic bestseller list.",
    },
];

// The systems a store has to talk to.
const wired = [
    { title: "Payments", icon: ShieldIcon, desc: "Cards, wallets, BNPL, and the fraud rules behind them." },
    { title: "Shipping", icon: SendIcon, desc: "Rates, labels, tracking, and self-serve returns." },
    { title: "Inventory", icon: DatabaseIcon, desc: "Real-time stock across store, warehouse, and marketplace." },
    { title: "Email & CRM", icon: MailIcon, desc: "Abandoned cart, lifecycle, and post-purchase flows." },
    { title: "Analytics", icon: AnalyticsIcon, desc: "Funnel, cohort, and margin data you can act on." },
];

// The four numbers an ecommerce build should move.
const metrics = [
    {
        label: "LCP",
        title: "Load Time",
        desc: "Measured on a mid-range phone on mobile data, not on your laptop on office wifi.",
    },
    {
        label: "CVR",
        title: "Conversion Rate",
        desc: "Tracked per step, so you can see which screen loses people.",
    },
    {
        label: "AOV",
        title: "Order Value",
        desc: "Raised through bundling, thresholds, and recommendations, without touching prices.",
    },
    {
        label: "RPR",
        title: "Repeat Rate",
        desc: "What post-purchase, returns, and lifecycle email are actually for.",
    },
];

// Where carts die.
const leaks = [
    {
        before: "Four seconds to first paint on a phone",
        after: "Sub-second render on the connection people actually have",
    },
    {
        before: "Six-step checkout behind a forced account",
        after: "Guest checkout, saved wallets, two steps to done",
    },
    {
        before: "Search returns nothing when someone mistypes",
        after: "Typo-tolerant search with merchandising you control",
    },
    {
        before: "Stock goes wrong the moment two people buy at once",
        after: "Real-time inventory across every channel you sell on",
    },
    {
        before: "Post-purchase is a receipt and then silence",
        after: "Tracking, self-serve returns, and a reason to come back",
    },
];
---

<BaseLayout
    meta_title="Custom Ecommerce Development | Motown Solutions"
    meta_description="Custom ecommerce development: fast storefronts, better product search, shorter checkout, and the inventory, payment, and fulfilment integrations behind them."
>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b-2 border-ink">
        <!-- Contour-line decoration -->
        <svg
            aria-hidden
            class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.12] text-ink"
            viewBox="0 0 1200 700"
            preserveAspectRatio="xMidYMid slice"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
        >
            <path d="M-50 520 Q 200 440 430 490 T 880 470 T 1260 440" />
            <path d="M-50 580 Q 200 500 430 550 T 880 530 T 1260 500" />
            <path d="M-50 640 Q 200 560 430 610 T 880 590 T 1260 560" />
            <path d="M-50 460 Q 200 380 430 430 T 880 410 T 1260 380" />
            <path d="M-50 400 Q 200 320 430 370 T 880 350 T 1260 320" />
        </svg>

        <div class="relative max-w-7xl mx-auto px-6 pt-16 md:pt-24 pb-20 md:pb-28">
            <div class="grid grid-cols-12 gap-6">
                <div class="col-span-12 lg:col-span-7">

                    <h1
                        class="font-display font-bold text-hero text-ink text-balance"
                    >
                        Ecommerce storefronts that finish the <span class="italic text-accent">sale</span>.
                    </h1>

                    <p
                        class="mt-10 text-lg md:text-xl text-ink-muted leading-relaxed text-pretty max-w-xl"
                    >
                        Traffic is the expensive part. Most stores buy it and
                        then lose it to a slow product page, a search box that
                        can't handle a typo, or a checkout that asks for an
                        account. We build the experience between the click and
                        the confirmation.
                    </p>

                    <div class="mt-10 flex flex-wrap gap-3">
                        <a
                            href="/contact"
                            class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-ink transition-colors"
                        >
                            Start a store build
                            <span
                                class="transition-transform group-hover:translate-x-0.5"
                                aria-hidden>→</span
                            >
                        </a>
                        <a
                            href="#built"
                            class="inline-flex items-center gap-2 bg-transparent text-ink font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-ink hover:bg-ink hover:text-paper transition-colors"
                        >
                            What we build
                        </a>
                    </div>
                </div>

                <!-- The customer journey -->
                <div class="col-span-12 lg:col-span-5 mt-12 lg:mt-0">
                    <div
                        class="border-2 border-ink bg-paper-2 lg:translate-y-2"
                        data-reveal
                    >
                        <div
                            class="flex items-center justify-between px-5 py-3 border-b-2 border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted"
                        >
                            <span>Your Store / Journey</span>
                            <span aria-hidden class="text-accent">● converting</span>
                        </div>
                        {
                            journey.map((step, i) => {
                                const Icon = step.icon;
                                return (
                                    <div
                                        class:list={[
                                            "flex items-center gap-4 px-5 py-4",
                                            i !== journey.length - 1 &&
                                                "border-b border-ink/30",
                                        ]}
                                    >
                                        <span class="font-mono text-[11px] text-ink-muted w-6 shrink-0">
                                            0{i + 1}
                                        </span>
                                        <span class="w-9 h-9 shrink-0 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                            <Icon class="w-5 h-5" />
                                        </span>
                                        <span class="font-display font-bold tracking-tight text-lg leading-none">
                                            {step.title}
                                        </span>
                                    </div>
                                );
                            })
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Metadata strip -->
        <div class="relative border-t border-ink/40 bg-paper">
            <div
                class="max-w-7xl mx-auto px-6 py-5 flex flex-wrap items-center justify-between gap-x-8 gap-y-2 font-mono text-[11px] md:text-xs uppercase tracking-eyebrow text-ink-muted"
            >
                <span>Storefront</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Discovery</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Checkout</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Operations</span>
                <span class="hidden md:inline" aria-hidden>·</span>
                <span>Retention</span>
            </div>
        </div>
    </section>

    <!-- What we build -->
    <section id="built" class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Every screen
                        <br />
                        between click and card.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        We work on the platform you're already on, or help you
                        pick one that won't need replacing in two years. Either way the experience layer is custom, because that's the part customers judge you on.
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 border border-ink"
            >
                {
                    built.map((item) => {
                        const Icon = item.icon;
                        return (
                            <div class="p-8 md:p-10 border-ink border-b border-r last:border-b-0 md:[&:nth-last-child(-n+2)]:border-b-0 lg:[&:nth-last-child(-n+3)]:border-b-0 md:[&:nth-child(even)]:border-r-0 lg:[&:nth-child(3n)]:border-r-0 lg:[&:nth-child(even)]:border-r">
                                <div class="flex items-center gap-4 mb-6">
                                    <span class="w-10 h-10 border-[1.5px] border-ink flex items-center justify-center">
                                        <Icon />
                                    </span>
                                </div>
                                <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                    {item.title}
                                </h3>
                                <p class="text-ink-muted leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Wired in -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-7">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        The store is
                        <br />
                        only the front.
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:self-end text-ink-muted text-lg leading-relaxed"
                >
                    A sale touches half a dozen systems before it's really done.
                    We connect them so your team isn't reconciling orders by
                    hand at the end of every week.
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 border border-ink">
                {
                    wired.map((item) => {
                        const Icon = item.icon;
                        return (
                            <div class="p-7 md:p-8 border-ink border-b sm:border-r last:border-b-0 sm:[&:nth-child(even)]:border-r-0 lg:[&:not(:last-child)]:border-r lg:[&:nth-child(even)]:border-r lg:[&:nth-last-child(-n+1)]:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0">
                                <span class="w-10 h-10 mb-5 border-[1.5px] border-ink flex items-center justify-center bg-paper">
                                    <Icon />
                                </span>
                                <h3 class="font-display text-xl font-bold tracking-tight leading-tight mb-2">
                                    {item.title}
                                </h3>
                                <p class="text-sm text-ink-muted leading-relaxed">
                                    {item.desc}
                                </p>
                            </div>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- The four numbers -->
    <section class="py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Four numbers.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        We agree on the baseline before we start and report
                        against it after launch. Design opinions are cheap; these
                        are the things that decide whether the build paid for
                        itself.
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border border-ink">
                {
                    metrics.map((m) => (
                        <div class="p-8 md:p-10 border-ink border-b sm:border-r last:border-b-0 sm:[&:nth-child(even)]:border-r-0 lg:[&:not(:last-child)]:border-r lg:[&:nth-child(even)]:border-r lg:[&:nth-last-child(-n+1)]:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0">
                            <div class="font-mono text-xs uppercase tracking-eyebrow text-accent mb-6">
                                {m.label}
                            </div>
                            <h3 class="font-display text-2xl font-bold tracking-tight leading-tight mb-3">
                                {m.title}
                            </h3>
                            <p class="text-sm text-ink-muted leading-relaxed">
                                {m.desc}
                            </p>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Where carts die -->
    <section class="border-t-2 border-ink py-20 md:py-28" data-reveal>
        <div class="max-w-7xl mx-auto px-6">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-6">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Same traffic.
                        <br />
                        More orders.
                    </h2>
                </div>
                <div class="col-span-12 md:col-span-5 md:col-start-8 md:self-end">
                    <p
                        class="text-base md:text-lg text-ink-muted leading-relaxed text-pretty"
                    >
                        Almost every store we look at is leaking in the same five
                        places. None of them are design problems, which is why
                        redesigns so rarely fix them.
                    </p>
                </div>
            </div>

            <div class="border-t border-ink">
                <div
                    class="hidden md:grid grid-cols-12 gap-8 py-4 border-b border-ink font-mono text-[11px] uppercase tracking-eyebrow text-ink-muted"
                >
                    <span class="col-span-6">The leak</span>
                    <span class="col-span-6">What we build instead</span>
                </div>
                {
                    leaks.map((row) => (
                        <div class="grid grid-cols-12 gap-4 md:gap-8 items-center py-7 border-b border-ink">
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3 text-ink-muted">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px]"
                                >
                                    ×
                                </span>
                                <span class="leading-relaxed line-through decoration-ink/30">
                                    {row.before}
                                </span>
                            </div>
                            <div class="col-span-12 md:col-span-6 flex items-start gap-3">
                                <span
                                    aria-hidden
                                    class="font-mono text-lg leading-none mt-[2px] text-accent"
                                >
                                    →
                                </span>
                                <span class="font-medium leading-relaxed">
                                    {row.after}
                                </span>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Specialisms -->
    <section class="border-t-2 border-ink bg-paper-2" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-20 md:py-28">
            <div class="grid grid-cols-12 gap-6 mb-12 md:mb-16">
                <div class="col-span-12 md:col-span-7">
                    <h2
                        class="font-display font-bold text-h2 tracking-tight text-balance"
                    >
                        Two ways
                        <br />
                        we build it.
                    </h2>
                </div>
                <div
                    class="col-span-12 md:col-span-5 md:self-end text-ink-muted text-lg leading-relaxed"
                >
                    Most projects land in one of these. Which one depends on
                    what the platform is stopping you doing, and how much front end your team wants to own.
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 border border-ink">
                {
                    [
                        {
                            title: "Shopify Development",
                            href: "/shopify-development",
                            lede: "You're on Shopify and the theme has run out.",
                            desc: "Custom themes, private apps, Shopify Functions, checkout extensions, and the integrations behind them.",
                        },
                        {
                            title: "Headless Commerce",
                            href: "/headless-commerce-development",
                            lede: "The platform's front end is the constraint.",
                            desc: "A decoupled storefront over your existing commerce engine, with the trade-offs spelled out before you commit.",
                        },
                    ].map((route, i) => (
                        <a
                            href={route.href}
                            class="group flex flex-col p-8 md:p-10 border-ink border-b lg:border-b-0 lg:border-r last:border-b-0 lg:last:border-r-0 bg-paper hover:bg-ink hover:text-paper transition-colors"
                        >
                            <span class="font-mono text-[11px] text-ink-muted group-hover:text-paper/60 block mb-6">
                                0{i + 1}
                            </span>
                            <h3 class="font-display text-2xl md:text-3xl font-bold tracking-tight leading-tight mb-3">
                                {route.title}
                            </h3>
                            <p class="font-medium leading-relaxed mb-2">
                                {route.lede}
                            </p>
                            <p class="text-ink-muted group-hover:text-paper/70 leading-relaxed mb-8">
                                {route.desc}
                            </p>
                            <span class="mt-auto font-mono text-xs uppercase tracking-[0.15em] inline-flex items-center gap-2">
                                Read more
                                <span
                                    class="transition-transform group-hover:translate-x-0.5"
                                    aria-hidden
                                >
                                    →
                                </span>
                            </span>
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Final CTA -->
    <section class="section-ink border-t-2 border-ink" data-reveal>
        <div class="max-w-7xl mx-auto px-6 py-24 md:py-36 flex flex-col items-start">
            <h2
                class="font-display font-bold text-display text-paper text-balance mb-10 max-w-5xl leading-[0.95]"
            >
                Sell more on the
                <span class="italic text-accent">same traffic</span>.
            </h2>
            <p class="text-lg md:text-xl text-paper/70 max-w-xl mb-10">
                Send us your store and your numbers. We'll come back with where
                it's leaking, what we'd rebuild first, and what that's worth at
                your current volume.
            </p>
            <div class="flex flex-wrap gap-3 mb-12">
                <a
                    href="/contact"
                    class="group inline-flex items-center gap-2 bg-accent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-accent hover:bg-paper hover:text-ink hover:border-paper transition-colors"
                >
                    Start a store build
                    <span
                        class="transition-transform group-hover:translate-x-0.5"
                        aria-hidden>→</span
                    >
                </a>
                <a
                    href="/services"
                    class="inline-flex items-center gap-2 bg-transparent text-paper font-mono text-xs uppercase tracking-[0.15em] px-6 py-4 border-2 border-paper hover:bg-paper hover:text-ink transition-colors"
                >
                    View All Services
                </a>
            </div>

            <!-- Contact strip -->
            <div
                class="w-full border-t border-paper/20 pt-8 flex flex-wrap items-center gap-x-10 gap-y-3 font-mono text-xs uppercase tracking-eyebrow text-paper/60"
            >
                <a
                    href="https://motowntech.com"
                    class="link-underline text-paper"
                    >motowntech.com</a
                >
                <a href="tel:+18459252661" class="link-underline text-paper"
                    >845-925-2661</a
                >
            </div>
        </div>
    </section>
</BaseLayout>
