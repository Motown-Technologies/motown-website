---
import { ClientRouter } from "astro:transitions";
import { Navigation } from "../components/Navigation";
import logo from "../img/logo.png";

import "../styles/global.css";

import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";

const { meta_title, meta_description, noindex, og_type = "website", og_image } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(og_image ?? "/images/modern-technology-workspace-with-multiple-monitors.jpg", Astro.site);
const organization = {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Motown Solutions",
    url: "https://motowntech.com",
    logo: new URL(logo.src, Astro.site).href,
    description:
        "Motown Solutions builds custom software, AI systems, websites, mobile apps, and automation tools, and advises on the technology strategy behind them.",
    email: "contact@motowntech.com",
    telephone: "+1-845-925-2661",
    contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        email: "contact@motowntech.com",
        telephone: "+1-845-925-2661",
        url: "https://motowntech.com/contact",
    },
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{meta_title}</title>
<meta name="description" content={meta_description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" href="/favicon.png" />
<meta property="og:type" content={og_type} />
<meta property="og:site_name" content="Motown Solutions" />
<meta property="og:title" content={meta_title} />
<meta property="og:description" content={meta_description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
{noindex && <meta name="robots" content="noindex" />}
<slot name="head" />
        <ClientRouter />
        <style is:global>
            :root {
                color-scheme: light;
            }

            html {
                background-color: #f5f2ea;
            }

            body {
                font-feature-settings: "ss01", "cv11";
            }

            ::selection {
                background-color: #0b0b0c;
                color: #f5f2ea;
            }

            .section-ink {
                background-color: #0b0b0c;
                color: #f5f2ea;
            }

            .section-ink .text-ink {
                color: #f5f2ea;
            }

            .section-ink .text-ink-muted {
                color: #a1a1a6;
            }

            .section-ink .border-ink {
                border-color: #f5f2ea;
            }

            .section-ink .bg-paper,
            .section-ink .bg-paper-2 {
                background-color: #0b0b0c;
            }

            @media (hover: hover) and (pointer: fine) {
                .section-ink .hover\:bg-ink:hover {
                    background-color: #f5f2ea;
                    color: #0b0b0c;
                }
            }

            /* Scroll reveal: initial hidden state, revealed via data attr.
               Entrances use ease-out — `ease` delays the first frame, which is
               the frame being watched. No will-change: these are full sections,
               and a permanent compositor layer costs more than an 8px fade. */
            [data-reveal] {
                opacity: 0;
                transform: translateY(8px);
                transition:
                    opacity 400ms var(--ease-out),
                    transform 400ms var(--ease-out);
            }

            [data-reveal].is-revealed {
                opacity: 1;
                transform: none;
            }

            @media (prefers-reduced-motion: reduce) {
                [data-reveal] {
                    opacity: 1;
                    transform: none;
                    transition: none;
                }
            }

            /* Press feedback. Every pressable thing must confirm it heard the
               user; the site had 700+ hover states and no active state.
               Matches the CTA signature (inline-flex + border-2) plus real
               interactive elements. */
            button,
            summary,
            a[class*="inline-flex"][class*="border-2"] {
                transition: transform 160ms var(--ease-out);
            }

            button:active,
            summary:active,
            a[class*="inline-flex"][class*="border-2"]:active {
                transform: scale(0.97);
            }

            @media (prefers-reduced-motion: reduce) {
                button,
                summary,
                a[class*="inline-flex"][class*="border-2"] {
                    transition: none;
                }
                button:active,
                summary:active,
                a[class*="inline-flex"][class*="border-2"]:active {
                    transform: none;
                }
            }

            /* Mobile panel rows. The global press scale is wrong for a
               full-width list row; opacity is the honest signal and it is
               one of the properties reduced motion keeps. */
            [data-mobile-nav] a,
            [data-mobile-nav] button {
                transition: opacity 100ms var(--ease-out);
            }

            [data-mobile-nav] a:active,
            [data-mobile-nav] button:active {
                opacity: 0.6;
                transform: none;
            }

            /* Link underline draw — used on nav and inline links */
            .link-underline {
                background-image: linear-gradient(currentColor, currentColor);
                background-size: 0% 1.5px;
                background-repeat: no-repeat;
                background-position: 0 100%;
                transition: background-size 220ms ease;
            }

            .link-underline:focus-visible {
                background-size: 100% 1.5px;
            }

            @media (hover: hover) and (pointer: fine) {
                .link-underline:hover {
                    background-size: 100% 1.5px;
                }
            }

            @media (prefers-reduced-motion: reduce) {
                .link-underline {
                    transition: none;
                }
            }

            /* FAQ disclosure. The +/x already rotated over 150ms while the
               answer it controls snapped open — half-animated reads worse than
               not animated. Height is the sanctioned exception for accordions;
               there is no transform equivalent. */
            :root {
                interpolate-size: allow-keywords;
            }

            details::details-content {
                block-size: 0;
                overflow: hidden;
                transition:
                    block-size 250ms var(--ease-out),
                    content-visibility 250ms allow-discrete;
            }

            details[open]::details-content {
                block-size: auto;
            }

            @media (prefers-reduced-motion: reduce) {
                details::details-content {
                    transition: none;
                }
            }

            /* Reduced motion: movement off, colour and opacity on. Transforms
               still land, they just arrive instead of travelling — which is
               right for a 2px lift and wrong for the row wipe, so that one
               becomes a fade below. */
            @media (prefers-reduced-motion: reduce) {
                *,
                *::before,
                *::after {
                    transition-property: opacity, color, background-color,
                        border-color, fill, stroke, box-shadow !important;
                }

                [data-sweep] {
                    scale: 1 1 !important;
                    opacity: 0;
                    transition: opacity 200ms ease !important;
                }

                .group:focus-within [data-sweep] {
                    opacity: 1;
                }

                .group:active [data-sweep] {
                    opacity: 1;
                }

                @media (hover: hover) and (pointer: fine) {
                    .group:hover [data-sweep] {
                        opacity: 1;
                    }
                }
            }
        </style>
    </head>
    <body class="font-sans bg-paper text-ink antialiased">
        <Navigation client:load />
        <slot />
        <!-- Footer -->
        <footer class="border-t-2 border-ink bg-paper">
            <div class="max-w-7xl mx-auto px-6 py-16">
                <div class="grid gap-10 grid-cols-2 md:grid-cols-12 lg:grid-cols-10">
                    <div class="col-span-2 md:col-span-12 lg:col-span-10">
                        <div class="font-display text-4xl md:text-5xl font-bold leading-none tracking-tight mb-4">
                            Motown Solutions
                        </div>
                        <p class="text-ink-muted max-w-md leading-relaxed">
                            Where ideas become reality. Custom software, web,
                            mobile, automation, and consulting for teams with
                            ambition.
                        </p>
                    </div>
                    <div class="col-span-1 md:col-span-4 lg:col-span-2">
                        <div class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted mb-4">
                            — Sitemap
                        </div>
                        <ul class="space-y-2">
                            <li>
                                <a
                                    href="/"
                                    class="link-underline font-medium"
                                    >Home</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/about"
                                    class="link-underline font-medium"
                                    >About</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/services"
                                    class="link-underline font-medium"
                                    >Services</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/case-studies"
                                    class="link-underline font-medium"
                                    >Case Studies</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/blog"
                                    class="link-underline font-medium"
                                    >Blog</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/contact"
                                    class="link-underline font-medium"
                                    >Contact</a
                                >
                            </li>
                        </ul>
                    </div>
                    <div class="col-span-1 md:col-span-4 lg:col-span-2">
                        <div class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted mb-4">
                            — Services
                        </div>
                        <ul class="space-y-2">
                            <li>
                                <a
                                    href="/services/software-development"
                                    class="link-underline font-medium"
                                    >Software</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/services/ai-development"
                                    class="link-underline font-medium"
                                    >AI</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/services/web-design"
                                    class="link-underline font-medium"
                                    >Web</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/services/mobile-development"
                                    class="link-underline font-medium"
                                    >Mobile</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/services/automation"
                                    class="link-underline font-medium"
                                    >Automation</a
                                >
                            </li>
                            <li>
                                <a
                                    href="/services/consulting"
                                    class="link-underline font-medium"
                                    >Consulting</a
                                >
                            </li>
                        </ul>
                    </div>
                    <div class="col-span-2 md:col-span-4 lg:col-span-2">
                        <div class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted mb-4">
                            — What We Build
                        </div>
                        <ul class="space-y-2">
                            {
                                [
                                    ["/startup-consulting", "Startup Consulting"],
                                    ["/mvp-development", "MVP Development"],
                                    ["/fractional-cto", "Fractional CTO"],
                                    [
                                        "/technical-due-diligence",
                                        "Technical Due Diligence",
                                    ],
                                    [
                                        "/prototype-to-production",
                                        "Prototype to Production",
                                    ],
                                    ["/spreadsheet-to-app", "Spreadsheet to App"],
                                    ["/migrate-from-wordpress", "WordPress Migration"],
                                    [
                                        "/ecommerce-development",
                                        "Ecommerce Development",
                                    ],
                                    ["/shopify-development", "Shopify Development"],
                                    ["/cloud-migration-services", "Cloud Migration"],
                                    [
                                        "/headless-commerce-development",
                                        "Headless Commerce",
                                    ],
                                ].map(([href, label]) => (
                                    <li>
                                        <a
                                            href={href}
                                            class="link-underline font-medium"
                                        >
                                            {label}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                    <div class="col-span-2 md:col-span-4 lg:col-span-2">
                        <a
                            href="/case-studies"
                            class="link-underline block font-mono text-xs uppercase tracking-eyebrow text-ink-muted mb-4"
                        >
                            — Case Studies
                        </a>
                        <ul class="space-y-2">
                            {
                                [
                                    [
                                        "/case-studies/healthcare-practice",
                                        "Multi-Site Healthcare Practice",
                                    ],
                                    [
                                        "/case-studies/auction-operations",
                                        "Auction House Operations",
                                    ],
                                    [
                                        "/case-studies/senior-care-concierge",
                                        "Senior Care Concierge",
                                    ],
                                    [
                                        "/case-studies/endoscopy-center",
                                        "Headless WordPress Rebuild",
                                    ],
                                    [
                                        "/case-studies/nonprofit-community",
                                        "Nonprofit Community Platform",
                                    ],
                                    [
                                        "/case-studies/donation-platform",
                                        "Multi-Tenant Donation Platform",
                                    ],
                                ].map(([href, label]) => (
                                    <li>
                                        <a
                                            href={href}
                                            class="link-underline font-medium"
                                        >
                                            {label}
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
                <div class="mt-14 pt-6 border-t border-ink/20 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
                    <p class="font-mono text-xs uppercase tracking-eyebrow text-ink-muted">
                        &copy; 2025 Motown Solutions — Where Ideas Become Reality
                    </p>
                    <div class="flex items-center gap-5 font-mono text-xs uppercase tracking-eyebrow text-ink-muted">
                        <a href="/terms" class="link-underline">Terms</a>
                        <span aria-hidden>·</span>
                        <a href="/privacy" class="link-underline">Privacy</a>
                    </div>
                </div>
            </div>
        </footer>

        <script is:inline>
            (() => {
                const reveal = () => {
                    const els = document.querySelectorAll("[data-reveal]");
                    if (!("IntersectionObserver" in window)) {
                        els.forEach((el) => el.classList.add("is-revealed"));
                        return;
                    }
                    const io = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add("is-revealed");
                                    io.unobserve(entry.target);
                                }
                            });
                        },
                        { threshold: 0, rootMargin: "0px 0px -40px 0px" },
                    );
                    els.forEach((el) => io.observe(el));
                };
                reveal();
                document.addEventListener("astro:page-load", reveal);
            })();
        </script>
    </body>
</html>
