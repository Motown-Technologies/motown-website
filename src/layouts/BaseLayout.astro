            </div>
        </footer>

        <script is:inline>
            (() => {
                const reveal = () => {
                    const els = document.querySelectorAll("[data-reveal]");
                    if (!("IntersectionObserver" in window)) {
                        els.forEach((el) => el.classList.add("is-revealed"));
                        return;
                    }
                    const io = new IntersectionObserver(
                        (entries) => {
                            entries.forEach((entry) => {
                                if (entry.isIntersecting) {
                                    entry.target.classList.add("is-revealed");
                                    io.unobserve(entry.target);
                                }
                            });
                        },
                        { threshold: 0, rootMargin: "0px 0px -40px 0px" },
                    );
                    els.forEach((el) => io.observe(el));
                };
                reveal();
                document.addEventListener("astro:page-load", reveal);
            })();
        </script>

        <!-- Hero step panels: highlight one row at a time, 1.6s each, only
             while the panel is on screen. Skipped under reduced motion,
             where the rows stay as they are. -->
        <script is:inline>
            (() => {
                // Registered once even if this inline script runs again
                // after a ClientRouter swap; timers are cleared per page.
                if (window.__motownSteps) return;
                window.__motownSteps = true;
                const STEP_MS = 1600;
                let cleanups = [];
                const stop = () => {
                    cleanups.forEach((f) => f());
                    cleanups = [];
                };
                const start = () => {
                    stop();
                    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
                    const panels = new Set([...document.querySelectorAll("[data-step]")].map((r) => r.parentElement));
                    panels.forEach((panel) => {
                        const rows = [...panel.querySelectorAll(":scope > [data-step]")];
                        let i = 0;
                        let timer = 0;
                        const tick = () => {
                            rows.forEach((r, k) => r.toggleAttribute("data-active", k === i));
                            i = (i + 1) % rows.length;
                        };
                        const io = new IntersectionObserver(([entry]) => {
                            clearInterval(timer);
                            if (entry.isIntersecting) {
                                tick();
                                timer = setInterval(() => document.hidden || tick(), STEP_MS);
                            }
                        });
                        io.observe(panel);
                        cleanups.push(() => {
                            clearInterval(timer);
                            io.disconnect();
                        });
                    });
                };
                // astro:page-load fires on the first load and after every swap.
                document.addEventListener("astro:page-load", start);
                document.addEventListener("astro:before-swap", stop);
            })();
        </script>

        <!-- Visit path for the contact form. Kept in this tab's sessionStorage
             (no cookies) and only leaves the browser if the visitor submits
             the form, which adds it as extra fields. The ClientRouter swaps
             pages without reloads, so document.referrer only covers the
             landing page; the path has to be recorded here. -->
        <script is:inline data-journey>
            (() => {
                const KEY = "motown:journey";
                const read = () => {
                    try {
                        return JSON.parse(sessionStorage.getItem(KEY)) || null;
                    } catch {
                        return null;
                    }
                };
                const record = () => {
                    const j = read() || {};
                    if (!j.landing) {
                        const ref = document.referrer;
                        const params = new URLSearchParams(location.search);
                        j.landing = location.pathname + location.search;
                        j.referrer = ref && !ref.startsWith(location.origin) ? ref : "";
                        j.campaign = ["utm_source", "utm_medium", "utm_campaign"]
                            .filter((k) => params.get(k))
                            .map((k) => `${k}=${params.get(k)}`)
                            .join("&");
                        j.pages = [];
                        j.titles = {};
                    }
                    if (j.pages.at(-1) !== location.pathname) j.pages.push(location.pathname);
                    j.pages = j.pages.slice(-15);
                    j.titles[location.pathname] = document.title.replace(/ \| Motown Solutions$/, "");
                    try {
                        sessionStorage.setItem(KEY, JSON.stringify(j));
                    } catch {}
                };
                // "Case study: Auction Operations Platform" for a path and its title.
                const describe = (path, title = path) => {
                    const t = title.replace(/ Case Study$/, "");
                    if (path === "/") return "Home page";
                    if (path === "/blog" || /^\/blog\/\d+$/.test(path)) return "Blog index";
                    if (path.startsWith("/blog/")) return `Blog post: ${t}`;
                    if (path === "/case-studies") return "Case studies index";
                    if (path.startsWith("/case-studies/")) return `Case study: ${t}`;
                    if (path === "/services") return "Services overview";
                    if (path.startsWith("/services/")) return `Service: ${t}`;
                    const fixed = { "/about": "About page", "/contact": "Contact page", "/privacy": "Privacy policy", "/terms": "Terms of service" };
                    if (fixed[path]) return fixed[path];
                    return `Landing page: ${t}`;
                };
                // Extra form fields describing how the visitor got to the form.
                window.motownJourneyFields = () => {
                    const j = read();
                    if (!j) return {};
                    const before = j.pages.filter((p) => p !== location.pathname).at(-1);
                    return {
                        "Came from": before ? describe(before, j.titles?.[before]) : "(came straight to contact)",
                        "Landing page": j.landing,
                        "Referrer": j.referrer || "(direct or unknown)",
                        "Campaign": j.campaign || "(none)",
                        "Page before contact": before || "(came straight to contact)",
                        "Pages viewed": j.pages.join(" > "),
                    };
                };
                record();
                document.addEventListener("astro:page-load", record);
            })();
        </script>
    </body>
</html>
