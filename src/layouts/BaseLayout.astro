---
import { ClientRouter } from "astro:transitions";
import { Navigation } from "../components/Navigation";
import RelatedPosts from "../components/RelatedPosts.astro";
import logo from "../img/logo.png";

import "../styles/global.css";

import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";

const { meta_title, meta_description, noindex, og_type = "website", og_image } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(og_image ?? "/images/modern-technology-workspace-with-multiple-monitors.jpg", Astro.site);
const organization = {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Motown Solutions",
    url: "https://motowntech.com",
    logo: new URL(logo.src, Astro.site).href,
    description:
        "Motown Solutions builds custom software, AI systems, websites, mobile apps, and automation tools, and advises on the technology strategy behind them.",
    email: "contact@motowntech.com",
    telephone: "+1-845-925-2661",
    address: [
        {
            "@type": "PostalAddress",
            addressLocality: "New York",
            addressRegion: "NY",
            addressCountry: "US",
        },
        { "@type": "PostalAddress", addressRegion: "FL", addressCountry: "US" },
    ],
    areaServed: { "@type": "Country", name: "United States" },
    sameAs: ["https://www.linkedin.com/company/motown-solutions/"],
    contactPoint: {
        "@type": "ContactPoint",
        contactType: "sales",
        email: "contact@motowntech.com",
        telephone: "+1-845-925-2661",
        url: "https://motowntech.com/contact",
    },
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{meta_title}</title>
<meta name="description" content={meta_description} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/png" href="/favicon.png" />
<meta property="og:type" content={og_type} />
<meta property="og:site_name" content="Motown Solutions" />
<meta property="og:title" content={meta_title} />
<meta property="og:description" content={meta_description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
{noindex && <meta name="robots" content="noindex" />}
{import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js" />}
<slot name="head" />
        <ClientRouter />
        <style is:global>
            :root {
                color-scheme: light;
            }

            html {
                background-color: #f5f2ea;
            }

            body {
                font-feature-settings: "ss01", "cv11";
            }

            ::selection {
                background-color: #0b0b0c;
                color: #f5f2ea;
            }

            .section-ink {
                background-color: #0b0b0c;
                color: #f5f2ea;
            }

            .section-ink .text-ink {
                color: #f5f2ea;
            }

            .section-ink .text-ink-muted {
                color: #a1a1a6;
            }

            .section-ink .border-ink {
                border-color: #f5f2ea;
            }

            .section-ink .bg-paper,
            .section-ink .bg-paper-2 {
                background-color: #0b0b0c;
            }

            @media (hover: hover) and (pointer: fine) {
                .section-ink .hover\:bg-ink:hover {
                    background-color: #f5f2ea;
                    color: #0b0b0c;
                }
            }

            /* Scroll reveal: initial hidden state, revealed via data attr.
               Entrances use ease-out — `ease` delays the first frame, which is
               the frame being watched. No will-change: these are full sections,
               and a permanent compositor layer costs more than an 8px fade.
               Hidden only when scripting is on, since the script is what
               reveals it; without JS, or in a browser that doesn't know the
               query, content is simply visible. */
            @media (scripting: enabled) {
                [data-reveal] {
                    opacity: 0;
                    transform: translateY(8px);
                }
                [data-reveal]:not(.is-revealed) [data-stagger] > * {
                    opacity: 0;
                }
            }
            [data-reveal] {
                transition:
                    opacity 400ms var(--ease-out),
                    transform 400ms var(--ease-out);
            }

            [data-reveal].is-revealed {
                opacity: 1;
                transform: none;
            }

            /* Card grids inside a revealed section enter one card at a
               time, 50ms apart. An animation rather than a transition so it
               can't clobber the cards' own hover transitions. */
            @keyframes stagger-in {
                from {
                    opacity: 0;
                    translate: 0 8px;
                }
            }
            [data-reveal].is-revealed [data-stagger] > * {
                animation: stagger-in 400ms var(--ease-out) var(--stagger, 0ms) both;
            }
            [data-stagger] > :nth-child(2) { --stagger: 50ms; }
            [data-stagger] > :nth-child(3) { --stagger: 100ms; }
            [data-stagger] > :nth-child(4) { --stagger: 150ms; }
            [data-stagger] > :nth-child(5) { --stagger: 200ms; }
            [data-stagger] > :nth-child(6) { --stagger: 250ms; }
            [data-stagger] > :nth-child(n + 7) { --stagger: 300ms; }

            /* "● live": the dot breathes so the label reads as a live state. */
            @keyframes status-pulse {
                50% {
                    opacity: 0.3;
                }
            }
            .status-dot {
                display: inline-block;
                animation: status-pulse 2.4s ease infinite;
            }

            /* Hero step panels: a script walks data-active down the rows. */
            [data-step] {
                transition:
                    background-color 300ms ease,
                    box-shadow 300ms ease;
            }
            [data-step][data-active] {
                background-color: var(--color-paper);
                box-shadow: inset 3px 0 0 var(--color-accent);
            }

            @media (prefers-reduced-motion: reduce) {
                [data-stagger] > * {
                    animation: none !important;
                    opacity: 1 !important;
                }
                .status-dot {
                    animation: none;
                }
            }

            @media (prefers-reduced-motion: reduce) {
                [data-reveal] {
                    opacity: 1;
                    transform: none;
                    transition: none;
                }
            }

            /* Press feedback. Every pressable thing must confirm it heard the
               user; the site had 700+ hover states and no active state.
               Matches the CTA signature (inline-flex + border-2) plus real
               interactive elements. */
            button,
            summary,
            a[class*="inline-flex"][class*="border-2"] {
                transition: transform 160ms var(--ease-out);
            }

            button:active,
            summary:active,
            a[class*="inline-flex"][class*="border-2"]:active {
                transform: scale(0.97);
            }

            @media (prefers-reduced-motion: reduce) {
                button,
                summary,
                a[class*="inline-flex"][class*="border-2"] {
                    transition: none;
                }
                button:active,
                summary:active,
                a[class*="inline-flex"][class*="border-2"]:active {
                    transform: none;
                }
            }

            /* Mobile panel rows. The global press scale is wrong for a
               full-width list row; opacity is the honest signal and it is
               one of the properties reduced motion keeps. */
            [data-mobile-nav] a,
            [data-mobile-nav] button {
                transition: opacity 100ms var(--ease-out);
            }

            [data-mobile-nav] a:active,
            [data-mobile-nav] button:active {
                opacity: 0.6;
                transform: none;
            }

            /* Link underline draw — used on nav and inline links */
            .link-underline {
                background-image: linear-gradient(currentColor, currentColor);
                background-size: 0% 1.5px;
                background-repeat: no-repeat;
                background-position: 0 100%;
                transition: background-size 220ms ease;
            }

            .link-underline:focus-visible {
                background-size: 100% 1.5px;
            }

            @media (hover: hover) and (pointer: fine) {
                .link-underline:hover {
                    background-size: 100% 1.5px;
                }
            }

            @media (prefers-reduced-motion: reduce) {
                .link-underline {
                    transition: none;
                }
            }

            /* FAQ disclosure. The +/x already rotated over 150ms while the
               answer it controls snapped open — half-animated reads worse than
               not animated. Height is the sanctioned exception for accordions;
               there is no transform equivalent. */
            :root {
                interpolate-size: allow-keywords;
            }

            details::details-content {
                block-size: 0;
                overflow: hidden;
                transition:
                    block-size 250ms var(--ease-out),
                    content-visibility 250ms allow-discrete;
            }

            details[open]::details-content {
                block-size: auto;
            }

            @media (prefers-reduced-motion: reduce) {
                details::details-content {
                    transition: none;
                }
            }

            /* Reduced motion: movement off, color and opacity on. Transforms
               still land, they just arrive instead of traveling — which is
               right for a 2px lift and wrong for the row wipe, so that one
               becomes a fade below. */
            @media (prefers-reduced-motion: reduce) {
                *,
                *::before,
                *::after {
                    transition-property: opacity, color, background-color,
                        border-color, fill, stroke, box-shadow !important;
                }

                [data-sweep] {
                    scale: 1 1 !important;
                    opacity: 0;
                    transition: opacity 200ms ease !important;
                }

                .group:focus-within [data-sweep] {
                    opacity: 1;
                }

                .group:active [data-sweep] {
                    opacity: 1;
                }

                @media (hover: hover) and (pointer: fine) {
                    .group:hover [data-sweep] {
                        opacity: 1;
                    }
                }
            }
        </style>
    </head>
    <body class="font-sans bg-paper text-ink antialiased">
        <Navigation client:load pathname={Astro.url.pathname} />
        <slot />
        <RelatedPosts />
        <!-- Footer -->
        <footer class="border-t-2 border-ink bg-paper">
            <div class="max-w-7xl mx-auto px-6 py-16">
