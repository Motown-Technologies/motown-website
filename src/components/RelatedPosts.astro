---
// Published posts that list this page in `relatedPages`. Renders nothing
// when there are none, so BaseLayout can include it on every page.
import { getPosts } from "../lib/posts";

const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const posts = (await getPosts()).filter((p) => p.data.relatedPages?.includes(here)).slice(0, 3);
---

{
    posts.length > 0 && (
        <section class="border-t-2 border-ink">
            <div class="max-w-7xl mx-auto px-6 py-16 md:py-20">
                <h2 class="font-display text-3xl md:text-4xl font-bold tracking-tight mb-8">Related posts</h2>
                <ul class="grid gap-8 md:grid-cols-3">
                    {posts.map((post) => (
                        <li>
                            <a href={`/blog/${post.id}`} class="group block">
                                <span class="block font-display text-2xl font-bold tracking-tight leading-tight text-balance group-hover:text-accent transition-colors">
                                    {post.data.title}
                                </span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </section>
    )
}
